<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_radiology_notification_tree" model="ir.ui.view">
        <field name="name">radiology.notification.tree</field>
        <field name="model">radiology.notification</field>
        <field name="arch" type="xml">
            <tree>
                <field name="create_date"/>
                <field name="hospital_id"/>
                <field name="title"/>
                <field name="type"/>
                <field name="is_read"/>
                <field name="action_url"/>
            </tree>
        </field>
    </record>

    <record id="view_radiology_notification_form" model="ir.ui.view">
        <field name="name">radiology.notification.form</field>
        <field name="model">radiology.notification</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="hospital_id"/>
                        <field name="title"/>
                        <field name="type"/>
                        <field name="is_read"/>
                        <field name="action_url"/>
                    </group>
                    <group>
                        <field name="message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_radiology_notification" model="ir.actions.act_window">
        <field name="name">Notifications</field>
        <field name="res_model">radiology.notification</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
