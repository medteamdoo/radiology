<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="portal_all_radiologists" name="Portal - Radiologists (RadioVac SaaS)">
        <t t-set="rl_fullwidth" t-value="True"/>
        <t t-set="breadcrumbs" t-value="False"/>
        <t t-set="no_breadcrumbs" t-value="True"/>

        <t t-call="portal.portal_layout">
            <t t-set="rv_page_title" t-value="'Radiologues'"/>
            <t t-set="rv_page_subtitle"
               t-value="'Parcourez les radiologues disponibles et trouvez le bon profil pour vos missions.'"/>

            <t t-call="radiology.rv_portal_shell">
                <t t-set="rv_portal_active" t-value="'radiologists'"/>

                <t t-set="visible_radiologists_count" t-value="len(radiologists)"/>
                <t t-set="active_slots_count" t-value="len(radiologists.mapped('availability_ids').filtered('active'))"/>
                <t t-set="covered_specialties_count" t-value="len(radiologists.mapped('specialty_ids'))"/>
                <t t-set="covered_brands_count" t-value="len(radiologists.mapped('brand_ids'))"/>
                <t t-set="selected_specialty" t-value="request.params.get('specialty_id') or ''"/>
                <t t-set="selected_brand" t-value="request.params.get('brand_id') or ''"/>

                <div class="rv-portal-stack rv-radiologists-page">
                    <input type="hidden" id="csrf_token" t-att-value="request.csrf_token()"/>

                    <section class="rv-radiologists-stats">
                        <article class="rv-radiologists-stat-card">
                            <span class="rv-radiologists-stat-icon"><i class="fa fa-user-md"/></span>
                            <div class="rv-radiologists-stat-copy">
                                <small>Radiologues</small>
                                <strong><t t-esc="visible_radiologists_count"/></strong>
                                <span>Profils visibles</span>
                            </div>
                        </article>

                        <article class="rv-radiologists-stat-card">
                            <span class="rv-radiologists-stat-icon"><i class="fa fa-calendar-check-o"/></span>
                            <div class="rv-radiologists-stat-copy">
                                <small>Creneaux actifs</small>
                                <strong><t t-esc="active_slots_count"/></strong>
                                <span>Disponibilites renseignees</span>
                            </div>
                        </article>

                        <article class="rv-radiologists-stat-card">
                            <span class="rv-radiologists-stat-icon"><i class="fa fa-shield"/></span>
                            <div class="rv-radiologists-stat-copy">
                                <small>Specialites</small>
                                <strong><t t-esc="covered_specialties_count"/></strong>
                                <span>Competences couvertes</span>
                            </div>
                        </article>

                        <article class="rv-radiologists-stat-card">
                            <span class="rv-radiologists-stat-icon"><i class="fa fa-hospital-o"/></span>
                            <div class="rv-radiologists-stat-copy">
                                <small>Equipements</small>
                                <strong><t t-esc="covered_brands_count"/></strong>
                                <span>Marques referencees</span>
                            </div>
                        </article>
                    </section>

                    <form class="rv-radiologists-filter-bar" method="get" action="/my/radiologists">
                        <div class="rv-radiologists-filter-field">
                            <label for="rv_radiologists_specialty">Specialite</label>
                            <select id="rv_radiologists_specialty" name="specialty_id">
                                <option value="">Toutes</option>
                                <t t-foreach="specialties" t-as="s">
                                    <option t-att-value="s.id"
                                            t-att-selected="1 if str(s.id) == str(selected_specialty) else None">
                                        <t t-esc="s.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>

                        <div class="rv-radiologists-filter-field">
                            <label for="rv_radiologists_brand">Marque / equipement</label>
                            <select id="rv_radiologists_brand" name="brand_id">
                                <option value="">Toutes</option>
                                <t t-foreach="brands" t-as="b">
                                    <option t-att-value="b.id"
                                            t-att-selected="1 if str(b.id) == str(selected_brand) else None">
                                        <t t-esc="b.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>

                        <div class="rv-radiologists-filter-hint">
                            <span class="rv-radiologists-filter-hint-dot"/>
                            <span>Filtres live sur les profils visibles</span>
                        </div>

                        <div class="rv-radiologists-filter-actions">
                            <button type="submit" class="rv-portal-btn rv-portal-btn-primary">Filtrer</button>
                            <a href="/my/radiologists" class="rv-portal-btn rv-portal-btn-secondary">Reinitialiser</a>
                        </div>
                    </form>

                    <t t-if="radiologists">
                        <div class="rv-radiologists-grid">
                            <t t-foreach="radiologists" t-as="r">
                                <t t-set="is_fav" t-value="True if (fav_ids and (r.id in fav_ids)) else False"/>
                                <t t-set="has_active_availability" t-value="bool(r.availability_ids.filtered('active'))"/>
                                <t t-set="location_label"
                                   t-value="r.hospital_id.city or (r.hospital_id.name if r.hospital_id else 'France')"/>

                                <article class="rv-radiologist-card">
                                    <a t-att-href="'/my/radiologists/%s' % r.id" class="rv-radiologist-photo">
                                        <t t-if="r.image_1920">
                                            <img t-att-src="'/web/image/radiology.radiologist/%s/image_1920' % r.id"
                                                 alt="Photo radiologue"/>
                                        </t>
                                        <t t-else="">
                                            <img src="/web/static/img/user_menu_avatar.png" alt="Avatar radiologue"/>
                                        </t>
                                    </a>

                                    <div class="rv-radiologist-info">
                                        <div class="rv-radiologist-top">
                                            <div class="rv-radiologist-heading">
                                                <h3><t t-esc="r.display_name or 'Radiologue'"/></h3>
                                                <div class="rv-radiologist-meta">
                                                    <span>
                                                        <i class="fa fa-briefcase"/>
                                                        <t t-if="r.experience_years">
                                                            <t t-esc="r.experience_years"/> ans d'experience
                                                        </t>
                                                        <t t-else="">Experience non renseignee</t>
                                                    </span>
                                                    <span>
                                                        <i class="fa fa-map-marker"/>
                                                        <t t-esc="location_label"/>
                                                    </span>
                                                </div>
                                            </div>

                                            <div class="rv-radiologist-tools">
                                                <t t-if="can_see">
                                                    <t t-if="r.rating_count and r.rating_count &gt; 0">
                                                        <span class="rv-radiologist-rating">
                                                            <i class="fa fa-star"/>
                                                            <t t-esc="'%.1f' % (r.rating_avg or 0.0)"/>
                                                        </span>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="rv-radiologist-rating is-muted">Nouveau</span>
                                                    </t>
                                                </t>
                                                <t t-else="">
                                                    <span class="rv-radiologist-rating is-locked">
                                                        <i class="fa fa-lock"/>
                                                        Score Premium
                                                    </span>
                                                </t>

                                                <button type="button"
                                                        t-attf-class="rv-radiologist-fav #{'is-fav' if is_fav else ''}"
                                                        t-att-data-rid="r.id"
                                                        aria-label="Ajouter ou retirer des favoris"
                                                        title="Ajouter ou retirer des favoris">
                                                    <i t-attf-class="fa #{'fa-heart' if is_fav else 'fa-heart-o'}"/>
                                                </button>
                                            </div>
                                        </div>

                                        <div class="rv-radiologist-status-row">
                                            <t t-if="has_active_availability">
                                                <span class="rv-radiologist-status is-available">
                                                    <span class="rv-radiologist-status-dot"/>
                                                    Disponibilites actives
                                                </span>
                                            </t>
                                            <t t-else="">
                                                <span class="rv-radiologist-status is-pending">
                                                    <span class="rv-radiologist-status-dot"/>
                                                    Planning a confirmer
                                                </span>
                                            </t>

                                            <t t-if="can_see and r.rating_count">
                                                <span class="rv-radiologist-supporting">
                                                    <t t-esc="r.rating_count"/> avis verifies
                                                </span>
                                            </t>
                                            <t t-else="">
                                                <span class="rv-radiologist-supporting">Profil RadioVac</span>
                                            </t>
                                        </div>

                                        <div class="rv-radiologist-chips">
                                            <t t-if="r.specialty_ids">
                                                <t t-foreach="r.specialty_ids[:2]" t-as="sp">
                                                    <span class="rv-radiologist-chip"><t t-esc="sp.name"/></span>
                                                </t>
                                                <t t-if="len(r.specialty_ids) &gt; 2">
                                                    <span class="rv-radiologist-chip is-muted">+<t t-esc="len(r.specialty_ids) - 2"/></span>
                                                </t>
                                            </t>
                                            <t t-else="">
                                                <span class="rv-radiologist-chip is-muted">Specialites a completer</span>
                                            </t>
                                        </div>

                                        <div class="rv-radiologist-chips is-secondary">
                                            <t t-if="r.brand_ids">
                                                <t t-foreach="r.brand_ids[:2]" t-as="br">
                                                    <span class="rv-radiologist-chip is-secondary"><t t-esc="br.name"/></span>
                                                </t>
                                                <t t-if="len(r.brand_ids) &gt; 2">
                                                    <span class="rv-radiologist-chip is-secondary">+<t t-esc="len(r.brand_ids) - 2"/></span>
                                                </t>
                                            </t>
                                            <t t-else="">
                                                <span class="rv-radiologist-chip is-secondary">Equipements a completer</span>
                                            </t>
                                        </div>

                                        <div class="rv-radiologist-bottom">
                                            <span class="rv-radiologist-bottom-note">
                                                <t t-if="r.hospital_id">
                                                    <t t-esc="r.hospital_id.name"/>
                                                </t>
                                                <t t-else="">Profil disponible sur RadioVac</t>
                                            </span>

                                            <a t-att-href="'/my/radiologists/%s' % r.id"
                                               class="rv-radiologist-action">
                                                Voir profil
                                                <i class="fa fa-arrow-right"/>
                                            </a>
                                        </div>
                                    </div>
                                </article>
                            </t>
                        </div>
                    </t>

                    <t t-else="">
                        <div class="rv-portal-empty-state">
                            <strong>Aucun radiologue ne correspond a vos criteres.</strong>
                            <p>Ajustez vos filtres ou reinitialisez la recherche pour afficher davantage de profils.</p>
                        </div>
                    </t>

                    <script type="text/javascript">
                        <![CDATA[
                        (function () {
                          function getCsrf() {
                            var el = document.getElementById("csrf_token");
                            return el ? el.value : null;
                          }

                          document.addEventListener("click", async function (e) {
                            var btn = e.target.closest(".rv-radiologist-fav");
                            if (!btn) return;

                            e.preventDefault();
                            e.stopPropagation();

                            var rid = btn.getAttribute("data-rid");
                            if (!rid) return;

                            var csrf = getCsrf();

                            try {
                              var payload = {
                                jsonrpc: "2.0",
                                method: "call",
                                params: { radiologist_id: parseInt(rid) },
                                id: Date.now()
                              };

                              var res = await fetch("/my/radiologists/favorite/toggle", {
                                method: "POST",
                                credentials: "same-origin",
                                headers: Object.assign({
                                  "Content-Type": "application/json",
                                  "X-Requested-With": "XMLHttpRequest"
                                }, csrf ? { "X-CSRFToken": csrf } : {}),
                                body: JSON.stringify(payload)
                              });

                              var data = await res.json();
                              var result = data && data.result ? data.result : null;
                              if (!result || !result.ok) return;

                              var icon = btn.querySelector("i");
                              if (result.is_favorite) {
                                btn.classList.add("is-fav");
                                if (icon) {
                                  icon.classList.remove("fa-heart-o");
                                  icon.classList.add("fa-heart");
                                }
                              } else {
                                btn.classList.remove("is-fav");
                                if (icon) {
                                  icon.classList.remove("fa-heart");
                                  icon.classList.add("fa-heart-o");
                                }
                              }
                            } catch (err) {
                              // ignore
                            }
                          }, true);
                        })();
                        ]]>
                    </script>
                </div>
            </t>
        </t>
    </template>
</odoo>
