<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_radiologist_tree" model="ir.ui.view">
            <field name="name">radiology.radiologist.tree</field>
            <field name="model">radiology.radiologist</field>
            <field name="arch" type="xml">
                <tree string="Radiologists">
                    <field name="image_1920" widget="image"/>
                    <field name="display_name"/>
                    <field name="specialty_ids"/>
                    <field name="brand_ids"/>
                    <field name="experience_years"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="hospital_id"/>
                    <field name="hide_profile_for_current_hospital"/>
                </tree>
            </field>
        </record>

        <record id="view_radiologist_form" model="ir.ui.view">
            <field name="name">radiology.radiologist.form</field>
            <field name="model">radiology.radiologist</field>
            <field name="arch" type="xml">
                <form string="Radiologist">
                    <sheet>
                        <group>
                            <field name="image_1920" widget="image" class="oe_avatar"/>
                            <field name="display_name" string="Name"/>
                            <field name="specialty_ids" widget="many2many_tags" string="Specialties"/>
                            <field name="brand_ids" widget="many2many_tags" string="Brands"/>
                            <field name="experience_years" string="Years of Experience"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="hospital_id"/>
                            <field name="hide_profile_for_current_hospital"/>
                            <field name="bio"/>
                            <field name="cv_attachment_ids" widget="many2many_binary"/>
                            <field name="diplome_ids" widget="many2many_binary"/>
                            <field name="user_id"/>
                            <field name="api_token" readonly="1"/>
                        </group>
                        <group string="Disponibilités">
                            <field name="availability_ids">
                                <tree editable="bottom">
                                    <field name="weekday"/>
                                    <field name="start_time"/>
                                    <field name="end_time"/>
                                    <field name="is_night"/>
                                    <field name="is_weekend" readonly="1"/>
                                    <field name="active"/>
                                </tree>
                            </field>
                        </group>
                        <notebook>
                            <page string="Ratings">
                                <field name="review_ids">
                                    <tree string="Avis" create="true" edit="true" delete="true">
                                        <field name="hospital_id"/>
                                        <field name="punctuality"/>
                                        <field name="human_relation"/>
                                        <field name="competence"/>
                                    </tree>
                                </field>

                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_radiologist" model="ir.actions.act_window">
            <field name="name">Radiologues</field>
            <field name="res_model">radiology.radiologist</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
