<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="reserve_demo_form" name="Reserve a Demo">
        <t t-call="website.layout">
            <t t-set="no_header" t-value="True"/>
            <t t-set="pageName" t-value="'radiovac_demo'"/>
            <t t-set="title" t-value="'RadioVac | Reserver une demonstration'"/>
            <t t-set="meta_description"
               t-value="'Reservez une demonstration RadioVac pour decouvrir comment publier, matcher et coordonner vos missions de radiologie dans un cadre fluide et premium.'"/>
            <t t-set="slot_count" t-value="slots and len(slots) or 0"/>
            <t t-set="next_slot" t-value="slots and slots[0] or False"/>

            <div id="wrap" class="oe_structure rv-home-page rv-demo-page rl-demo-page">
                <section class="rv-home-hero rv-demo-hero">
                    <div class="container rv-home-shell">
                        <nav class="rv-home-navbar" aria-label="Navigation RadioVac Demo">
                            <a href="/radiovac-home" class="rv-home-brand" data-rv-transition-link="true">
                                <img src="/radiology/static/src/img/radiovac.png"
                                     alt="Logo RadioVac"
                                     class="rv-home-logo"/>
                                <span class="rv-home-brand-text">RadioVac</span>
                            </a>

                            <div class="rv-home-nav-links">
                                <a href="/radiovac-home#plateforme" data-rv-transition-link="true">Plateforme</a>
                                <a href="/radiovac-home#fonctionnalites" data-rv-transition-link="true">Fonctionnalites</a>
                                <a href="/radiovac-home#radiologues" data-rv-transition-link="true">Radiologues</a>
                                <a href="/radiovac-home#etablissements" data-rv-transition-link="true">Etablissements</a>
                                <a href="/radiovac-pricing" data-rv-transition-link="true">Tarifs</a>
                                <a href="/radiovac-home#ressources" data-rv-transition-link="true">Ressources</a>
                            </div>

                            <div class="rv-home-nav-actions">
                                <a href="/web/login" class="rv-home-nav-login">Se connecter</a>
                                <a href="#rv-demo-form-section" class="rv-home-btn rv-home-btn-primary rv-home-btn-sm">
                                    Reserver une demo
                                </a>
                            </div>
                        </nav>

                        <div class="row align-items-center g-5 rv-home-hero-grid rv-demo-hero-grid">
                            <div class="col-12 col-xl-5">
                                <div class="rv-home-hero-copy" data-rv-reveal="true">
                                    <span class="rv-home-badge">
                                        <span class="rv-home-badge-dot"/>
                                        Demonstration RadioVac
                                    </span>

                                    <h1 class="rv-home-title rv-demo-title">
                                        Une demonstration claire
                                        pour simplifier vos missions
                                        de <span>radiologie</span>
                                    </h1>

                                    <p class="rv-home-subtitle">
                                        Decouvrez concretement comment RadioVac aide les etablissements a publier
                                        leurs besoins, identifier les bons radiologues et coordonner chaque mission
                                        avec plus de fluidite.
                                    </p>

                                    <div class="rv-home-hero-actions">
                                        <a href="#rv-demo-form-section" class="rv-home-btn rv-home-btn-primary">
                                            Planifier ma demo
                                        </a>
                                        <a href="/radiovac-pricing"
                                           class="rv-home-btn rv-home-btn-secondary"
                                           data-rv-transition-link="true">
                                            Voir les tarifs
                                        </a>
                                    </div>

                                    <div class="rv-home-trust-row" aria-label="Points forts demo">
                                        <div class="rv-home-trust-item">
                                            <span class="rv-home-trust-icon">
                                                <i class="fa fa-clock-o"/>
                                            </span>
                                            <div>
                                                <strong>30 minutes</strong>
                                                <small>Format concis et utile</small>
                                            </div>
                                        </div>
                                        <div class="rv-home-trust-item">
                                            <span class="rv-home-trust-icon">
                                                <i class="fa fa-check-circle"/>
                                            </span>
                                            <div>
                                                <strong>Sans engagement</strong>
                                                <small>Vous evaluez a votre rythme</small>
                                            </div>
                                        </div>
                                        <div class="rv-home-trust-item">
                                            <span class="rv-home-trust-icon">
                                                <i class="fa fa-lock"/>
                                            </span>
                                            <div>
                                                <strong>Securise</strong>
                                                <small>Informations utilisees pour organiser la demo</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-xl-7">
                                <div class="rv-demo-visual" data-rv-reveal="true">
                                    <span class="rv-demo-visual-glow is-a"/>
                                    <span class="rv-demo-visual-glow is-b"/>
                                    <span class="rv-demo-visual-ring is-a"/>
                                    <span class="rv-demo-visual-ring is-b"/>
                                    <span class="rv-demo-visual-connector is-left"/>
                                    <span class="rv-demo-visual-connector is-right"/>

                                    <article class="rv-demo-floating-card rv-demo-floating-card-slot">
                                        <span class="rv-home-floating-label">Prochain creneau</span>
                                        <strong>
                                            <t t-esc="next_slot and next_slot.get('date_label') or 'A definir'"/>
                                        </strong>
                                        <div class="rv-demo-slot-meta">
                                            <span>
                                                <i class="fa fa-clock-o"/>
                                                <t t-esc="next_slot and next_slot.get('time_label') or 'Disponibilites mises a jour en direct'"/>
                                            </span>
                                            <span>
                                                <i class="fa fa-bolt"/>
                                                Confirmation rapide
                                            </span>
                                        </div>
                                        <span class="rv-home-inline-pill">
                                            <t t-esc="slot_count"/> creneaux disponibles
                                        </span>
                                    </article>

                                    <div class="rv-demo-orbit-core">
                                        <span class="rv-demo-orbit-pulse"/>
                                        <strong>Session guidee</strong>
                                        <small>Publication, matching, coordination et questions en direct.</small>
                                    </div>

                                    <article class="rv-demo-floating-card rv-demo-floating-card-summary">
                                        <span class="rv-home-floating-label">Ce que vous verrez</span>
                                        <div class="rv-demo-summary-list">
                                            <div>
                                                <strong>01</strong>
                                                <small>Workflow RadioVac</small>
                                            </div>
                                            <div>
                                                <strong>02</strong>
                                                <small>Cas d usage reel</small>
                                            </div>
                                            <div>
                                                <strong>03</strong>
                                                <small>Plan adapte</small>
                                            </div>
                                        </div>
                                    </article>

                                    <article class="rv-demo-floating-card rv-demo-floating-card-checklist">
                                        <span class="rv-home-floating-label">Resultat attendu</span>
                                        <ul class="rv-demo-checklist list-unstyled">
                                            <li><i class="fa fa-check"/> Une vision claire de la plateforme</li>
                                            <li><i class="fa fa-check"/> Un cadrage adapte a votre contexte</li>
                                            <li><i class="fa fa-check"/> Les prochaines etapes recommandees</li>
                                        </ul>
                                    </article>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="rv-home-section rv-home-workflow rv-demo-journey">
                    <div class="container rv-home-shell">
                        <div class="rv-home-section-head rv-home-section-head-center" data-rv-reveal="true">
                            <span class="rv-home-section-kicker">Le deroule de la demonstration</span>
                            <h2>Une session pensee pour aller a l'essentiel</h2>
                        </div>

                        <div class="rv-home-workflow-track" data-rv-reveal="true">
                            <span class="rv-home-workflow-line"/>

                            <article class="rv-home-step">
                                <span class="rv-home-step-icon">
                                    <i class="fa fa-search"/>
                                </span>
                                <span class="rv-home-step-index">01</span>
                                <h3>Analyser</h3>
                                <p>Nous cadrons rapidement votre organisation, vos besoins et vos priorites terrain.</p>
                            </article>

                            <article class="rv-home-step">
                                <span class="rv-home-step-icon">
                                    <i class="fa fa-desktop"/>
                                </span>
                                <span class="rv-home-step-index">02</span>
                                <h3>Presenter</h3>
                                <p>Vous voyez les ecrans cles de RadioVac et la logique de publication des missions.</p>
                            </article>

                            <article class="rv-home-step">
                                <span class="rv-home-step-icon">
                                    <i class="fa fa-random"/>
                                </span>
                                <span class="rv-home-step-index">03</span>
                                <h3>Simuler</h3>
                                <p>Nous montrons un cas d usage realiste autour du matching et du suivi en temps reel.</p>
                            </article>

                            <article class="rv-home-step">
                                <span class="rv-home-step-icon">
                                    <i class="fa fa-compass"/>
                                </span>
                                <span class="rv-home-step-index">04</span>
                                <h3>Orienter</h3>
                                <p>Vous repartez avec une lecture claire du bon plan et des prochaines etapes.</p>
                            </article>
                        </div>
                    </div>
                </section>

                <section id="rv-demo-form-section" class="rv-home-section rv-demo-booking">
                    <div class="container rv-home-shell">
                        <div class="rv-home-section-head rv-home-section-head-center" data-rv-reveal="true">
                            <span class="rv-home-section-kicker">Reservation</span>
                            <h2>Planifiez votre demonstration RadioVac</h2>
                            <p>
                                Choisissez un creneau, laissez vos coordonnees et nous preparons une demonstration
                                utile, claire et adaptee a votre contexte operationnel.
                            </p>
                        </div>

                        <div class="row g-4 rv-demo-booking-grid">
                            <div class="col-12 col-xl-4">
                                <aside class="rv-demo-side-panel" data-rv-reveal="true">
                                    <span class="rv-home-section-kicker">Ce que vous obtenez</span>
                                    <h3>Une demonstration utile, pas une visite generique</h3>
                                    <p>
                                        La session est centree sur vos missions, vos equipes et vos flux de coordination,
                                        pour que la valeur RadioVac soit directement lisible.
                                    </p>

                                    <ul class="rv-demo-side-list list-unstyled">
                                        <li><i class="fa fa-check-circle"/> Publication et qualification d'un besoin</li>
                                        <li><i class="fa fa-check-circle"/> Matching radiologue selon le contexte</li>
                                        <li><i class="fa fa-check-circle"/> Coordination et suivi des etapes cles</li>
                                    </ul>

                                    <div class="rv-demo-side-stats">
                                        <div class="rv-demo-side-stat">
                                            <strong><t t-esc="slot_count"/></strong>
                                            <small>Creneaux ouverts</small>
                                        </div>
                                        <div class="rv-demo-side-stat">
                                            <strong>30 min</strong>
                                            <small>Duree moyenne</small>
                                        </div>
                                    </div>
                                </aside>
                            </div>

                            <div class="col-12 col-xl-8">
                                <div class="rv-demo-form-card" data-rv-reveal="true">
                                    <div class="rv-demo-form-card-head">
                                        <h3>Reserver une demo</h3>
                                        <p>Selectionnez un creneau puis partagez les informations necessaires pour organiser l'echange.</p>
                                    </div>

                                    <t t-if="error">
                                        <div class="rv-demo-alert rv-demo-alert-error">
                                            <t t-esc="error"/>
                                        </div>
                                    </t>
                                    <t t-if="success">
                                        <div class="rv-demo-alert rv-demo-alert-success">
                                            <t t-esc="success"/>
                                        </div>
                                    </t>

                                    <t t-if="slots">
                                        <form action="/reserve-demo" method="post" class="rv-demo-form">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                            <div class="row g-4">
                                                <div class="col-12">
                                                    <div class="rv-demo-field">
                                                        <label for="reserve_demo_slot">Creneau disponible</label>
                                                        <select id="reserve_demo_slot" name="slot_id" class="rv-demo-input" required="required">
                                                            <option value="">Choisir un creneau</option>
                                                            <t t-foreach="slots" t-as="slot">
                                                                <option t-att-value="slot['id']"
                                                                        t-att-selected="'selected' if selected_slot_id == slot['id'] else None">
                                                                    <t t-esc="slot['full_label']"/>
                                                                </option>
                                                            </t>
                                                        </select>
                                                    </div>
                                                </div>

                                                <div class="col-12">
                                                    <div class="rv-demo-field">
                                                        <label for="reserve_demo_name">Nom complet</label>
                                                        <input id="reserve_demo_name"
                                                               type="text"
                                                               name="name"
                                                               class="rv-demo-input"
                                                               required="required"
                                                               placeholder="Ex : Clinique El Amen - Dr. Sami Ben Ali"
                                                               t-att-value="values.get('name') or ''"/>
                                                    </div>
                                                </div>

                                                <div class="col-12 col-lg-6">
                                                    <div class="rv-demo-field">
                                                        <label for="reserve_demo_email">Email</label>
                                                        <input id="reserve_demo_email"
                                                               type="email"
                                                               name="email"
                                                               class="rv-demo-input"
                                                               required="required"
                                                               placeholder="nom@etablissement.fr"
                                                               t-att-value="values.get('email') or ''"/>
                                                    </div>
                                                </div>

                                                <div class="col-12 col-lg-6">
                                                    <div class="rv-demo-field">
                                                        <label for="reserve_demo_phone">Telephone</label>
                                                        <input id="reserve_demo_phone"
                                                               type="text"
                                                               name="phone"
                                                               class="rv-demo-input"
                                                               required="required"
                                                               placeholder="+33 6 12 34 56 78"
                                                               t-att-value="values.get('phone') or ''"/>
                                                    </div>
                                                </div>

                                                <div class="col-12">
                                                    <div class="rv-demo-field">
                                                        <label for="reserve_demo_additional_info">Information supplementaire</label>
                                                        <textarea id="reserve_demo_additional_info"
                                                                  name="additional_info"
                                                                  rows="5"
                                                                  class="rv-demo-input"
                                                                  placeholder="Ajoutez toute information utile sur votre structure, vos objectifs ou votre contexte."><t t-esc="values.get('additional_info') or ''"/></textarea>
                                                    </div>
                                                </div>

                                                <div class="col-12">
                                                    <div class="rv-demo-data-note">
                                                        Vos informations servent uniquement a organiser la demonstration
                                                        et preparer un echange pertinent.
                                                    </div>
                                                </div>

                                                <div class="col-12">
                                                    <button type="submit" class="rv-home-btn rv-home-btn-primary rv-demo-submit w-100">
                                                        Reserver une demo
                                                    </button>
                                                </div>
                                            </div>
                                        </form>
                                    </t>
                                    <t t-else="">
                                        <div class="rv-demo-empty">
                                            <strong>Aucun creneau disponible actuellement</strong>
                                            <span>Revenez plus tard ou contactez l'equipe. Les prochaines disponibilites seront affichees automatiquement ici.</span>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="rv-home-section rv-home-final-cta rv-demo-final-cta">
                    <div class="container rv-home-shell">
                        <div class="rv-home-final-cta-card" data-rv-reveal="true">
                            <div class="rv-home-final-cta-copy">
                                <span class="rv-home-section-kicker">Besoin d'un autre angle d'analyse ?</span>
                                <h2>Comparez d'abord les plans ou revenez a la plateforme.</h2>
                                <p>
                                    Si vous souhaitez cadrer votre besoin avant la demonstration,
                                    vous pouvez consulter la page Tarifs ou revenir a la homepage RadioVac.
                                </p>
                                <div class="rv-home-resource-links">
                                    <a href="/radiovac-pricing" data-rv-transition-link="true">Comparer les tarifs</a>
                                    <a href="/radiovac-home" data-rv-transition-link="true">Retour a la plateforme</a>
                                    <a href="/web/login">Acces plateforme</a>
                                </div>
                            </div>

                            <div class="rv-home-final-cta-actions">
                                <a href="/radiovac-pricing"
                                   class="rv-home-btn rv-home-btn-primary"
                                   data-rv-transition-link="true">
                                    Voir les tarifs
                                </a>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
