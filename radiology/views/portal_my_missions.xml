<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="portal_my_missions_group_section" name="Portal - My Missions Group Section">
        <section class="rv-candidatures-group">
            <div class="rv-candidatures-group-head">
                <div class="rv-candidatures-group-copy">
                    <span class="rv-portal-section-kicker"><t t-esc="group_kicker"/></span>
                    <h3><t t-esc="group_title"/></h3>
                    <p><t t-esc="group_subtitle"/></p>
                </div>

                <span class="rv-candidatures-count">
                    <t t-esc="len(missions_group)"/> mission<t t-if="len(missions_group) &gt; 1">s</t>
                </span>
            </div>

            <t t-if="missions_group">
                <div class="rv-portal-mission-grid">
                    <t t-foreach="missions_group" t-as="m">
                        <article class="rv-portal-mission-card">
                            <a t-att-href="'/my/missions/%s' % m.id" class="rv-portal-mission-media">
                                <t t-if="m.hospital_id and m.hospital_id.image_1920">
                                    <img t-att-src="'/web/image/radiology.hospital/%s/image_1920' % m.hospital_id.id"
                                         alt="Mission"/>
                                </t>
                                <t t-else="">
                                    <img src="/web/static/img/placeholder.png" alt="Mission"/>
                                </t>
                            </a>

                            <div class="rv-portal-mission-body">
                                <div class="rv-portal-mission-head">
                                    <div>
                                        <h3><t t-esc="m.name or 'Mission'"/></h3>
                                        <p>
                                            <t t-esc="m.hospital_id.name if m.hospital_id else 'Etablissement partenaire'"/>
                                            <t t-if="m.start_date or m.end_date">
                                                <span class="rv-portal-separator">|</span>
                                                <t t-if="m.start_date"><t t-esc="m.start_date"/></t>
                                                <t t-if="m.end_date"><t t-esc="' -> %s' % m.end_date"/></t>
                                            </t>
                                        </p>
                                    </div>
                                    <span t-attf-class="rv-portal-status-chip #{group_status_css}">
                                        <t t-esc="group_status_label"/>
                                    </span>
                                </div>

                                <div class="rv-portal-tag-row">
                                    <t t-foreach="m.speciality_ids[:3]" t-as="sp">
                                        <span class="rv-portal-tag-chip"><t t-esc="sp.name"/></span>
                                    </t>
                                    <t t-foreach="m.brand_ids[:2]" t-as="br">
                                        <span class="rv-portal-tag-chip is-muted"><t t-esc="br.name"/></span>
                                    </t>
                                    <t t-if="len(m.speciality_ids) &gt; 3">
                                        <span class="rv-portal-tag-chip is-muted">+<t t-esc="len(m.speciality_ids) - 3"/></span>
                                    </t>
                                    <t t-if="len(m.brand_ids) &gt; 2">
                                        <span class="rv-portal-tag-chip is-muted">+<t t-esc="len(m.brand_ids) - 2"/></span>
                                    </t>
                                </div>

                                <div class="rv-portal-mission-meta">
                                    <t t-if="m.assigned_radiologist_id and group_key in ['assigned', 'done']">
                                        <a t-att-href="'/my/radiologists/%s' % m.assigned_radiologist_id.id"
                                           class="rv-candidatures-assignee">
                                            <span class="rv-candidatures-assignee-avatar">
                                                <t t-if="m.assigned_radiologist_id.image_1920">
                                                    <img t-att-src="'/web/image/radiology.radiologist/%s/image_1920' % m.assigned_radiologist_id.id"
                                                         alt="Radiologue"/>
                                                </t>
                                                <t t-else="">
                                                    <img src="/web/static/img/user_menu_avatar.png" alt="Radiologue"/>
                                                </t>
                                            </span>
                                            <span class="rv-candidatures-assignee-copy">
                                                <small>Radiologue affecte</small>
                                                <strong><t t-esc="m.assigned_radiologist_id.display_name or 'Radiologue'"/></strong>
                                            </span>
                                        </a>
                                    </t>
                                    <t t-else="">
                                        <div class="rv-portal-applicant-strip">
                                            <div class="rv-portal-avatar-stack">
                                                <t t-foreach="m.application_ids[:3]" t-as="app">
                                                    <t t-set="r" t-value="app.radiologist_id"/>
                                                    <span class="rv-portal-avatar-stack-item" t-att-title="r.display_name">
                                                        <t t-if="r.image_1920">
                                                            <img t-att-src="'/web/image/radiology.radiologist/%s/image_1920' % r.id" alt="Radiologue"/>
                                                        </t>
                                                        <t t-else="">
                                                            <img src="/web/static/img/user_menu_avatar.png" alt="Radiologue"/>
                                                        </t>
                                                    </span>
                                                </t>
                                            </div>

                                            <span class="rv-portal-applicant-count">
                                                <t t-if="len(m.application_ids)">
                                                    <t t-esc="len(m.application_ids)"/> candidature<t t-if="len(m.application_ids) &gt; 1">s</t>
                                                </t>
                                                <t t-else="">
                                                    <t t-if="group_key == 'draft'">Mission en preparation</t>
                                                    <t t-else="">Aucune candidature</t>
                                                </t>
                                            </span>
                                        </div>
                                    </t>

                                    <div class="rv-portal-mission-price">
                                        <strong><t t-esc="m.tarif or '-'"/> EUR</strong>
                                        <small>
                                            <t t-if="m.tarif_type == 'hour'">/ heure</t>
                                            <t t-elif="m.tarif_type == 'day'">/ jour</t>
                                            <t t-else="">/ mission</t>
                                        </small>
                                    </div>
                                </div>

                                <div class="rv-portal-mission-actions rv-candidatures-card-actions">
                                    <a class="rv-portal-btn rv-portal-btn-secondary"
                                       t-att-href="'/my/missions/%s' % m.id">
                                        Voir la mission
                                    </a>

                                    <form t-att-action="'/my/missions/%s/delete' % m.id"
                                          method="post"
                                          class="rv-candidatures-delete-form">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button type="submit"
                                                class="rv-portal-btn rv-portal-btn-secondary rv-candidatures-delete-btn"
                                                onclick="return confirm('Supprimer cette mission ?');">
                                            <i class="fa fa-trash-o"/>
                                            <span>Supprimer</span>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </article>
                    </t>
                </div>
            </t>
            <t t-else="">
                <div class="rv-portal-empty-state rv-candidatures-empty">
                    <strong><t t-esc="group_empty_title"/></strong>
                    <p><t t-esc="group_empty_text"/></p>
                </div>
            </t>
        </section>
    </template>

    <template id="portal_my_missions_grouped" name="Portal - My Missions Grouped (RadioVac SaaS)">
        <t t-set="rl_fullwidth" t-value="True"/>
        <t t-set="breadcrumbs" t-value="False"/>
        <t t-set="no_breadcrumbs" t-value="True"/>

        <t t-call="portal.portal_layout">
            <t t-set="rv_page_title" t-value="'Candidatures'"/>
            <t t-set="rv_page_subtitle"
               t-value="'Suivez vos missions hospitalieres et les candidatures recues dans une vue unifiee par statut.'"/>

            <t t-call="radiology.rv_portal_shell">
                <t t-set="rv_portal_active" t-value="'candidatures'"/>
                <t t-set="total_missions"
                   t-value="len(missions_draft) + len(missions_published) + len(missions_assigned) + len(missions_done)"/>
                <t t-set="active_missions"
                   t-value="len(missions_published) + len(missions_assigned)"/>

                <div class="rv-portal-stack rv-candidatures-page">
                    <section class="rv-portal-card rv-candidatures-intro">
                        <div class="rv-portal-card-head">
                            <div>
                                <span class="rv-portal-section-kicker">Hub candidatures</span>
                                <h2>Retrouvez toutes vos missions et leurs candidatures dans le meme flux.</h2>
                                <p>
                                    Filtrez vos missions par specialite, marque ou periode puis ouvrez rapidement
                                    chaque detail pour suivre les profils associes.
                                </p>
                            </div>

                            <div class="rv-portal-head-actions">
                                <span class="rv-portal-soft-badge">
                                    <i class="fa fa-briefcase"/>
                                    <t t-esc="total_missions"/> missions visibles
                                </span>
                                <span class="rv-portal-soft-badge is-success">
                                    <i class="fa fa-files-o"/>
                                    <t t-esc="active_missions"/> missions actives
                                </span>
                                <a href="/my/missions/new" class="rv-portal-btn rv-portal-btn-primary">Publier une mission</a>
                            </div>
                        </div>
                    </section>

                    <form class="rv-portal-filter-bar" method="get" action="/my/missionss">
                        <div class="rv-portal-filter-field">
                            <label for="rv_my_specialty_id">Specialite</label>
                            <select id="rv_my_specialty_id" name="specialty_id">
                                <option value="">Toutes</option>
                                <t t-foreach="specialties" t-as="s">
                                    <option t-att-value="s.id"
                                            t-att-selected="1 if str(s.id) == str(selected_specialty or '') else None">
                                        <t t-esc="s.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>

                        <div class="rv-portal-filter-field">
                            <label for="rv_my_brand_id">Marque</label>
                            <select id="rv_my_brand_id" name="brand_id">
                                <option value="">Toutes</option>
                                <t t-foreach="brands" t-as="b">
                                    <option t-att-value="b.id"
                                            t-att-selected="1 if str(b.id) == str(selected_brand or '') else None">
                                        <t t-esc="b.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>

                        <div class="rv-portal-filter-field">
                            <label for="rv_my_date_from">Du</label>
                            <input id="rv_my_date_from" type="date" name="date_from" t-att-value="date_from or ''"/>
                        </div>

                        <div class="rv-portal-filter-field">
                            <label for="rv_my_date_to">Au</label>
                            <input id="rv_my_date_to" type="date" name="date_to" t-att-value="date_to or ''"/>
                        </div>

                        <div class="rv-portal-filter-actions">
                            <button type="submit" class="rv-portal-btn rv-portal-btn-primary">Filtrer</button>
                            <a href="/my/missionss" class="rv-portal-btn rv-portal-btn-secondary">Reinitialiser</a>
                        </div>
                    </form>

                    <t t-set="missions_group" t-value="missions_draft"/>
                    <t t-set="group_key" t-value="'draft'"/>
                    <t t-set="group_kicker" t-value="'Brouillons'"/>
                    <t t-set="group_title" t-value="'Missions en preparation'"/>
                    <t t-set="group_subtitle" t-value="'Finalisez les informations avant diffusion aux radiologues.'"/>
                    <t t-set="group_status_label" t-value="'Brouillon'"/>
                    <t t-set="group_status_css" t-value="'is-draft'"/>
                    <t t-set="group_empty_title" t-value="'Aucune mission en brouillon.'"/>
                    <t t-set="group_empty_text" t-value="'Toutes vos missions pretes ont deja ete diffusees ou traitees.'"/>
                    <t t-call="radiology.portal_my_missions_group_section"/>

                    <t t-set="missions_group" t-value="missions_published"/>
                    <t t-set="group_key" t-value="'published'"/>
                    <t t-set="group_kicker" t-value="'Diffusion active'"/>
                    <t t-set="group_title" t-value="'Missions publiees'"/>
                    <t t-set="group_subtitle" t-value="'Suivez les offres ouvertes et les candidatures qui arrivent.'"/>
                    <t t-set="group_status_label" t-value="'Publiee'"/>
                    <t t-set="group_status_css" t-value="'is-published'"/>
                    <t t-set="group_empty_title" t-value="'Aucune mission publiee.'"/>
                    <t t-set="group_empty_text" t-value="'Publiez une nouvelle mission pour lancer le matching RadioVac.'"/>
                    <t t-call="radiology.portal_my_missions_group_section"/>

                    <t t-set="missions_group" t-value="missions_assigned"/>
                    <t t-set="group_key" t-value="'assigned'"/>
                    <t t-set="group_kicker" t-value="'Mission verrouillee'"/>
                    <t t-set="group_title" t-value="'Missions affectees'"/>
                    <t t-set="group_subtitle" t-value="'Visualisez les missions deja attribuees et le radiologue retenu.'"/>
                    <t t-set="group_status_label" t-value="'Affectee'"/>
                    <t t-set="group_status_css" t-value="'is-assigned'"/>
                    <t t-set="group_empty_title" t-value="'Aucune mission affectee.'"/>
                    <t t-set="group_empty_text" t-value="'Les missions confirmees apparaitront ici une fois un radiologue choisi.'"/>
                    <t t-call="radiology.portal_my_missions_group_section"/>

                    <t t-set="missions_group" t-value="missions_done"/>
                    <t t-set="group_key" t-value="'done'"/>
                    <t t-set="group_kicker" t-value="'Historique'"/>
                    <t t-set="group_title" t-value="'Missions terminees'"/>
                    <t t-set="group_subtitle" t-value="'Consultez rapidement les missions cloturees et leur affectation finale.'"/>
                    <t t-set="group_status_label" t-value="'Terminee'"/>
                    <t t-set="group_status_css" t-value="'is-done'"/>
                    <t t-set="group_empty_title" t-value="'Aucune mission terminee.'"/>
                    <t t-set="group_empty_text" t-value="'Votre historique apparaitra ici des qu une mission sera finalisee.'"/>
                    <t t-call="radiology.portal_my_missions_group_section"/>
                </div>
            </t>
        </t>
    </template>
</odoo>
