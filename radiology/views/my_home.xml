<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="portal_my_home_custom" name="Portal Home Custom">
        <t t-call="portal.portal_layout">

            <style>
                .rl-hero{
                background: linear-gradient(135deg, rgba(59,130,246,.10), rgba(168,85,247,.10));
                border: 1px solid rgba(0,0,0,.06);
                border-radius: 18px;
                padding: 18px 18px;
                }
                .rl-hero h3{ margin:0; font-weight:800; color:#0B1220; }
                .rl-hero p{ margin:6px 0 0; color:#667085; }

                .rl-card-link{ display:block; text-decoration:none; }
                .rl-card{
                border: 1px solid rgba(0,0,0,.06);
                border-radius: 16px;
                background: rgba(255,255,255,.92);
                box-shadow: 0 10px 28px rgba(2,6,23,.06);
                transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
                overflow:hidden;
                height: 100%;
                }
                .rl-card:hover{
                transform: translateY(-3px);
                box-shadow: 0 18px 44px rgba(2,6,23,.10);
                border-color: rgba(59,130,246,.25);
                }
                .rl-card-top{
                display:flex;
                align-items:center;
                justify-content:space-between;
                gap: 12px;
                padding: 14px 16px;
                border-bottom: 1px solid rgba(0,0,0,.05);
                background: linear-gradient(90deg, rgba(59,130,246,.10), rgba(168,85,247,.06));
                }
                .rl-icon{
                width: 42px;
                height: 42px;
                border-radius: 12px;
                display:flex;
                align-items:center;
                justify-content:center;
                background: rgba(255,255,255,.75);
                border: 1px solid rgba(0,0,0,.06);
                }
                .rl-icon i{
                font-size: 18px;
                color: #0B1220;
                opacity: .9;
                }
                .rl-badge{
                font-size: 12px;
                font-weight: 700;
                padding: 6px 10px;
                border-radius: 999px;
                background: rgba(17,24,39,.06);
                color: #111827;
                white-space: nowrap;
                }
                .rl-body{ padding: 14px 16px; }
                .rl-title{
                margin: 0;
                font-size: 18px;
                font-weight: 800;
                color: #0B1220;
                }
                .rl-text{
                margin: 6px 0 0;
                color: #667085;
                line-height: 1.35;
                }
                .rl-arrow{
                margin-top: 10px;
                color:#0B1220;
                opacity:.55;
                font-weight:700;
                }
            </style>

            <div class="container py-4">

                <div class="rl-hero mb-3">
                    <h3>Mon espace</h3>
                    <p>Accédez rapidement à vos missions, favoris, profil, sécurité et statistiques.</p>
                </div>

                <div class="row g-3">

                    <!-- Missions -->
                    <div class="col-12 col-md-6 col-lg-4">
                        <a href="/my/missionss" class="rl-card-link">
                            <div class="rl-card">
                                <div class="rl-card-top">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rl-icon">
                                            <i class="fa fa-briefcase"/>
                                        </div>
                                        <span class="rl-badge">Missions</span>
                                    </div>
                                    <span class="text-muted small">Ouvrir →</span>
                                </div>
                                <div class="rl-body">
                                    <div class="rl-title">Mes missions</div>
                                    <div class="rl-text">Consulter l’état et l’historique de vos missions.</div>
                                    <div class="rl-arrow">Voir les missions</div>
                                </div>
                            </div>
                        </a>
                    </div>

                    <!-- Favoris -->
                    <div class="col-12 col-md-6 col-lg-4">
                        <a href="/my/favorites" class="rl-card-link">
                            <div class="rl-card">
                                <div class="rl-card-top">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rl-icon">
                                            <i class="fa fa-heart"/>
                                        </div>
                                        <span class="rl-badge">Favoris</span>
                                    </div>
                                    <span class="text-muted small">Ouvrir →</span>
                                </div>
                                <div class="rl-body">
                                    <div class="rl-title">Mes favoris</div>
                                    <div class="rl-text">Retrouver rapidement vos éléments enregistrés.</div>
                                    <div class="rl-arrow">Voir les favoris</div>
                                </div>
                            </div>
                        </a>
                    </div>

                    <!-- Profil -->
                    <div class="col-12 col-md-6 col-lg-4">
                        <a href="/my/account" class="rl-card-link">
                            <div class="rl-card">
                                <div class="rl-card-top">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rl-icon">
                                            <i class="fa fa-user"/>
                                        </div>
                                        <span class="rl-badge">Profil</span>
                                    </div>
                                    <span class="text-muted small">Ouvrir →</span>
                                </div>
                                <div class="rl-body">
                                    <div class="rl-title">Mon profil</div>
                                    <div class="rl-text">Mettre à jour vos informations et préférences.</div>
                                    <div class="rl-arrow">Gérer mon compte</div>
                                </div>
                            </div>
                        </a>
                    </div>

                    <!-- Sécurité -->
                    <div class="col-12 col-md-6 col-lg-4">
                        <a href="/my/security" class="rl-card-link">
                            <div class="rl-card">
                                <div class="rl-card-top">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rl-icon">
                                            <i class="fa fa-shield"/>
                                        </div>
                                        <span class="rl-badge">Sécurité</span>
                                    </div>
                                    <span class="text-muted small">Ouvrir →</span>
                                </div>
                                <div class="rl-body">
                                    <div class="rl-title">Connexion &amp; sécurité</div>
                                    <div class="rl-text">Modifier votre mot de passe et sécuriser votre compte.</div>
                                    <div class="rl-arrow">Paramètres de sécurité</div>
                                </div>
                            </div>
                        </a>
                    </div>

                    <!-- Dashboard -->
                    <div class="col-12 col-md-6 col-lg-4">
                        <a href="/my/dashboard" class="rl-card-link">
                            <div class="rl-card">
                                <div class="rl-card-top">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rl-icon">
                                            <i class="fa fa-line-chart"/>
                                        </div>
                                        <span class="rl-badge">Dashboard</span>
                                    </div>
                                    <span class="text-muted small">Ouvrir →</span>
                                </div>
                                <div class="rl-body">
                                    <div class="rl-title">Mon dashboard</div>
                                    <div class="rl-text">Visualiser vos statistiques et indicateurs clés.</div>
                                    <div class="rl-arrow">Voir le dashboard</div>
                                </div>
                            </div>
                        </a>
                    </div>

                    <!-- Évaluations -->
                    <div class="col-12 col-md-6 col-lg-4">
                        <a href="/my/evaluations" class="rl-card-link">
                            <div class="rl-card">
                                <div class="rl-card-top">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rl-icon">
                                            <i class="fa fa-star"/>
                                        </div>
                                        <span class="rl-badge">Évaluations</span>
                                    </div>
                                    <span class="text-muted small">Ouvrir →</span>
                                </div>
                                <div class="rl-body">
                                    <div class="rl-title">Mes évaluations</div>
                                    <div class="rl-text">
                                        Consulter vos avis, notes et retours.
                                    </div>
                                    <div class="rl-arrow">Voir les évaluations</div>
                                </div>
                            </div>
                        </a>
                    </div>


                </div>
            </div>
        </t>
    </template>
</odoo>
