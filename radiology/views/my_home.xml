<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="portal_my_home_custom" name="Portal Home Custom">
        <t t-set="rl_fullwidth" t-value="True"/>
        <t t-set="breadcrumbs" t-value="False"/>

        <t t-call="portal.portal_layout">
            <t t-set="rv_page_title" t-value="'Mon espace'"/>
            <t t-set="rv_page_subtitle"
               t-value="'Retrouvez vos missions, vos alertes et vos raccourcis dans un dashboard hospitalier moderne.'"/>

            <t t-call="radiology.rv_portal_shell">
                <t t-set="rv_portal_active" t-value="'dashboard'"/>
                <t t-set="rv_portal_hospital" t-value="hospital"/>

                <div class="rv-portal-stack rv-dashboard-page">
                    <section class="rv-dashboard-hero rv-portal-card">
                        <div class="rv-dashboard-hero-copy">
                            <span class="rv-portal-section-kicker">Pilotage centralise</span>
                            <h2>Un espace clair pour publier, suivre et coordonner vos missions en temps reel.</h2>
                            <p>
                                RadioVac rassemble vos besoins, vos candidats et vos notifications dans une interface
                                connectee, legere et orientee action.
                            </p>

                            <div class="rv-dashboard-hero-chips">
                                <span class="rv-dashboard-mini-chip">
                                    <i class="fa fa-bolt"/>
                                    <t t-esc="active_count or 0"/> besoins actifs
                                </span>
                                <span class="rv-dashboard-mini-chip">
                                    <i class="fa fa-check-circle-o"/>
                                    Profil complet a <t t-esc="profile_percent or 0"/>%
                                </span>
                            </div>
                        </div>

                        <div class="rv-dashboard-hero-actions">
                            <a href="/my/missions/new" class="rv-portal-btn rv-portal-btn-primary">
                                <i class="fa fa-plus-circle"/>
                                <span>Publier une mission</span>
                            </a>
                            <a href="/my/missions" class="rv-portal-btn rv-portal-btn-secondary">
                                <i class="fa fa-list-ul"/>
                                <span>Voir les missions</span>
                            </a>
                        </div>

                        <div class="rv-dashboard-profile-card">
                            <span class="rv-dashboard-panel-kicker">Profil et organisation</span>
                            <div class="rv-dashboard-profile-head">
                                <strong>Complet a <t t-esc="profile_percent or 0"/>%</strong>
                                <small><t t-esc="hospital.name if hospital else 'Compte RadioVac'"/></small>
                            </div>

                            <div class="rv-portal-progress-bar">
                                <span t-attf-style="width: #{profile_percent or 0}%;"/>
                            </div>

                            <p>
                                Ajoutez vos informations hospitalieres et vos points de contact pour accelerer le matching.
                            </p>

                            <div class="rv-dashboard-profile-metrics">
                                <span>
                                    <strong><t t-esc="published_count or 0"/></strong>
                                    <small>Publiees</small>
                                </span>
                                <span>
                                    <strong><t t-esc="assigned_count or 0"/></strong>
                                    <small>Affectees</small>
                                </span>
                                <span>
                                    <strong><t t-esc="done_count or 0"/></strong>
                                    <small>Terminees</small>
                                </span>
                            </div>

                            <a href="/my/account" class="rv-portal-inline-link">Mettre a jour le compte</a>
                        </div>
                    </section>

                    <section class="rv-dashboard-stat-grid">
                        <a href="/my/missions" class="rv-dashboard-stat-card">
                            <span class="rv-dashboard-stat-icon"><i class="fa fa-briefcase"/></span>
                            <span class="rv-dashboard-stat-copy">
                                <small>Missions actives</small>
                                <strong><t t-esc="active_count or 0"/></strong>
                                <span>Publiees ou deja affectees</span>
                            </span>
                            <span class="rv-dashboard-stat-arrow"><i class="fa fa-angle-right"/></span>
                        </a>

                        <a href="/my/missionss" class="rv-dashboard-stat-card">
                            <span class="rv-dashboard-stat-icon"><i class="fa fa-files-o"/></span>
                            <span class="rv-dashboard-stat-copy">
                                <small>Candidatures</small>
                                <strong><t t-esc="applications_count or 0"/></strong>
                                <span>Profils recus sur vos missions</span>
                            </span>
                            <span class="rv-dashboard-stat-arrow"><i class="fa fa-angle-right"/></span>
                        </a>

                        <a href="/my/favorites" class="rv-dashboard-stat-card">
                            <span class="rv-dashboard-stat-icon"><i class="fa fa-heart-o"/></span>
                            <span class="rv-dashboard-stat-copy">
                                <small>Favoris</small>
                                <strong><t t-esc="favorites_count or 0"/></strong>
                                <span>Radiologues en veille active</span>
                            </span>
                            <span class="rv-dashboard-stat-arrow"><i class="fa fa-angle-right"/></span>
                        </a>

                        <a href="/my/chat" class="rv-dashboard-stat-card">
                            <span class="rv-dashboard-stat-icon"><i class="fa fa-bell-o"/></span>
                            <span class="rv-dashboard-stat-copy">
                                <small>Notifications</small>
                                <strong><t t-esc="unread_notifications_count or 0"/></strong>
                                <span>Alertes a traiter rapidement</span>
                            </span>
                            <span class="rv-dashboard-stat-arrow"><i class="fa fa-angle-right"/></span>
                        </a>
                    </section>

                    <div class="rv-dashboard-grid">
                        <section class="rv-portal-card rv-dashboard-panel rv-dashboard-panel-missions">
                            <div class="rv-portal-card-head">
                                <div>
                                    <span class="rv-portal-section-kicker">Flux missions</span>
                                    <h3>Dernieres missions creees</h3>
                                </div>
                                <a href="/my/missions" class="rv-portal-inline-link">Tout ouvrir</a>
                            </div>

                            <div class="rv-dashboard-mission-list">
                                <t t-if="recent_missions">
                                    <t t-foreach="recent_missions" t-as="mission">
                                        <a t-att-href="'/my/missions/%s' % mission.id" class="rv-dashboard-mission-row">
                                            <span class="rv-dashboard-mission-icon"><i class="fa fa-stethoscope"/></span>
                                            <span class="rv-dashboard-mission-copy">
                                                <strong><t t-esc="mission.name or 'Mission'"/></strong>
                                                <small>
                                                    <t t-if="mission.start_date">
                                                        <t t-esc="mission.start_date"/>
                                                    </t>
                                                    <t t-if="mission.end_date">
                                                        <t t-esc="' -> %s' % mission.end_date"/>
                                                    </t>
                                                </small>
                                            </span>
                                            <span t-attf-class="rv-portal-status-chip is-#{mission.status or 'draft'}">
                                                <t t-if="mission.status == 'published'">Publiee</t>
                                                <t t-elif="mission.status == 'assigned'">Affectee</t>
                                                <t t-elif="mission.status == 'done'">Terminee</t>
                                                <t t-else="">Brouillon</t>
                                            </span>
                                            <span class="rv-dashboard-row-arrow"><i class="fa fa-angle-right"/></span>
                                        </a>
                                    </t>
                                </t>
                                <t t-else="">
                                    <div class="rv-portal-empty-state">
                                        <strong>Aucune mission recente</strong>
                                        <p>Commencez par publier un nouveau besoin pour alimenter votre dashboard.</p>
                                    </div>
                                </t>
                            </div>
                        </section>

                        <section class="rv-portal-card rv-dashboard-panel rv-dashboard-panel-actions">
                            <div class="rv-portal-card-head">
                                <div>
                                    <span class="rv-portal-section-kicker">Raccourcis</span>
                                    <h3>Actions rapides</h3>
                                </div>
                            </div>

                            <div class="rv-dashboard-quick-grid">
                                <a href="/my/missions/new" class="rv-dashboard-quick-card">
                                    <span class="rv-dashboard-quick-icon"><i class="fa fa-plus-circle"/></span>
                                    <strong>Nouvelle mission</strong>
                                    <small>Publier en quelques clics</small>
                                </a>
                                <a href="/my/radiologists" class="rv-dashboard-quick-card">
                                    <span class="rv-dashboard-quick-icon"><i class="fa fa-user-md"/></span>
                                    <strong>Radiologues</strong>
                                    <small>Explorer les profils verifies</small>
                                </a>
                                <a href="/my/chat" class="rv-dashboard-quick-card">
                                    <span class="rv-dashboard-quick-icon"><i class="fa fa-comments-o"/></span>
                                    <strong>Messages</strong>
                                    <small>Reprendre les echanges</small>
                                </a>
                                <a href="/my/security" class="rv-dashboard-quick-card">
                                    <span class="rv-dashboard-quick-icon"><i class="fa fa-shield"/></span>
                                    <strong>Securite</strong>
                                    <small>Gerer l'acces au compte</small>
                                </a>
                            </div>
                        </section>

                        <section class="rv-portal-card rv-dashboard-panel rv-dashboard-panel-notices">
                            <div class="rv-portal-card-head">
                                <div>
                                    <span class="rv-portal-section-kicker">Alertes et suivi</span>
                                    <h3>Notifications recentes</h3>
                                </div>
                                <a href="/my/chat" class="rv-portal-inline-link">Tout voir</a>
                            </div>

                            <div class="rv-dashboard-notice-list">
                                <t t-if="recent_notifications">
                                    <t t-foreach="recent_notifications" t-as="notif">
                                        <a t-att-href="'/my/notifications/%s/read' % notif.id"
                                           t-attf-class="rv-dashboard-notice-row #{'is-unread' if not notif.is_read else 'is-read'}">
                                            <span t-attf-class="rv-dashboard-notice-dot is-#{notif.type or 'info'}"/>
                                            <span class="rv-dashboard-notice-copy">
                                                <strong><t t-esc="notif.title or 'Notification'"/></strong>
                                                <p><t t-esc="notif.message or 'Mise a jour disponible.'"/></p>
                                            </span>
                                            <small class="rv-dashboard-notice-time">
                                                <t t-esc="notif.create_date.strftime('%d/%m/%Y %H:%M') if notif.create_date else ''"/>
                                            </small>
                                        </a>
                                    </t>
                                </t>
                                <t t-else="">
                                    <div class="rv-portal-empty-state">
                                        <strong>Aucune notification</strong>
                                        <p>Votre espace est a jour. Les nouvelles alertes apparaitront ici.</p>
                                    </div>
                                </t>
                            </div>
                        </section>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
