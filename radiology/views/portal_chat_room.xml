<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="portal_chat_room" name="Portal - Chat Room (RLX Pro Clean)">
    <t t-set="rl_fullwidth" t-value="True"/>
    <t t-set="breadcrumbs" t-value="False"/>

    <t t-call="portal.portal_layout">
      <t t-set="breadcrumbs_searchbar" t-value="True"/>

      <style>
        :root{
          --rlx-text:#0B1220;
          --rlx-muted:#667085;
          --rlx-border: rgba(15,23,42,.10);
          --rlx-card: rgba(255,255,255,.90);
          --rlx-shadow: 0 18px 60px rgba(2,6,23,.10);
          --rlx-shadow2: 0 10px 26px rgba(2,6,23,.08);
          --rlx-primary:#2563EB;
          --rlx-primary-dark:#1D4ED8;
          --rlx-radius: 22px;
        }

        /* portal full width */
        .o_portal_wrap > .container{ max-width:100% !important; padding-left:0 !important; padding-right:0 !important; }
        .o_portal_wrap > .container.pt-3{ padding-top:0 !important; }

        .rlx-page{
          min-height:100vh;
          background:
            radial-gradient(1200px 520px at 12% 0%, rgba(37,99,235,.10), transparent 55%),
            linear-gradient(180deg, #EEF5FF 0%, #F8FAFC 42%, #FFFFFF 100%);
        }
        .rlx-shell{ padding: 22px 18px 46px; }
        @media(min-width:992px){ .rlx-shell{ padding: 34px 34px 64px; } }

        /* Main card */
        .rlx-card{
          border-radius: var(--rlx-radius);
          border: 1px solid var(--rlx-border);
          background: var(--rlx-card);
          box-shadow: var(--rlx-shadow);
          overflow:hidden;
          backdrop-filter: blur(12px);
          -webkit-backdrop-filter: blur(12px);
          position: relative;
        }
        .rlx-card:before{
          content:"";
          position:absolute; inset:-2px;
          background:
            radial-gradient(700px 260px at 18% 0%, rgba(37,99,235,.14), transparent 60%),
            radial-gradient(700px 260px at 85% 0%, rgba(99,102,241,.10), transparent 60%);
          pointer-events:none;
        }
        .rlx-card > *{ position:relative; }

        /* Header */
        .rlx-head{
          padding: 14px 16px;
          display:flex;
          align-items:center;
          justify-content:space-between;
          gap: 12px;
          border-bottom: 1px solid rgba(2,6,23,.08);
          background: rgba(255,255,255,.70);
        }

        .rlx-peer{
          display:flex;
          align-items:center;
          gap: 12px;
          min-width:0;
        }

        .rlx-avatar{
          width: 44px; height: 44px;
          border-radius: 14px;
          overflow:hidden;
          background: linear-gradient(180deg,#EAF2FB 0%,#DDEBFA 100%);
          border: 1px solid rgba(2,6,23,.10);
          flex: 0 0 auto;
        }
        .rlx-avatar img{ width:100%; height:100%; object-fit:cover; display:block; }

        .rlx-peer-title{
          margin:0;
          font-weight: 950;
          letter-spacing:-.02em;
          color: var(--rlx-text);
          font-size: 16px;
          line-height: 1.2;
          white-space:nowrap;
          overflow:hidden;
          text-overflow: ellipsis;
          max-width: 520px;
        }
        .rlx-peer-sub{
          margin-top: 2px;
          color: var(--rlx-muted);
          font-weight: 650;
          font-size: 12.5px;
          white-space:nowrap;
          overflow:hidden;
          text-overflow: ellipsis;
          max-width: 560px;
        }

        .rlx-pill{
          display:inline-flex;
          align-items:center;
          gap: 8px;
          padding: 7px 10px;
          border-radius: 999px;
          border: 1px solid rgba(2,6,23,.08);
          background: rgba(255,255,255,.80);
          font-weight: 900;
          font-size: 12px;
          color: var(--rlx-text);
          white-space:nowrap;
        }
        .rlx-dot{
          width: 8px; height: 8px;
          border-radius: 50%;
          background: #16A34A;
          box-shadow: 0 0 0 4px rgba(22,163,74,.12);
        }

        .rlx-btn{
          border-radius: 14px !important;
          padding: 10px 14px !important;
          font-weight: 850 !important;
        }
        .rlx-ghost{
          background: rgba(37,99,235,.06) !important;
          border: 1px solid rgba(37,99,235,.20) !important;
          color: var(--rlx-primary-dark) !important;
        }
        .rlx-primary{
          background: var(--rlx-primary) !important;
          border: none !important;
          color:#fff !important;
          box-shadow: 0 14px 30px rgba(37,99,235,.18);
        }
        .rlx-primary:hover{ background: var(--rlx-primary-dark) !important; }

        /* Body columns */
        .rlx-body{
          display:grid;
          grid-template-columns: 1fr 320px;
          gap: 0;
        }
        @media(max-width: 991px){
          .rlx-body{ grid-template-columns: 1fr; }
          .rlx-side{ border-left:none !important; border-top: 1px solid rgba(2,6,23,.08) !important; }
        }

        /* Chat zone */
        .rlx-chatWrap{
          display:flex;
          flex-direction:column;
          min-height: 640px;
        }
        @media(max-width: 991px){
          .rlx-chatWrap{ min-height: 620px; }
        }

        .rlx-chat{
          flex: 1;
          overflow-y:auto;
          padding: 18px 16px;
          background:
            radial-gradient(900px 240px at 20% 0%, rgba(37,99,235,.06), transparent 62%),
            linear-gradient(180deg, rgba(248,250,252,.92) 0%, rgba(255,255,255,.88) 100%);
        }

        /* Messages (pro style) */
        .rlx-row{ display:flex; gap: 10px; margin-bottom: 14px; }
        .rlx-row.me{ justify-content:flex-end; }
        .rlx-row.other{ justify-content:flex-start; }

        .rlx-bubble{
          max-width: 74%;
          border-radius: 16px;
          padding: 10px 12px;
          border: 1px solid rgba(2,6,23,.08);
          background: rgba(255,255,255,.92);
          box-shadow: 0 10px 18px rgba(2,6,23,.05);
        }
        .rlx-bubble.me{
          background: rgba(37,99,235,.12);
          border-color: rgba(37,99,235,.20);
          border-bottom-right-radius: 10px;
        }
        .rlx-bubble.other{
          background: rgba(255,255,255,.92);
          border-color: rgba(2,6,23,.10);
          border-bottom-left-radius: 10px;
        }

        .rlx-meta{
          display:flex;
          justify-content:space-between;
          gap:10px;
          font-weight: 950;
          font-size: 12px;
          color: #0F172A;
          margin-bottom: 4px;
        }
        .rlx-date{
          font-weight: 650;
          color: var(--rlx-muted);
          font-size: 12px;
          white-space: nowrap;
        }
        .rlx-text{
          font-weight: 650;
          color: #0B1220;
          font-size: 13.5px;
          line-height: 1.65;
          white-space: pre-wrap;
          word-break: break-word;
        }

        /* Composer (pro) */
        .rlx-compose{
          padding: 12px 12px;
          border-top: 1px solid rgba(2,6,23,.08);
          background: rgba(255,255,255,.86);
          backdrop-filter: blur(10px);
          -webkit-backdrop-filter: blur(10px);
        }
        .rlx-input{
          border-radius: 16px !important;
          border: 1px solid rgba(2,6,23,.12) !important;
          background: rgba(255,255,255,.95) !important;
          font-weight: 650;
          min-height: 48px;
          resize: none;
        }
        .rlx-input:focus{
          border-color: rgba(37,99,235,.45) !important;
          box-shadow: 0 0 0 4px rgba(37,99,235,.12) !important;
        }

        /* Side panel */
        .rlx-side{
          border-left: 1px solid rgba(2,6,23,.08);
          background: rgba(255,255,255,.72);
        }
        .rlx-side-in{ padding: 14px 14px; }

        .rlx-sideTitle{
          font-weight: 950;
          color: var(--rlx-text);
          font-size: 13.5px;
          letter-spacing: -.01em;
          margin: 0 0 10px 0;
        }

        .rlx-kv{
          border: 1px solid rgba(2,6,23,.08);
          background: rgba(255,255,255,.82);
          border-radius: 16px;
          padding: 12px;
          margin-bottom: 12px;
        }
        .rlx-kvRow{
          display:flex;
          align-items:flex-start;
          justify-content:space-between;
          gap: 10px;
          padding: 8px 0;
          border-bottom: 1px dashed rgba(2,6,23,.10);
        }
        .rlx-kvRow:last-child{ border-bottom:0; padding-bottom:0; }
        .rlx-k{ color: var(--rlx-muted); font-weight: 850; font-size: 12px; }
        .rlx-v{ color: var(--rlx-text); font-weight: 900; font-size: 12.5px; text-align:right; }

        .rlx-avRow{
          border: 1px solid rgba(2,6,23,.08);
          background: rgba(255,255,255,.82);
          border-radius: 16px;
          padding: 10px 12px;
          margin-bottom: 10px;
        }
        .rlx-avTop{ display:flex; justify-content:space-between; gap:10px; }
        .rlx-avDay{ font-weight: 950; color:#0F172A; font-size: 12.8px; }
        .rlx-avTime{ font-weight: 900; color:#0F172A; font-size: 12.8px; white-space:nowrap; text-align:right; }

        .rlx-tags{ display:flex; gap:8px; flex-wrap:wrap; justify-content:flex-end; margin-top: 8px; }
        .rlx-tag{
          padding: 6px 10px;
          border-radius: 999px;
          font-weight: 950;
          font-size: 11.5px;
          border: 1px solid;
          background: rgba(255,255,255,.88);
          white-space:nowrap;
        }
        .rlx-tag-night{ border-color:#E9D5FF; color:#6D28D9; background: rgba(233,213,255,.35); }
        .rlx-tag-weekend{ border-color:#A7F3D0; color:#065F46; background: rgba(167,243,208,.35); }
      </style>

      <section class="rlx-page">
        <div class="container-fluid rlx-shell">

          <div class="rlx-card">

            <!-- HEADER -->
            <div class="rlx-head">
              <div class="rlx-peer">
                <div class="rlx-avatar">
                  <t t-if="conversation.radiologist_id and conversation.radiologist_id.image_1920">
                    <img t-att-src="'/web/image/radiology.radiologist/%s/image_1920' % conversation.radiologist_id.id" alt="Radiologue"/>
                  </t>
                  <t t-else="">
                    <div class="w-100 h-100 d-flex align-items-center justify-content-center" style="font-weight:950;color:#2563EB;">RL</div>
                  </t>
                </div>

                <div class="min-w-0">
                  <h2 class="rlx-peer-title">
                    <t t-esc="conversation.radiologist_id.display_name or 'Radiologue'"/>
                  </h2>
                  <div class="rlx-peer-sub">
                    <t t-if="conversation.radiologist_id.specialty_ids">
                      <t t-foreach="conversation.radiologist_id.specialty_ids[:3]" t-as="sp">
                        <span class="me-1"><t t-esc="sp.name"/></span>
                      </t>
                      <t t-if="len(conversation.radiologist_id.specialty_ids) &gt; 3">…</t>
                    </t>
                    <t t-else="">Spécialités non renseignées</t>
                  </div>
                </div>

                <span class="rlx-pill ms-2"><span class="rlx-dot"></span> En ligne</span>
              </div>

              <div class="d-flex gap-2 flex-wrap">
                <a t-att-href="'/my/radiologists/%s' % conversation.radiologist_id.id" class="btn rlx-btn rlx-ghost">
                  Voir profil
                </a>
                <a href="/my/chat" class="btn rlx-btn rlx-ghost">Retour</a>
              </div>
            </div>

            <!-- BODY -->
            <div class="rlx-body">

              <!-- CHAT -->
              <div class="rlx-chatWrap">

                <div class="rlx-chat" id="chat_box">
                  <t t-if="messages">
                    <t t-foreach="messages" t-as="m">
                      <t t-set="is_hospital" t-value="m['sender_type'] == 'hospital'"/>

                      <div t-attf-class="rlx-row #{'me' if is_hospital else 'other'}">
                        <div t-attf-class="rlx-bubble #{'me' if is_hospital else 'other'}" t-att-data-id="m['id']">

                          <div class="rlx-meta">
                            <span>
                              <t t-if="is_hospital">Vous</t>
                              <t t-else="">Radiologue</t>
                            </span>
                            <span class="rlx-date"><t t-esc="m['date']"/></span>
                          </div>

                          <div class="rlx-text"><t t-esc="m['message']"/></div>

                        </div>
                      </div>

                    </t>
                  </t>

                  <t t-else="">
                    <div class="p-4 text-center" style="color:var(--rlx-muted);font-weight:650;">
                      Aucun message pour le moment.
                    </div>
                  </t>
                </div>

                <div class="rlx-compose">
                  <form id="chat_form">
                    <input type="hidden" id="conv_id" t-att-value="conversation.id"/>
                    <div class="input-group">
                      <textarea id="chat_input" class="form-control rlx-input"
                                rows="1" required="required"
                                placeholder="Écrire un message…"></textarea>
                      <button class="btn rlx-btn rlx-primary px-4" type="submit">Envoyer</button>
                    </div>
                  </form>
                </div>

              </div>

              <!-- SIDE -->
              <aside class="rlx-side">
                <div class="rlx-side-in">

                  <h4 class="rlx-sideTitle">Détails</h4>
                  <div class="rlx-kv">
                    <div class="rlx-kvRow">
                      <div class="rlx-k">Email</div>
                      <div class="rlx-v"><t t-esc="conversation.radiologist_id.email or '—'"/></div>
                    </div>
                    <div class="rlx-kvRow">
                      <div class="rlx-k">Téléphone</div>
                      <div class="rlx-v"><t t-esc="conversation.radiologist_id.phone or '—'"/></div>
                    </div>
                    <div class="rlx-kvRow">
                      <div class="rlx-k">Expérience</div>
                      <div class="rlx-v"><t t-esc="conversation.radiologist_id.experience_years or 0"/> ans</div>
                    </div>
                  </div>

                  <h4 class="rlx-sideTitle">Disponibilités</h4>
                  <t t-if="availabilities">
                    <t t-foreach="availabilities" t-as="a">
                      <div class="rlx-avRow">
                        <div class="rlx-avTop">
                          <div class="rlx-avDay"><t t-esc="a['day']"/></div>
                          <div class="rlx-avTime"><t t-esc="a['time']"/></div>
                        </div>
                        <div class="rlx-tags">
                          <t t-if="a.get('is_night')"><span class="rlx-tag rlx-tag-night">Nuit</span></t>
                          <t t-if="a.get('is_weekend')"><span class="rlx-tag rlx-tag-weekend">Weekend</span></t>
                        </div>
                      </div>
                    </t>
                  </t>
                  <t t-else="">
                    <div class="text-muted" style="font-weight:650;">Aucune disponibilité renseignée.</div>
                  </t>

                </div>
              </aside>

            </div>
          </div>

        </div>
      </section>

      <script type="text/javascript">
        (function(){
          function scrollBottom(){
            var box = document.getElementById('chat_box');
            if (box) box.scrollTop = box.scrollHeight;
          }
          document.addEventListener('DOMContentLoaded', scrollBottom);
          setTimeout(scrollBottom, 250);
        })();
      </script>

    </t>
  </template>
</odoo>
