<odoo>
    <record id="view_mission_tree" model="ir.ui.view">
        <field name="name">radiology.mission.tree</field>
        <field name="model">radiology.mission</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="hospital_id"/>
                <field name="speciality_ids"/>
                <field name="brand_ids"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="view_mission_form" model="ir.ui.view">
        <field name="name">radiology.mission.form</field>
        <field name="model">radiology.mission</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="hospital_id"/>
                        <field name="speciality_ids" widget="many2many_tags" string="Specialties"/>
                        <field name="brand_ids" widget="many2many_tags" string="brand"/>
                        <field name="description"/>
                        <field name="avantage"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="tarif_type"/>
                        <field name="tarif"/>
                        <field name="status"/>
                        <field name="application_ids">
                            <tree>
                                <field name="radiologist_id"/>
                                <field name="status"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mission" model="ir.actions.act_window">
        <field name="name">Missions</field>
        <field name="res_model">radiology.mission</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
