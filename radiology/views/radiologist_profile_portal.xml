<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="portal_radiologist_profile_modern" name="Portal - Radiologist Profile (RadioVac SaaS)">
        <t t-set="rl_fullwidth" t-value="True"/>
        <t t-set="breadcrumbs" t-value="False"/>
        <t t-set="no_breadcrumbs" t-value="True"/>

        <t t-call="portal.portal_layout">
            <t t-set="rv_page_title" t-value="'Radiologues'"/>
            <t t-set="rv_page_subtitle"
               t-value="'Consultez les profils disponibles et coordonnez vos missions avec le bon specialiste.'"/>
            <t t-set="weekday_map"
               t-value="{'0': 'Lundi', '1': 'Mardi', '2': 'Mercredi', '3': 'Jeudi', '4': 'Vendredi', '5': 'Samedi', '6': 'Dimanche'}"/>
            <t t-set="profile_location"
               t-value="(radiologist.hospital_id.city or radiologist.hospital_id.name or 'France') if radiologist.hospital_id else 'France'"/>
            <t t-set="has_active_availability" t-value="bool(availabilities)"/>
            <t t-set="member_since"
               t-value="radiologist.create_date.strftime('%m/%Y') if radiologist.create_date else '-'"/>

            <t t-call="radiology.rv_portal_shell">
                <t t-set="rv_portal_active" t-value="'radiologists'"/>

                <div class="rv-portal-stack rv-radiologist-profile-page">
                    <a href="/my/radiologists" class="rv-radiologist-profile-back">
                        <i class="fa fa-arrow-left"/>
                        <span>Retour aux radiologues</span>
                    </a>

                    <section class="rv-portal-card rv-radiologist-profile-hero">
                        <div class="rv-radiologist-profile-media">
                            <t t-if="radiologist.image_1920">
                                <img t-att-src="'/web/image/radiology.radiologist/%s/image_1920' % radiologist.id"
                                     alt="Photo radiologue"/>
                            </t>
                            <t t-else="">
                                <img src="/web/static/img/user_menu_avatar.png" alt="Avatar radiologue"/>
                            </t>

                            <span t-attf-class="rv-radiologist-profile-status #{'is-available' if has_active_availability else 'is-pending'}">
                                <span class="rv-radiologist-profile-status-dot"/>
                                <t t-esc="'Disponible' if has_active_availability else 'Planning a confirmer'"/>
                            </span>
                        </div>

                        <div class="rv-radiologist-profile-main">
                            <div class="rv-radiologist-profile-head">
                                <div>
                                    <h2><t t-esc="radiologist.display_name or 'Radiologue'"/></h2>
                                    <p class="rv-radiologist-profile-subtitle">
                                        <t t-if="radiologist.specialty_ids">
                                            Radiologue diplome, specialise en
                                            <t t-esc="', '.join(radiologist.specialty_ids[:3].mapped('name'))"/>
                                        </t>
                                        <t t-else="">Radiologue diplome, specialise en imagerie medicale</t>
                                    </p>
                                </div>
                            </div>

                            <div class="rv-radiologist-profile-meta">
                                <span>
                                    <i class="fa fa-briefcase"/>
                                    <t t-if="radiologist.experience_years">
                                        <t t-esc="radiologist.experience_years"/> ans d'experience
                                    </t>
                                    <t t-else="">Experience non renseignee</t>
                                </span>
                                <span>
                                    <i class="fa fa-map-marker"/>
                                    <t t-esc="profile_location"/>
                                </span>
                                <span t-attf-class="rv-radiologist-profile-meta-status #{'is-available' if has_active_availability else 'is-pending'}">
                                    <span class="rv-radiologist-profile-status-dot"/>
                                    <t t-esc="'Disponible' if has_active_availability else 'Planning a confirmer'"/>
                                </span>
                            </div>

                            <div class="rv-radiologist-profile-chips">
                                <t t-if="radiologist.specialty_ids">
                                    <t t-foreach="radiologist.specialty_ids[:4]" t-as="sp">
                                        <span class="rv-radiologist-profile-chip">
                                            <t t-esc="sp.name"/>
                                        </span>
                                    </t>
                                </t>
                                <t t-else="">
                                    <span class="rv-radiologist-profile-chip is-muted">Specialites a completer</span>
                                </t>
                            </div>

                            <div class="rv-radiologist-profile-chips is-secondary">
                                <t t-if="radiologist.brand_ids">
                                    <t t-foreach="radiologist.brand_ids[:4]" t-as="br">
                                        <span class="rv-radiologist-profile-chip is-secondary">
                                            <t t-esc="br.name"/>
                                        </span>
                                    </t>
                                </t>
                                <t t-else="">
                                    <span class="rv-radiologist-profile-chip is-secondary">Equipements a completer</span>
                                </t>
                            </div>

                            <div class="rv-radiologist-profile-actions">
                                <a t-att-href="'/my/chat/start/%s' % radiologist.id"
                                   class="rv-portal-btn rv-portal-btn-primary">
                                    <i class="fa fa-comments-o"/>
                                    <span>Lancer une conversation</span>
                                </a>
                                <a href="/my/radiologists" class="rv-portal-btn rv-portal-btn-secondary">
                                    <i class="fa fa-arrow-left"/>
                                    <span>Retour</span>
                                </a>
                            </div>
                        </div>

                        <aside class="rv-radiologist-profile-summary">
                            <span class="rv-portal-section-kicker">Presentation</span>
                            <p>
                                <t t-if="radiologist.bio">
                                    <t t-esc="radiologist.bio"/>
                                </t>
                                <t t-else="">
                                    Profil RadioVac disponible pour vos missions d'imagerie, avec une presentation claire
                                    des competences, des equipements et des disponibilites.
                                </t>
                            </p>

                            <div class="rv-radiologist-profile-summary-metrics">
                                <t t-if="can_see and radiologist.rating_count">
                                    <span class="rv-radiologist-profile-score">
                                        <i class="fa fa-star"/>
                                        <t t-esc="'%.1f' % (radiologist.rating_avg or 0.0)"/>
                                        <small>/ 5</small>
                                    </span>
                                    <span class="rv-radiologist-profile-score-note">
                                        <t t-esc="radiologist.rating_count"/> avis verifies
                                    </span>
                                </t>
                                <t t-else="">
                                    <span class="rv-radiologist-profile-score-note">Profil visible dans votre reseau RadioVac</span>
                                </t>
                            </div>
                        </aside>
                    </section>

                    <div class="rv-radiologist-profile-grid">
                        <section class="rv-portal-card rv-radiologist-profile-info-card">
                            <div class="rv-radiologist-profile-card-head">
                                <h3>Informations</h3>
                            </div>

                            <div class="rv-radiologist-profile-facts">
                                <div class="rv-radiologist-profile-fact">
                                    <span class="rv-radiologist-profile-fact-icon"><i class="fa fa-briefcase"/></span>
                                    <div>
                                        <small>Experience</small>
                                        <strong>
                                            <t t-if="radiologist.experience_years">
                                                <t t-esc="radiologist.experience_years"/> ans
                                            </t>
                                            <t t-else="">Non renseignee</t>
                                        </strong>
                                    </div>
                                </div>

                                <div class="rv-radiologist-profile-fact">
                                    <span class="rv-radiologist-profile-fact-icon"><i class="fa fa-stethoscope"/></span>
                                    <div>
                                        <small>Specialites</small>
                                        <strong>
                                            <t t-if="radiologist.specialty_ids">
                                                <t t-esc="', '.join(radiologist.specialty_ids[:3].mapped('name'))"/>
                                            </t>
                                            <t t-else="">A completer</t>
                                        </strong>
                                    </div>
                                </div>

                                <div class="rv-radiologist-profile-fact">
                                    <span class="rv-radiologist-profile-fact-icon"><i class="fa fa-cogs"/></span>
                                    <div>
                                        <small>Equipements</small>
                                        <strong>
                                            <t t-if="radiologist.brand_ids">
                                                <t t-esc="', '.join(radiologist.brand_ids[:3].mapped('name'))"/>
                                            </t>
                                            <t t-else="">A completer</t>
                                        </strong>
                                    </div>
                                </div>

                                <div class="rv-radiologist-profile-fact">
                                    <span class="rv-radiologist-profile-fact-icon"><i class="fa fa-hospital-o"/></span>
                                    <div>
                                        <small>Etablissement</small>
                                        <strong><t t-esc="radiologist.hospital_id.name if radiologist.hospital_id else 'RadioVac'"/></strong>
                                    </div>
                                </div>

                                <div class="rv-radiologist-profile-fact">
                                    <span class="rv-radiologist-profile-fact-icon"><i class="fa fa-map-marker"/></span>
                                    <div>
                                        <small>Localisation</small>
                                        <strong><t t-esc="profile_location"/></strong>
                                    </div>
                                </div>

                                <div class="rv-radiologist-profile-fact">
                                    <span class="rv-radiologist-profile-fact-icon"><i class="fa fa-id-card-o"/></span>
                                    <div>
                                        <small>Membre depuis</small>
                                        <strong><t t-esc="member_since"/></strong>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="rv-portal-card rv-radiologist-profile-docs-card">
                            <div class="rv-radiologist-profile-card-head">
                                <div class="rv-radiologist-profile-tabs nav" role="tablist">
                                    <button class="nav-link rv-radiologist-profile-tab active"
                                            type="button"
                                            data-bs-toggle="tab"
                                            data-bs-target="#rv_profile_tab_diplomas"
                                            role="tab">
                                        Diplomes
                                    </button>
                                    <button class="nav-link rv-radiologist-profile-tab"
                                            type="button"
                                            data-bs-toggle="tab"
                                            data-bs-target="#rv_profile_tab_cv"
                                            role="tab">
                                        CV
                                    </button>
                                    <button class="nav-link rv-radiologist-profile-tab"
                                            type="button"
                                            data-bs-toggle="tab"
                                            data-bs-target="#rv_profile_tab_reviews"
                                            role="tab">
                                        Avis
                                    </button>
                                </div>
                            </div>

                            <div class="tab-content rv-radiologist-profile-tab-content">
                                <div class="tab-pane fade show active" id="rv_profile_tab_diplomas" role="tabpanel">
                                    <t t-if="can_see">
                                        <t t-if="diplomes">
                                            <div class="rv-radiologist-profile-doc-list">
                                                <t t-foreach="diplomes" t-as="att">
                                                    <article class="rv-radiologist-profile-doc-row">
                                                        <div class="rv-radiologist-profile-doc-main">
                                                            <span class="rv-radiologist-profile-doc-icon">PDF</span>
                                                            <div>
                                                                <strong><t t-esc="att.name"/></strong>
                                                                <small>
                                                                    <t t-if="att.file_size">
                                                                        PDF - <t t-esc="'%.1f' % ((att.file_size or 0) / 1048576.0)"/> Mo
                                                                    </t>
                                                                    <t t-else="">Document securise</t>
                                                                </small>
                                                            </div>
                                                        </div>
                                                        <a t-att-href="'/my/radiologists/attachment/%s/%s/view' % (radiologist.id, att.id)"
                                                           target="_blank"
                                                           class="rv-radiologist-profile-doc-action">
                                                            <i class="fa fa-eye"/>
                                                            <span>Voir</span>
                                                        </a>
                                                    </article>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <div class="rv-radiologist-profile-empty">Aucun diplome ajoute.</div>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <div class="rv-radiologist-profile-lock">
                                            <strong>Acces reserve Premium / Pro</strong>
                                            <p>Debloquez les diplomes et les documents verifies depuis votre abonnement.</p>
                                        </div>
                                    </t>
                                </div>

                                <div class="tab-pane fade" id="rv_profile_tab_cv" role="tabpanel">
                                    <t t-if="can_see">
                                        <t t-if="cvs">
                                            <div class="rv-radiologist-profile-doc-list">
                                                <t t-foreach="cvs" t-as="att">
                                                    <article class="rv-radiologist-profile-doc-row">
                                                        <div class="rv-radiologist-profile-doc-main">
                                                            <span class="rv-radiologist-profile-doc-icon is-cv">CV</span>
                                                            <div>
                                                                <strong><t t-esc="att.name"/></strong>
                                                                <small>
                                                                    <t t-if="att.file_size">
                                                                        Piece jointe - <t t-esc="'%.1f' % ((att.file_size or 0) / 1048576.0)"/> Mo
                                                                    </t>
                                                                    <t t-else="">Document securise</t>
                                                                </small>
                                                            </div>
                                                        </div>
                                                        <a t-att-href="'/my/radiologists/attachment/%s/%s/view' % (radiologist.id, att.id)"
                                                           target="_blank"
                                                           class="rv-radiologist-profile-doc-action">
                                                            <i class="fa fa-eye"/>
                                                            <span>Voir</span>
                                                        </a>
                                                    </article>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <div class="rv-radiologist-profile-empty">Aucun CV ajoute.</div>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <div class="rv-radiologist-profile-lock">
                                            <strong>Acces reserve Premium / Pro</strong>
                                            <p>Le CV complet et les pieces jointes sont visibles avec votre offre avancee.</p>
                                        </div>
                                    </t>
                                </div>

                                <div class="tab-pane fade" id="rv_profile_tab_reviews" role="tabpanel">
                                    <t t-if="can_see">
                                        <t t-if="ratings">
                                            <div class="rv-radiologist-profile-review-preview">
                                                <t t-foreach="ratings[:3]" t-as="rev">
                                                    <article class="rv-radiologist-profile-review-teaser">
                                                        <div class="rv-radiologist-profile-review-teaser-top">
                                                            <strong><t t-esc="rev.hospital_id.name or 'Etablissement'"/></strong>
                                                            <span>
                                                                <i t-foreach="[0,1,2,3,4]" t-as="idx"
                                                                   t-attf-class="fa #{'fa-star' if idx &lt; int(round(rev.score_avg or 0.0)) else 'fa-star-o'}"/>
                                                            </span>
                                                        </div>
                                                        <p><t t-esc="rev.comment or 'Retour positif sur la collaboration et la qualite du suivi.'"/></p>
                                                    </article>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <div class="rv-radiologist-profile-empty">Aucun avis disponible.</div>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <div class="rv-radiologist-profile-lock">
                                            <strong>Avis verifies reserves</strong>
                                            <p>Les retours detailles et les notes moyennes sont disponibles sur les plans Premium et Pro.</p>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </section>

                        <section class="rv-portal-card rv-radiologist-profile-availability-card">
                            <div class="rv-radiologist-profile-card-head">
                                <h3>Disponibilites</h3>
                            </div>

                            <t t-if="availabilities">
                                <div class="rv-radiologist-profile-slot-grid">
                                    <t t-foreach="availabilities[:6]" t-as="slot">
                                        <t t-set="slot_start_h" t-value="int(slot.start_time or 0)"/>
                                        <t t-set="slot_start_m" t-value="int((slot.start_time - int(slot.start_time)) * 60) if slot.start_time is not None else 0"/>
                                        <t t-set="slot_end_h" t-value="int(slot.end_time or 0)"/>
                                        <t t-set="slot_end_m" t-value="int((slot.end_time - int(slot.end_time)) * 60) if slot.end_time is not None else 0"/>
                                        <article class="rv-radiologist-profile-slot">
                                            <strong><t t-esc="weekday_map.get(slot.weekday, slot.weekday)"/></strong>
                                            <span>
                                                <t t-esc="'%02d:%02d' % (slot_start_h, slot_start_m)"/>
                                                -
                                                <t t-esc="'%02d:%02d' % (slot_end_h, slot_end_m)"/>
                                            </span>
                                            <i t-attf-class="fa #{'fa-moon-o' if slot.is_night else 'fa-sun-o'}"/>
                                        </article>
                                    </t>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="rv-radiologist-profile-empty">Aucun creneau actif renseigne.</div>
                            </t>
                        </section>
                    </div>

                    <section class="rv-portal-card rv-radiologist-profile-reviews-card">
                        <div class="rv-radiologist-profile-card-head">
                            <div>
                                <h3>Avis</h3>
                                <p t-if="can_see and radiologist.rating_count" class="rv-radiologist-profile-reviews-subtitle">
                                    <t t-esc="'%.1f' % (radiologist.rating_avg or 0.0)"/> / 5 sur
                                    <t t-esc="radiologist.rating_count"/> evaluation<t t-if="radiologist.rating_count &gt; 1">s</t>
                                </p>
                            </div>
                        </div>

                        <t t-if="can_see">
                            <t t-if="ratings">
                                <div class="rv-radiologist-profile-review-list">
                                    <t t-foreach="ratings[:6]" t-as="rev">
                                        <article class="rv-radiologist-profile-review-row">
                                            <div class="rv-radiologist-profile-review-author">
                                                <span class="rv-radiologist-profile-review-avatar">
                                                    <t t-esc="(rev.hospital_id.name or 'E')[0].upper()"/>
                                                </span>
                                                <div>
                                                    <strong><t t-esc="rev.hospital_id.name or 'Etablissement'"/></strong>
                                                    <small><t t-esc="rev.date.strftime('%d/%m/%Y - %H:%M') if rev.date else ''"/></small>
                                                </div>
                                            </div>

                                            <div class="rv-radiologist-profile-review-score">
                                                <span class="rv-radiologist-profile-review-stars">
                                                    <i t-foreach="[0,1,2,3,4]" t-as="idx"
                                                       t-attf-class="fa #{'fa-star' if idx &lt; int(round(rev.score_avg or 0.0)) else 'fa-star-o'}"/>
                                                </span>
                                                <strong><t t-esc="'%.1f' % (rev.score_avg or 0.0)"/> / 5</strong>
                                            </div>

                                            <div class="rv-radiologist-profile-review-bars">
                                                <div class="rv-radiologist-profile-bar-row">
                                                    <span>Ponctualite</span>
                                                    <div class="rv-radiologist-profile-bar-track">
                                                        <span t-att-style="'width: ' + str(float(rev.punctuality or 0) * 20) + '%'"></span>
                                                    </div>
                                                </div>
                                                <div class="rv-radiologist-profile-bar-row">
                                                    <span>Relation humaine</span>
                                                    <div class="rv-radiologist-profile-bar-track">
                                                        <span t-att-style="'width: ' + str(float(rev.human_relation or 0) * 20) + '%'"></span>
                                                    </div>
                                                </div>
                                                <div class="rv-radiologist-profile-bar-row">
                                                    <span>Competence</span>
                                                    <div class="rv-radiologist-profile-bar-track">
                                                        <span t-att-style="'width: ' + str(float(rev.competence or 0) * 20) + '%'"></span>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="rv-radiologist-profile-review-comment">
                                                <p><t t-esc="rev.comment or 'Collaboration fluide et qualite de suivi tres appreciee.'"/></p>
                                            </div>
                                        </article>
                                    </t>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="rv-radiologist-profile-empty">Aucun avis disponible pour ce profil.</div>
                            </t>
                        </t>
                        <t t-else="">
                            <div class="rv-radiologist-profile-lock is-large">
                                <strong>Acces Premium / Pro requis</strong>
                                <p>Les avis verifies, la note moyenne et le detail des evaluations sont reserves aux offres avancees.</p>
                            </div>
                        </t>
                    </section>
                </div>
            </t>
        </t>
    </template>
</odoo>
