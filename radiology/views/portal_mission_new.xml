<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="portal_mission_new" name="Portal - New Mission">
    <t t-call="portal.portal_layout">

      <section class="py-4"
        style="background: linear-gradient(180deg, #EAF2FB 0%, #F8FAFC 50%, #FFFFFF 100%);">
        <div class="container" style="max-width: 980px;">

          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
              <h2 class="mb-1" style="color:#1F2937;">Publier une mission</h2>
              <div class="text-muted">Renseignez les détails pour la rendre visible sur RadioLink.</div>
            </div>
            <a href="/my/missions" class="btn btn-light" style="border-radius:12px;">
              ← Retour
            </a>
          </div>

          <div class="card border-0 shadow-sm" style="border-radius: 18px; overflow:hidden;">
            <div style="height:5px; background: linear-gradient(90deg,#2F80ED 0%,#6EC6FF 50%,#2F80ED 100%);"></div>

            <div class="card-body p-3 p-md-4">

              <t t-if="error">
                <div class="alert alert-danger border-0" style="border-radius: 14px;">
                  <t t-esc="error"/>
                </div>
              </t>

              <form method="post" action="/my/missions/new">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                <!-- Nom -->
                <div class="mb-3">
                  <label class="form-label fw-semibold" style="color:#374151;">Nom de la mission</label>
                  <input class="form-control form-control-lg"
                         style="border-radius: 14px;"
                         type="text" name="name" required="required"
                         placeholder="Ex : Mission mammographie - 3 jours"
                         t-att-value="values.get('name') or ''"/>
                </div>

                <div class="row g-3">
                  <!-- Tarif -->
                  <div class="col-md-4">
                    <label class="form-label fw-semibold" style="color:#374151;">Tarif (€)</label>
                    <input class="form-control"
                           style="border-radius: 14px;"
                           type="text" name="tarif"
                           placeholder="Ex : 35"
                           t-att-value="values.get('tarif') or ''"/>
                    <div class="text-muted mt-1" style="font-size:12px;">Exemple : 35 ou 35.5</div>
                  </div>

                  <!-- Dates -->
                  <div class="col-md-4">
                    <label class="form-label fw-semibold" style="color:#374151;">Date début</label>
                    <input class="form-control"
                           style="border-radius: 14px;"
                           type="date" name="start_date"
                           t-att-value="values.get('start_date') or ''"/>
                  </div>

                  <div class="col-md-4">
                    <label class="form-label fw-semibold" style="color:#374151;">Date fin</label>
                    <input class="form-control"
                           style="border-radius: 14px;"
                           type="date" name="end_date"
                           t-att-value="values.get('end_date') or ''"/>
                  </div>
                </div>

                <div class="row g-3 mt-1">
                  <!-- Spécialités -->
                  <div class="col-md-6">
                    <label class="form-label fw-semibold" style="color:#374151;">Spécialités</label>
                    <select class="form-select" name="specialty_ids" multiple="multiple"
                            style="border-radius: 14px; min-height: 120px;">
                      <t t-foreach="specialties" t-as="s">
                        <option t-att-value="s.id"><t t-esc="s.name"/></option>
                      </t>
                    </select>
                    <div class="text-muted mt-1" style="font-size:12px;">Ctrl/Command pour sélectionner plusieurs.</div>
                  </div>

                  <!-- Marques -->
                  <div class="col-md-6">
                    <label class="form-label fw-semibold" style="color:#374151;">Marques</label>
                    <select class="form-select" name="brand_ids" multiple="multiple"
                            style="border-radius: 14px; min-height: 120px;">
                      <t t-foreach="brands" t-as="b">
                        <option t-att-value="b.id"><t t-esc="b.name"/></option>
                      </t>
                    </select>
                  </div>
                </div>

                <!-- Description -->
                <div class="mt-3">
                  <label class="form-label fw-semibold" style="color:#374151;">Description</label>
                  <textarea class="form-control"
                            style="border-radius: 14px; min-height: 140px;"
                            name="description"
                            placeholder="Décrivez le contexte, les horaires, le matériel, les prérequis…"><t t-esc="values.get('description') or ''"/></textarea>
                </div>

                <!-- Publier maintenant -->
                <div class="card border-0 mt-3"
                     style="border-radius: 14px; background:#F0F7FF; border: 1px solid #CFE3FF;">
                  <div class="card-body py-3">
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" name="publish_now" id="publish_now"
                             t-att-checked="1 if values.get('publish_now') else None"/>
                      <label class="form-check-label fw-semibold" for="publish_now" style="color:#0B2A55;">
                        Publier maintenant (visible par tous les établissements)
                      </label>
                      <div class="text-muted" style="font-size:12px;">
                        Si non coché, la mission sera enregistrée en brouillon (Draft).
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Actions -->
                <div class="d-flex flex-wrap gap-2 mt-4">
                  <button class="btn btn-primary"
                          style="border-radius: 14px; background: linear-gradient(90deg,#2F80ED 0%,#5FA8FF 100%); border:0; padding: 10px 16px;">
                    Enregistrer
                  </button>
                  <a href="/my/missions" class="btn btn-light" style="border-radius: 14px; padding: 10px 16px;">
                    Annuler
                  </a>
                </div>

              </form>

            </div>
          </div>

        </div>
      </section>

    </t>
  </template>
</odoo>
