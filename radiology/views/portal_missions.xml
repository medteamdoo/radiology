<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="portal_all_missions" name="Portal - All Missions (RadioVac SaaS)">
        <t t-set="rl_fullwidth" t-value="True"/>
        <t t-set="rl_ads" t-value="True"/>
        <t t-set="rl_ads_img" t-value="'/radiology/static/src/img/gel_eco.png'"/>
        <t t-set="rl_ads_title" t-value="'Gel echographique Pro'"/>
        <t t-set="rl_ads_sub" t-value="'Hypoallergenique - Sans bulles - Compatible toutes sondes'"/>
        <t t-set="rl_ads_url" t-value="'#'"/>
        <t t-set="breadcrumbs" t-value="False"/>
        <t t-set="no_breadcrumbs" t-value="True"/>

        <t t-call="portal.portal_layout">
            <t t-set="rv_page_title" t-value="'Missions'"/>
            <t t-set="rv_page_subtitle"
               t-value="'Parcourez les besoins publies, appliquez vos filtres et activez le matching RadioVac.'"/>

            <t t-call="radiology.rv_portal_shell">
                <t t-set="rv_portal_active" t-value="'missions'"/>

                <div class="rv-portal-stack rv-missions-page">
                    <section class="rv-portal-card rv-missions-intro">
                        <div class="rv-portal-card-head">
                            <div>
                                <span class="rv-portal-section-kicker">Hub missions</span>
                                <h2>Une lecture claire de toutes les offres actives.</h2>
                                <p>
                                    Filtrez vos missions par specialite, marque ou periode puis ouvrez rapidement les
                                    profils les plus coherents.
                                </p>
                            </div>
                            <div class="rv-portal-head-actions">
                                <span class="rv-portal-soft-badge">
                                    <i class="fa fa-briefcase"/>
                                    <t t-esc="len(missions)"/> missions visibles
                                </span>
                                <a href="/my/missions/new" class="rv-portal-btn rv-portal-btn-primary">Publier une mission</a>
                            </div>
                        </div>
                    </section>

                    <t t-if="recommended_radiologists">
                        <section class="rv-portal-card rv-portal-match-panel">
                            <div class="rv-portal-card-head">
                                <div>
                                    <span class="rv-portal-section-kicker">Matching intelligent</span>
                                    <h3>Profils recommandes pour votre mission</h3>
                                </div>
                                <span class="rv-portal-soft-badge is-success">
                                    <i class="fa fa-star-o"/>
                                    <t t-esc="len(recommended_radiologists)"/> profils recommandes
                                </span>
                            </div>

                            <div class="rv-portal-match-list">
                                <t t-foreach="recommended_radiologists" t-as="rr">
                                    <a t-att-href="'/my/radiologists/%s' % rr.id"
                                       t-attf-class="rv-portal-match-card #{'is-featured' if rr == recommended_radiologists[0] else ''}">
                                        <div class="rv-portal-match-main">
                                            <div class="rv-portal-match-avatar">
                                                <t t-if="rr.image_1920">
                                                    <img t-att-src="'/web/image/radiology.radiologist/%s/image_1920' % rr.id"
                                                         alt="Radiologue"/>
                                                </t>
                                                <t t-else="">
                                                    <img src="/web/static/img/user_menu_avatar.png" alt="Radiologue"/>
                                                </t>
                                            </div>

                                            <div class="rv-portal-match-copy">
                                                <div class="rv-portal-match-title-row">
                                                    <strong><t t-esc="rr.display_name or 'Radiologue'"/></strong>
                                                    <span class="rv-portal-soft-badge">
                                                        <i class="fa fa-map-marker"/>
                                                        <t t-esc="(rr.hospital_id.city or rr.hospital_id.name or 'France') if rr.hospital_id else 'France'"/>
                                                    </span>
                                                </div>
                                                <p>
                                                    <t t-if="rr.experience_years">
                                                        <t t-esc="rr.experience_years"/> ans d'experience
                                                    </t>
                                                    <t t-else="">Profil verifie RadioVac</t>
                                                </p>
                                                <div class="rv-portal-tag-row">
                                                    <t t-foreach="rr.specialty_ids[:2]" t-as="sp">
                                                        <span class="rv-portal-tag-chip"><t t-esc="sp.name"/></span>
                                                    </t>
                                                    <t t-foreach="rr.brand_ids[:2]" t-as="br">
                                                        <span class="rv-portal-tag-chip is-muted"><t t-esc="br.name"/></span>
                                                    </t>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="rv-portal-match-score" t-attf-style="--rv-match: #{int((rr.rating_avg or 0.0) * 20)};">
                                            <span><t t-esc="int((rr.rating_avg or 0.0) * 20)"/>%</span>
                                            <small>Compatibilite</small>
                                        </div>
                                    </a>
                                </t>
                            </div>
                        </section>
                    </t>

                    <form class="rv-portal-filter-bar" method="get" action="/my/missions">
                        <div class="rv-portal-filter-field">
                            <label for="rv_specialty_id">Specialite</label>
                            <select id="rv_specialty_id" name="specialty_id">
                                <option value="">Toutes</option>
                                <t t-foreach="specialties" t-as="s">
                                    <option t-att-value="s.id"
                                            t-att-selected="1 if str(s.id) == str(request.params.get('specialty_id') or '') else None">
                                        <t t-esc="s.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>

                        <div class="rv-portal-filter-field">
                            <label for="rv_brand_id">Marque</label>
                            <select id="rv_brand_id" name="brand_id">
                                <option value="">Toutes</option>
                                <t t-foreach="brands" t-as="b">
                                    <option t-att-value="b.id"
                                            t-att-selected="1 if str(b.id) == str(request.params.get('brand_id') or '') else None">
                                        <t t-esc="b.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>

                        <div class="rv-portal-filter-field">
                            <label for="rv_date_from">Du</label>
                            <input id="rv_date_from" type="date" name="date_from"
                                   t-att-value="request.params.get('date_from') or ''"/>
                        </div>

                        <div class="rv-portal-filter-field">
                            <label for="rv_date_to">Au</label>
                            <input id="rv_date_to" type="date" name="date_to"
                                   t-att-value="request.params.get('date_to') or ''"/>
                        </div>

                        <div class="rv-portal-filter-actions">
                            <button type="submit" class="rv-portal-btn rv-portal-btn-primary">Filtrer</button>
                            <a href="/my/missions" class="rv-portal-btn rv-portal-btn-secondary">Reinitialiser</a>
                        </div>
                    </form>

                    <t t-if="missions">
                        <div class="rv-portal-mission-grid">
                            <t t-foreach="missions" t-as="m">
                                <article class="rv-portal-mission-card">
                                    <a t-att-href="'/my/missions/%s' % m.id" class="rv-portal-mission-media">
                                        <t t-if="m.hospital_id and m.hospital_id.image_1920">
                                            <img t-att-src="'/web/image/radiology.hospital/%s/image_1920' % m.hospital_id.id"
                                                 alt="Mission"/>
                                        </t>
                                        <t t-else="">
                                            <img src="/web/static/img/placeholder.png" alt="Mission"/>
                                        </t>
                                    </a>

                                    <div class="rv-portal-mission-body">
                                        <div class="rv-portal-mission-head">
                                            <div>
                                                <h3><t t-esc="m.name or 'Mission'"/></h3>
                                                <p>
                                                    <t t-esc="m.hospital_id.name if m.hospital_id else 'Etablissement partenaire'"/>
                                                    <t t-if="m.start_date or m.end_date">
                                                        <span class="rv-portal-separator">|</span>
                                                        <t t-if="m.start_date"><t t-esc="m.start_date"/></t>
                                                        <t t-if="m.end_date"><t t-esc="' -> %s' % m.end_date"/></t>
                                                    </t>
                                                </p>
                                            </div>
                                            <span class="rv-portal-status-chip is-published">Publiee</span>
                                        </div>

                                        <div class="rv-portal-tag-row">
                                            <t t-foreach="m.speciality_ids[:3]" t-as="sp">
                                                <span class="rv-portal-tag-chip"><t t-esc="sp.name"/></span>
                                            </t>
                                            <t t-foreach="m.brand_ids[:2]" t-as="br">
                                                <span class="rv-portal-tag-chip is-muted"><t t-esc="br.name"/></span>
                                            </t>
                                            <t t-if="len(m.speciality_ids) &gt; 3">
                                                <span class="rv-portal-tag-chip is-muted">+<t t-esc="len(m.speciality_ids) - 3"/></span>
                                            </t>
                                            <t t-if="len(m.brand_ids) &gt; 2">
                                                <span class="rv-portal-tag-chip is-muted">+<t t-esc="len(m.brand_ids) - 2"/></span>
                                            </t>
                                        </div>

                                        <div class="rv-portal-mission-meta">
                                            <div class="rv-portal-applicant-strip">
                                                <div class="rv-portal-avatar-stack">
                                                    <t t-set="apps" t-value="m.application_ids"/>
                                                    <t t-foreach="apps[:3]" t-as="app">
                                                        <t t-set="r" t-value="app.radiologist_id"/>
                                                        <span class="rv-portal-avatar-stack-item" t-att-title="r.display_name">
                                                            <t t-if="r.image_1920">
                                                                <img t-att-src="'/web/image/radiology.radiologist/%s/image_1920' % r.id" alt="Radiologue"/>
                                                            </t>
                                                            <t t-else="">
                                                                <img src="/web/static/img/user_menu_avatar.png" alt="Radiologue"/>
                                                            </t>
                                                        </span>
                                                    </t>
                                                </div>
                                                <span class="rv-portal-applicant-count">
                                                    <t t-if="len(m.application_ids)">
                                                        <t t-esc="len(m.application_ids)"/> candidat<t t-if="len(m.application_ids) &gt; 1">s</t>
                                                    </t>
                                                    <t t-else="">Aucun candidat</t>
                                                </span>
                                            </div>

                                            <div class="rv-portal-mission-price">
                                                <strong><t t-esc="m.tarif or '-'"/> EUR</strong>
                                                <small>
                                                    <t t-if="m.tarif_type == 'hour'">/ heure</t>
                                                    <t t-elif="m.tarif_type == 'day'">/ jour</t>
                                                    <t t-else="">/ mission</t>
                                                </small>
                                            </div>
                                        </div>

                                        <div class="rv-portal-mission-actions">
                                            <a class="rv-portal-btn rv-portal-btn-secondary"
                                               t-att-href="'/my/missions/%s' % m.id">Voir l'offre</a>
                                        </div>
                                    </div>
                                </article>
                            </t>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="rv-portal-empty-state">
                            <strong>Aucune mission ne correspond a vos filtres.</strong>
                            <p>Reinitialisez la recherche ou publiez une nouvelle mission pour relancer le matching.</p>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
