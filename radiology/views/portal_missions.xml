                    </div><!-- /ab-inner -->
                </div><!-- /ab-shell -->
            </section>
            <t t-if="recommended_radiologists">
                <script type="text/javascript">
                    <![CDATA[
    (function () {
      function fillStars() {
        var blocks = document.querySelectorAll('#ab-recbar .ab-stars');
        blocks.forEach(function (el) {
          var r = parseFloat(el.getAttribute('data-rating') || '0');
          if (isNaN(r)) r = 0;
          var full = Math.floor(r); // 0..5
          var stars = el.querySelectorAll('.ab-star');
          stars.forEach(function (s, idx) {
            s.style.opacity = (idx < full) ? '1' : '.25';
          });
        });
      }

      function bindClose() {
        var bar = document.getElementById('ab-recbar');
        if (!bar) return;
        var btn = bar.querySelector('.ab-recbar-close');
        if (!btn) return;

        btn.addEventListener('click', function () {
          bar.classList.add('ab-closed');
        });
      }

      function showRecBar() {
        var el = document.getElementById('ab-recbar');
        if (!el) return;

        setTimeout(function () {
          el.classList.add('ab-show');
          fillStars();
          bindClose();
        }, 2000);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', showRecBar);
      } else {
        showRecBar();
      }
    })();
    ]]>
                </script>
            </t>

        </t>
    </template>
</odoo>
