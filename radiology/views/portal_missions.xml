<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="portal_all_missions" name="Portal - All Missions (Premium)">

    <t t-set="rl_fullwidth" t-value="True"/>
    <t t-set="breadcrumbs" t-value="False"/>

    <t t-call="portal.portal_layout">
      <t t-set="breadcrumbs_searchbar" t-value="True"/>

      <style>
        :root{
          --rlx-text:#0B1220;
          --rlx-muted:#64748B;
          --rlx-border: rgba(15,23,42,.10);
          --rlx-card: rgba(255,255,255,.80);
          --rlx-shadow: 0 18px 60px rgba(2,6,23,.10);
          --rlx-shadow2: 0 10px 26px rgba(2,6,23,.08);
          --rlx-primary1:#4F46E5;
          --rlx-primary2:#2563EB;
          --rlx-accent:#10B981;
          --rlx-radius: 22px;
        }

        /* Full width portal */
        .o_portal_wrap > .container{ max-width:100% !important; padding-left:0 !important; padding-right:0 !important; }
        .o_portal_wrap > .container.pt-3{ padding-top:0 !important; }

        .rlx-page{
          min-height:100vh;
          background:
            radial-gradient(1200px 520px at 10% 0%, rgba(79,70,229,.12), transparent 55%),
            radial-gradient(900px 450px at 90% 10%, rgba(16,185,129,.10), transparent 55%),
            linear-gradient(180deg, #ECF4FF 0%, #F8FAFC 42%, #FFFFFF 100%);
        }

        .rlx-shell{ padding: 22px 18px 46px; }
        @media(min-width:992px){ .rlx-shell{ padding: 34px 34px 64px; } }

        /* Header / hero */
        .rlx-hero{
          border-radius: var(--rlx-radius);
          border: 1px solid var(--rlx-border);
          background: var(--rlx-card);
          backdrop-filter: blur(12px);
          -webkit-backdrop-filter: blur(12px);
          box-shadow: var(--rlx-shadow);
          overflow:hidden;
          position:relative;
        }
        .rlx-hero:before{
          content:"";
          position:absolute; inset:-2px;
          background:
            radial-gradient(720px 260px at 18% 0%, rgba(79,70,229,.18), transparent 60%),
            radial-gradient(720px 260px at 85% 0%, rgba(37,99,235,.14), transparent 60%);
          pointer-events:none;
        }
        .rlx-hero > *{ position:relative; }

        .rlx-hero-in{ padding: 18px; }
        @media(min-width:992px){ .rlx-hero-in{ padding: 26px; } }

        .rlx-title{
          margin:0;
          font-weight: 1000;
          letter-spacing:-.03em;
          color: var(--rlx-text);
          font-size: 34px;
          line-height: 1.08;
        }
        @media(max-width:576px){ .rlx-title{ font-size: 28px; } }

        .rlx-sub{
          margin-top: 10px;
          color: var(--rlx-muted);
          font-weight: 650;
          font-size: 14px;
          line-height: 1.55;
          max-width: 780px;
        }

        .rlx-actions-top{
          margin-top: 14px;
          display:flex;
          flex-wrap:wrap;
          gap: 10px;
          align-items:center;
          justify-content: space-between;
        }

        .rlx-btn{
          border-radius: 14px !important;
          padding: 10px 14px !important;
          font-weight: 950 !important;
        }
        .rlx-primary{
          background: linear-gradient(135deg, var(--rlx-primary1), var(--rlx-primary2)) !important;
          border: none !important;
          color:#fff !important;
          box-shadow: 0 16px 34px rgba(37,99,235,.22);
        }
        .rlx-ghost{
          background: rgba(79,70,229,.06) !important;
          border: 1px solid rgba(79,70,229,.20) !important;
          color:#3730A3 !important;
        }

        /* Filters */
        .rlx-filters{
          margin-top: 14px;
          border-radius: var(--rlx-radius);
          border: 1px solid rgba(2,6,23,.10);
          background: rgba(255,255,255,.78);
          backdrop-filter: blur(10px);
          -webkit-backdrop-filter: blur(10px);
          box-shadow: var(--rlx-shadow2);
          padding: 12px;
          position: sticky;
          top: 10px;
          z-index: 5;
        }
        .rlx-filters .form-label{
          font-weight: 900;
          color:#334155;
          font-size: 13px;
        }
        .rlx-filters .form-control,
        .rlx-filters .form-select{
          border-radius: 14px;
          border: 1px solid rgba(2,6,23,.10);
        }

        /* Grid */
        .rlx-grid{
          margin-top: 16px;
          display:grid;
          grid-template-columns: repeat(3, minmax(0,1fr));
          gap: 14px;
        }
        @media(max-width: 1100px){ .rlx-grid{ grid-template-columns: repeat(2, minmax(0,1fr)); } }
        @media(max-width: 768px){ .rlx-grid{ grid-template-columns: 1fr; } }

        /* Mission card */
        .rlx-card{
          border-radius: var(--rlx-radius);
          overflow:hidden;
          border: 1px solid rgba(2,6,23,.10);
          background: rgba(255,255,255,.82);
          box-shadow: var(--rlx-shadow2);
          transition: transform .18s ease, box-shadow .18s ease;
        }
        .rlx-card:hover{
          transform: translateY(-2px);
          box-shadow: 0 22px 60px rgba(2,6,23,.14);
        }

        .rlx-topline{
          height: 3px;
          background: linear-gradient(90deg, rgba(79,70,229,.95), rgba(37,99,235,.95));
        }

        .rlx-card-body{ padding: 14px; }

        .rlx-head{
          display:flex;
          gap: 12px;
          align-items:flex-start;
        }
        .rlx-hosp{
          width: 58px; height: 58px;
          border-radius: 16px;
          overflow:hidden;
          background: linear-gradient(180deg,#EAF2FB 0%,#DDEBFA 100%);
          border: 1px solid rgba(2,6,23,.10);
          box-shadow: 0 10px 20px rgba(2,6,23,.08);
          flex: 0 0 auto;
        }
        .rlx-hosp img{ width:100%; height:100%; object-fit:cover; display:block; }

        .rlx-name{
          margin:0;
          color: var(--rlx-text);
          font-weight: 1000;
          letter-spacing:-.02em;
          font-size: 16px;
          line-height: 1.25;
        }
        .rlx-hospital{
          margin-top: 4px;
          color:#334155;
          font-weight: 800;
          font-size: 13px;
        }

        .rlx-row{
          margin-top: 8px;
          display:flex;
          flex-wrap:wrap;
          gap: 8px;
          align-items:center;
        }

        .rlx-pill{
          display:inline-flex;
          align-items:center;
          padding: 6px 10px;
          border-radius: 999px;
          border: 1px solid rgba(2,6,23,.08);
          background: rgba(248,250,252,.90);
          font-weight: 900;
          font-size: 12px;
          color:#0F172A;
          white-space: nowrap;
        }
        .rlx-pill-price{
          border-color: rgba(16,185,129,.25);
          background: rgba(220,252,231,.70);
          color:#065F46;
        }

        .rlx-chips{
          margin-top: 10px;
          display:flex;
          flex-wrap:wrap;
          gap: 8px;
        }
        .rlx-chip{
          display:inline-flex;
          align-items:center;
          padding: 6px 10px;
          border-radius: 999px;
          font-weight: 800;
          font-size: 12px;
          border: 1px solid;
          background: rgba(255,255,255,.75);
          white-space: nowrap;
        }
        .rlx-chip-sp{ border-color:#A5F3FC; color:#155E75; background: rgba(236,254,255,.78); }
        .rlx-chip-br{ border-color:#E2E8F0; color:#334155; background: rgba(248,250,252,.85); }

        .rlx-desc{
          margin-top: 10px;
          color:#475569;
          font-size: 13px;
          font-weight: 650;
          line-height: 1.55;
          display:-webkit-box;
          -webkit-line-clamp: 3;
          -webkit-box-orient: vertical;
          overflow:hidden;
        }

        .rlx-footer{
          margin-top: 12px;
          display:flex;
          align-items:center;
          justify-content:flex-end;
        }

        .rlx-link{
          border-radius: 14px;
          padding: 10px 12px;
          font-weight: 950;
          font-size: 13px;
          text-decoration:none;
          display:inline-flex;
          align-items:center;
          justify-content:center;
          border: 1px solid rgba(59,130,246,.25);
          background: rgba(255,255,255,.86);
          color:#1D4ED8;
          transition: transform .12s ease, background .12s ease;
        }
        .rlx-link:hover{
          transform: translateY(-1px);
          background: rgba(239,246,255,.95);
        }

        /* Small helper */
        .rlx-muted{ color: var(--rlx-muted); font-weight: 650; }
      </style>

      <section class="rlx-page">
        <div class="container-fluid rlx-shell">

          <!-- HERO -->
          <div class="rlx-hero">
            <div class="rlx-hero-in">
              <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                <div>
                  <h2 class="rlx-title">Missions</h2>
                  <div class="rlx-sub">
                    Consultez les missions publiées et filtrez par spécialité, marque et période.
                  </div>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                  <a href="/my/missions/new" class="btn rlx-btn rlx-primary">Publier une mission</a>
                  <a href="/my" class="btn rlx-btn rlx-ghost">Mon portail</a>
                </div>
              </div>
            </div>
          </div>

          <!-- FILTERS -->
          <form class="rlx-filters mt-3" method="get" action="/my/missions">
            <div class="row g-3 align-items-end">
              <div class="col-md-3">
                <label class="form-label">Spécialité</label>
                <t t-set="selected_specialty" t-value="request.params.get('specialty_id') or ''"/>
                <select class="form-select" name="specialty_id">
                  <option value="">Toutes</option>
                  <t t-foreach="specialties" t-as="s">
                    <option t-att-value="s.id"
                            t-att-selected="1 if str(s.id) == str(selected_specialty) else None">
                      <t t-esc="s.name"/>
                    </option>
                  </t>
                </select>
              </div>

              <div class="col-md-3">
                <label class="form-label">Marque</label>
                <t t-set="selected_brand" t-value="request.params.get('brand_id') or ''"/>
                <select class="form-select" name="brand_id">
                  <option value="">Toutes</option>
                  <t t-foreach="brands" t-as="b">
                    <option t-att-value="b.id"
                            t-att-selected="1 if str(b.id) == str(selected_brand) else None">
                      <t t-esc="b.name"/>
                    </option>
                  </t>
                </select>
              </div>

              <div class="col-md-2">
                <label class="form-label">Du</label>
                <input type="date" class="form-control" name="date_from"
                       t-att-value="request.params.get('date_from') or ''"/>
              </div>

              <div class="col-md-2">
                <label class="form-label">Au</label>
                <input type="date" class="form-control" name="date_to"
                       t-att-value="request.params.get('date_to') or ''"/>
              </div>

              <div class="col-md-2 d-grid gap-2">
                <button class="btn rlx-btn rlx-primary" type="submit">Filtrer</button>
                <a class="btn rlx-btn rlx-ghost" href="/my/missions">Réinitialiser</a>
              </div>
            </div>
          </form>

          <!-- LIST -->
          <t t-if="missions">
            <div class="rlx-grid">

              <t t-foreach="missions" t-as="m">
                <div class="rlx-card">
                  <div class="rlx-topline"></div>

                  <div class="rlx-card-body">
                    <div class="rlx-head">

                      <div class="rlx-hosp">
                        <t t-if="m.hospital_id and m.hospital_id.image_1920">
                          <img t-att-src="'/web/image/radiology.hospital/%s/image_1920' % m.hospital_id.id" alt="Hôpital"/>
                        </t>
                        <t t-else="">
                          <div class="w-100 h-100 d-flex align-items-center justify-content-center"
                               style="font-weight:1000;color:#2563EB;">RL</div>
                        </t>
                      </div>

                      <div class="min-w-0" style="flex:1;">
                        <h5 class="rlx-name"><t t-esc="m.name or 'Mission'"/></h5>

                        <div class="rlx-hospital">
                          <t t-if="m.hospital_id"><t t-esc="m.hospital_id.name"/></t>
                        </div>

                        <div class="rlx-row">
                          <span class="rlx-pill rlx-pill-price">
                            <t t-esc="m.tarif or '—'"/> €
                          </span>

                          <t t-if="m.start_date">
                            <span class="rlx-pill"><t t-esc="m.start_date"/></span>
                          </t>
                          <t t-if="m.end_date">
                            <span class="rlx-pill"><t t-esc="m.end_date"/></span>
                          </t>
                        </div>

                        <div class="rlx-chips">
                          <t t-foreach="m.speciality_ids[:4]" t-as="sp">
                            <span class="rlx-chip rlx-chip-sp"><t t-esc="sp.name"/></span>
                          </t>
                          <t t-foreach="m.brand_ids[:3]" t-as="br">
                            <span class="rlx-chip rlx-chip-br"><t t-esc="br.name"/></span>
                          </t>
                        </div>

                        <t t-if="m.description">
                          <div class="rlx-desc"><t t-esc="m.description"/></div>
                        </t>

                        <div class="rlx-footer">
                          <a class="rlx-link" t-att-href="'/my/missions/%s' % m.id">Détails</a>
                        </div>

                      </div>

                    </div>
                  </div>
                </div>
              </t>

            </div>
          </t>

          <t t-else="">
            <div class="mt-4 alert alert-info border-0 shadow-sm"
                 style="border-radius:18px; background: rgba(255,255,255,.72);">
              Aucune mission publiée ne correspond à vos filtres.
            </div>
          </t>

          <!-- ✅ Ton popup recommandation (inchangé) -->
          <!-- Mets ici ton t-if show_recommend_modal ... -->

        </div>
      </section>

      <!-- ========================= -->
      <!--   POPUP RECOMMANDATIONS   -->
      <!-- ========================= -->
      <t t-if="show_recommend_modal and recommended_radiologists">

        <style>
          .rlx-backdrop{
            position: fixed; inset: 0;
            background: rgba(2,6,23,.60);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            z-index: 1050;
            display:flex; align-items:center; justify-content:center;
            padding: 18px;
          }

          .rlx-modal{
            width: min(1050px, 100%);
            border-radius: 26px;
            overflow: hidden;
            box-shadow: 0 40px 120px rgba(0,0,0,.40);
            background: rgba(255,255,255,.86);
            border: 1px solid rgba(255,255,255,.45);
          }

          .rlx-header{
            padding: 16px 18px;
            display:flex;
            align-items:flex-start;
            justify-content:space-between;
            gap: 14px;
            border-bottom: 1px solid rgba(2,6,23,.08);
            background: rgba(255,255,255,.70);
          }

          .rlx-mtitle{
            margin:0;
            font-weight: 1000;
            color:#0B1220;
            font-size: 16px;
            letter-spacing: -0.02em;
          }

          .rlx-msub{
            margin-top: 6px;
            color:#475569;
            font-size: 13px;
            font-weight: 650;
            line-height: 1.45;
          }

          .rlx-close{
            border: 1px solid rgba(2,6,23,.08);
            background: rgba(248,250,252,.95);
            width: 40px; height: 40px;
            border-radius: 14px;
            display:flex; align-items:center; justify-content:center;
            cursor:pointer;
            font-weight: 1000;
            color:#0B1220;
          }

          .rlx-body{ padding: 18px; }

          .rlx-rgrid{
            display:grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
          }
          @media (max-width: 768px){
            .rlx-rgrid{ grid-template-columns: 1fr; }
          }

          .rlx-rcard{
            border-radius: 20px;
            background: rgba(255,255,255,.92);
            border: 1px solid rgba(2,6,23,.08);
            box-shadow: 0 16px 40px rgba(2,6,23,.10);
            overflow:hidden;
          }

          .rlx-rcard-top{
            height: 3px;
            background: linear-gradient(90deg, rgba(79,70,229,.95), rgba(37,99,235,.95));
          }

          .rlx-rcard-body{
            padding: 14px;
            display:flex;
            gap: 12px;
            align-items:flex-start;
          }

          .rlx-ravatar{
            width: 60px; height: 60px;
            border-radius: 18px;
            overflow:hidden;
            background: #EAF2FB;
            border: 1px solid rgba(2,6,23,.10);
            flex: 0 0 auto;
          }
          .rlx-ravatar img{ width:100%; height:100%; object-fit:cover; display:block; }

          .rlx-rname{
            margin: 0;
            font-weight: 1000;
            color:#0F172A;
            font-size: 15px;
            line-height: 1.2;
          }

          .rlx-rmeta{
            margin-top: 6px;
            display:flex;
            flex-wrap:wrap;
            gap: 8px;
            align-items:center;
          }

          .rlx-pill2{
            display:inline-flex;
            align-items:center;
            padding: 6px 10px;
            border-radius: 999px;
            border: 1px solid rgba(2,6,23,.08);
            background: rgba(248,250,252,.92);
            font-weight: 900;
            font-size: 12px;
            color:#0F172A;
            white-space: nowrap;
          }

          .rlx-chip2{
            display:inline-flex;
            align-items:center;
            padding: 6px 10px;
            border-radius: 999px;
            font-weight: 800;
            font-size: 12px;
            border: 1px solid;
            background: rgba(255,255,255,.80);
            white-space: nowrap;
          }
          .rlx-chip2-sp{ border-color:#A5F3FC; color:#155E75; background: rgba(236,254,255,.78); }
          .rlx-chip2-br{ border-color:#E2E8F0; color:#334155; background: rgba(248,250,252,.85); }
          .rlx-chip2-more{ border-color:#E2E8F0; color:#0F172A; background: rgba(241,245,249,.92); }

          .rlx-ractions{
            margin-top: 10px;
            display:flex;
            gap: 10px;
          }
          .rlx-alink{
            width: 100%;
            border-radius: 14px;
            padding: 10px 12px;
            font-weight: 950;
            font-size: 13px;
            text-decoration:none;
            display:inline-flex;
            align-items:center;
            justify-content:center;
            border: 1px solid rgba(59,130,246,.25);
            background: rgba(255,255,255,.86);
            color:#1D4ED8;
          }
          .rlx-alink-primary{
            border: none;
            color:#fff;
            background: linear-gradient(135deg, rgba(79,70,229,1), rgba(37,99,235,1));
            box-shadow: 0 16px 30px rgba(37,99,235,.22);
          }
        </style>

        <div class="rlx-backdrop" id="recommendModal">
          <div class="rlx-modal" role="dialog" aria-modal="true">
            <div class="rlx-header">
              <div>
                <h5 class="rlx-mtitle">Radiologues recommandés</h5>
                <div class="rlx-msub">
                  Recommandation basée sur spécialités, marques, expérience et évaluations.
                </div>
              </div>
              <button class="rlx-close" type="button" onclick="closeRecommendModal()" aria-label="Close">×</button>
            </div>

            <div class="rlx-body">
              <div class="rlx-rgrid">

                <t t-foreach="recommended_radiologists" t-as="r">
                  <div class="rlx-rcard">
                    <div class="rlx-rcard-top"></div>

                    <div class="rlx-rcard-body">

                      <div class="rlx-ravatar">
                        <t t-if="r.image_1920">
                          <img t-att-src="'/web/image/radiology.radiologist/%s/image_1920' % r.id" alt="Photo"/>
                        </t>
                        <t t-else="">
                          <img t-att-src="'/web/static/img/user_menu_avatar.png'" alt="Avatar"/>
                        </t>
                      </div>

                      <div class="min-w-0" style="flex:1;">
                        <p class="rlx-rname"><t t-esc="r.display_name or 'Radiologue'"/></p>

                        <div class="rlx-rmeta">
                          <span class="rlx-pill2"><t t-esc="('%.1f' % (r.rating_avg or 0.0))"/> / 5</span>
                          <span class="rlx-pill2"><t t-esc="r.experience_years or 0"/> ans</span>
                        </div>

                        <!-- Spécialités -->
                        <t t-if="r.specialty_ids">
                          <div class="rlx-rmeta" style="margin-top:8px;">
                            <t t-foreach="r.specialty_ids[:3]" t-as="sp">
                              <span class="rlx-chip2 rlx-chip2-sp"><t t-esc="sp.name"/></span>
                            </t>
                            <t t-if="len(r.specialty_ids) &gt; 3">
                              <span class="rlx-chip2 rlx-chip2-more">+<t t-esc="len(r.specialty_ids) - 3"/></span>
                            </t>
                          </div>
                        </t>

                        <!-- Marques -->
                        <t t-if="r.brand_ids">
                          <div class="rlx-rmeta" style="margin-top:8px;">
                            <t t-foreach="r.brand_ids[:2]" t-as="br">
                              <span class="rlx-chip2 rlx-chip2-br"><t t-esc="br.name"/></span>
                            </t>
                            <t t-if="len(r.brand_ids) &gt; 2">
                              <span class="rlx-chip2 rlx-chip2-more">+<t t-esc="len(r.brand_ids) - 2"/></span>
                            </t>
                          </div>
                        </t>

                        <div class="rlx-ractions">
                          <a t-att-href="'/my/radiologists/%s' % r.id" class="rlx-alink">Voir profil</a>
                          <a t-att-href="'/my/chat/start?radiologist_id=%s' % r.id"
                             class="rlx-alink rlx-alink-primary">Contacter</a>
                        </div>

                      </div>

                    </div>
                  </div>
                </t>

              </div>
            </div>
          </div>
        </div>

        <script type="text/javascript">
          function closeRecommendModal() {
            const modal = document.getElementById('recommendModal');
            if (modal) modal.remove();

            const url = new URL(window.location);
            url.searchParams.delete('recommend');
            url.searchParams.delete('mission_id');
            window.history.replaceState({}, document.title, url);
          }

          document.addEventListener('click', function(e){
            const modal = document.getElementById('recommendModal');
            if (!modal) return;
            if (e.target === modal) closeRecommendModal();
          });

          document.addEventListener('keydown', function(e){
            if (e.key === 'Escape') closeRecommendModal();
          });
        </script>

      </t>

    </t>
  </template>
</odoo>
