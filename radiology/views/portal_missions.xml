<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="portal_all_missions" name="Portal - All Missions (Airbnb Theme)">

    <t t-set="rl_fullwidth" t-value="True"/>
    <t t-set="breadcrumbs" t-value="False"/>

    <t t-call="portal.portal_layout">
      <t t-set="breadcrumbs_searchbar" t-value="True"/>

      <!-- ========================= -->
      <!--          STYLES            -->
      <!-- ========================= -->
      <style>
        :root{
          --ab-text:#0f172a;
          --ab-muted:#64748b;
          --ab-border: rgba(15,23,42,.10);
          --ab-chip:#f8fafc;
          --ab-chip-border: rgba(15,23,42,.12);
          --ab-shadow: 0 10px 30px rgba(2,6,23,.08);
          --ab-shadow2: 0 14px 46px rgba(2,6,23,.10);
          --ab-radius2: 22px;
          --ab-primary:#2563eb;
        }

        /* Full width portal (page only) */
        .o_portal_wrap > .container{
          max-width:100% !important;
          padding-left:0 !important;
          padding-right:0 !important;
        }
        .o_portal_wrap > .container.pt-3{ padding-top:0 !important; }

        /* Page */
        .ab-page{ min-height:100vh; background:#fff; }
        .ab-shell{ padding: 18px 0 56px; }
        @media(min-width:768px){ .ab-shell{ padding: 22px 0 64px; } }
        @media(min-width:1200px){ .ab-shell{ padding: 26px 0 70px; } }

        /* Inner container (fix edges) */
        .ab-inner{
          max-width: 1320px;
          margin: 0 auto;
          padding-left: 18px;
          padding-right: 18px;
        }
        @media(min-width:768px){ .ab-inner{ padding-left: 28px; padding-right: 28px; } }
        @media(min-width:1200px){ .ab-inner{ padding-left: 40px; padding-right: 40px; } }

        /* Header card */
        .ab-hero{
          border-radius: var(--ab-radius2);
          border: 1px solid var(--ab-border);
          background: rgba(255,255,255,.92);
          box-shadow: var(--ab-shadow);
          padding: 14px;
        }
        @media(min-width:768px){ .ab-hero{ padding: 16px; } }

        .ab-top{
          display:flex;
          justify-content:space-between;
          align-items:flex-start;
          gap: 14px;
        }
        .ab-title{
          margin:0;
          color: var(--ab-text);
          font-weight: 950;
          letter-spacing: -.02em;
          font-size: 26px;
          line-height: 1.1;
        }
        .ab-sub{
          margin-top: 6px;
          color: var(--ab-muted);
          font-weight: 650;
          font-size: 13px;
        }
        .ab-actions{
          display:flex;
          flex-wrap:wrap;
          gap:10px;
          align-items:center;
          justify-content:flex-end;
        }

        /* Buttons (same style as "Voir l’offre") */
        .ab-cta-btn{
          border-radius: 12px !important;
          padding: 10px 12px !important;
          font-weight: 950 !important;
          font-size: 13px !important;
          text-decoration:none !important;
          border: 1px solid rgba(37,99,235,.22) !important;
          background: rgba(239,246,255,.95) !important;
          color: #1d4ed8 !important;
          display:inline-flex !important;
          align-items:center !important;
          justify-content:center !important;
          gap: 8px !important;
          cursor:pointer;
        }
        .ab-cta-btn:hover{
          background: rgba(219,234,254,.95) !important;
          color:#1d4ed8 !important;
          text-decoration:none !important;
        }
        .ab-cta-btn-primary{
          background: var(--ab-primary) !important;
          border-color: var(--ab-primary) !important;
          color:#fff !important;
          box-shadow: 0 12px 26px rgba(37,99,235,.18);
        }
        .ab-cta-btn-primary:hover{
          background:#1d4ed8 !important;
          border-color:#1d4ed8 !important;
          color:#fff !important;
        }

        /* Filters bar */
        .ab-filters{
          margin-top: 14px;
          position: sticky;
          top: 10px;
          z-index: 10;
          background: rgba(255,255,255,.85);
          backdrop-filter: blur(10px);
          -webkit-backdrop-filter: blur(10px);
          border: 1px solid var(--ab-border);
          border-radius: var(--ab-radius2);
          box-shadow: var(--ab-shadow);
          padding: 10px;
        }
        .ab-filters-row{
          display:flex;
          align-items:center;
          gap: 10px;
          flex-wrap:wrap;
        }
        .ab-chip{
          display:inline-flex;
          align-items:center;
          gap:8px;
          padding: 10px 12px;
          border-radius: 999px;
          border: 1px solid var(--ab-chip-border);
          background: var(--ab-chip);
          color: var(--ab-text);
          font-weight: 850;
          font-size: 13px;
          white-space: nowrap;
        }
        .ab-chip select,
        .ab-chip input{
          border:none !important;
          background: transparent !important;
          outline:none !important;
          padding:0 !important;
          height:auto !important;
          font-weight: 850;
          font-size: 13px;
          color: var(--ab-text);
          min-width: 140px;
        }
        .ab-chip input[type="date"]{ min-width: 150px; }
        .ab-chip select:focus,
        .ab-chip input:focus{ box-shadow:none !important; }

        .ab-chip-actions{
          margin-left:auto;
          display:flex;
          gap:10px;
          flex-wrap:wrap;
        }

        /* Grid */
        .ab-grid{
          margin-top: 16px;
          display:grid;
          grid-template-columns: repeat(4, minmax(0,1fr));
          gap: 16px;
        }
        @media(max-width: 1250px){ .ab-grid{ grid-template-columns: repeat(3, minmax(0,1fr)); } }
        @media(max-width: 980px){ .ab-grid{ grid-template-columns: repeat(2, minmax(0,1fr)); } }
        @media(max-width: 640px){ .ab-grid{ grid-template-columns: 1fr; } }

        /* Card */
        .ab-card{
          border-radius: var(--ab-radius2);
          overflow:hidden;
          border: 1px solid var(--ab-border);
          background: #fff;
          box-shadow: var(--ab-shadow);
          transition: transform .16s ease, box-shadow .16s ease;
        }
        .ab-card:hover{
          transform: translateY(-2px);
          box-shadow: var(--ab-shadow2);
        }

        .ab-media{
          position:relative;
          width:100%;
          aspect-ratio: 4/3;
          background: #e5e7eb;
          overflow:hidden;
        }
        .ab-media img{
          width:100%;
          height:100%;
          object-fit:cover;
          display:block;
        }

        .ab-body{ padding: 12px 12px 14px; }
        .ab-name{
          margin:0;
          font-weight: 950;
          color: var(--ab-text);
          font-size: 15px;
          line-height: 1.25;
        }
        .ab-meta{
          margin-top: 4px;
          color: var(--ab-muted);
          font-weight: 750;
          font-size: 12.5px;
        }

        .ab-tags{
          margin-top: 8px;
          display:flex;
          flex-wrap:wrap;
          gap: 6px;
        }
        .ab-tag{
          display:inline-flex;
          align-items:center;
          padding: 6px 10px;
          border-radius: 999px;
          border: 1px solid rgba(15,23,42,.10);
          background: rgba(248,250,252,.90);
          color: var(--ab-text);
          font-weight: 850;
          font-size: 12px;
          white-space:nowrap;
        }

        .ab-bottom{
          margin-top: 10px;
          display:flex;
          align-items:center;
          justify-content:space-between;
          gap: 10px;
        }
        .ab-price{
          font-weight: 950;
          color: var(--ab-text);
          font-size: 14px;
          white-space:nowrap;
        }
        .ab-price span{
          color: var(--ab-muted);
          font-weight: 750;
          font-size: 12px;
          margin-left: 4px;
        }

        /* Heart (optional) */
        .ab-heart{
          position:absolute;
          top: 10px;
          right: 10px;
          width: 38px;
          height: 38px;
          border-radius: 999px;
          background: rgba(255,255,255,.92);
          border: 1px solid rgba(15,23,42,.10);
          display:flex;
          align-items:center;
          justify-content:center;
          box-shadow: 0 10px 22px rgba(2,6,23,.10);
          cursor:pointer;
          user-select:none;
        }

        /* ========================= */
        /*        MODAL POPUP        */
        /* ========================= */
        .ab-backdrop{
          position: fixed; inset: 0;
          background: rgba(2,6,23,.55);
          backdrop-filter: blur(10px);
          -webkit-backdrop-filter: blur(10px);
          z-index: 1050;
          display:flex;
          align-items:center;
          justify-content:center;
          padding: 18px;
        }
        .ab-modal{
          width: min(1080px, 100%);
          border-radius: 22px;
          overflow:hidden;
          background: rgba(255,255,255,.92);
          border: 1px solid rgba(15,23,42,.10);
          box-shadow: 0 40px 120px rgba(0,0,0,.35);
        }
        .ab-modal-head{
          padding: 14px 16px;
          display:flex;
          align-items:flex-start;
          justify-content:space-between;
          gap: 12px;
          border-bottom: 1px solid rgba(15,23,42,.10);
          background: rgba(255,255,255,.85);
        }
        .ab-modal-title{
          margin:0;
          font-weight: 950;
          color: var(--ab-text);
          font-size: 16px;
          letter-spacing: -.01em;
        }
        .ab-modal-sub{
          margin-top: 6px;
          color: var(--ab-muted);
          font-weight: 700;
          font-size: 13px;
          line-height: 1.45;
        }
        .ab-close{
          border: 1px solid rgba(15,23,42,.12);
          background: rgba(248,250,252,.95);
          width: 40px; height: 40px;
          border-radius: 999px;
          display:flex;
          align-items:center;
          justify-content:center;
          cursor:pointer;
          font-weight: 950;
          color: var(--ab-text);
          line-height: 1;
        }
        .ab-modal-body{ padding: 16px; }
        .ab-rgrid{
          display:grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 14px;
        }
        @media (max-width: 900px){ .ab-rgrid{ grid-template-columns: 1fr; } }
        .ab-rcard{
          border-radius: 22px;
          overflow:hidden;
          border: 1px solid rgba(15,23,42,.10);
          background: #fff;
          box-shadow: var(--ab-shadow);
          transition: transform .16s ease, box-shadow .16s ease;
        }
        .ab-rcard:hover{
          transform: translateY(-2px);
          box-shadow: var(--ab-shadow2);
        }
        .ab-rcard-in{
          padding: 12px;
          display:flex;
          gap: 12px;
          align-items:flex-start;
        }
        .ab-ravatar{
          width: 70px; height: 70px;
          border-radius: 18px;
          overflow:hidden;
          background: #eef2ff;
          border: 1px solid rgba(15,23,42,.10);
          flex: 0 0 auto;
        }
        .ab-ravatar img{ width:100%; height:100%; object-fit:cover; display:block; }
        .ab-rname{
          margin: 0;
          font-weight: 950;
          color: var(--ab-text);
          font-size: 15px;
          line-height: 1.25;
        }
        .ab-rmeta{
          margin-top: 6px;
          display:flex;
          flex-wrap:wrap;
          gap: 8px;
          align-items:center;
        }
        .ab-pill{
          display:inline-flex;
          align-items:center;
          padding: 6px 10px;
          border-radius: 999px;
          border: 1px solid rgba(15,23,42,.10);
          background: rgba(248,250,252,.95);
          font-weight: 850;
          font-size: 12px;
          color: var(--ab-text);
          white-space: nowrap;
        }
        .ab-actions2{
          margin-top: 10px;
          display:flex;
          gap: 10px;
          flex-wrap:wrap;
        }
        .ab-actions2 a{ flex:1; }
      </style>

      <section class="ab-page">
        <div class="container-fluid ab-shell">
          <div class="ab-inner">

            <!-- HEADER CARD -->
            <div class="ab-hero">
              <div class="ab-top">
                <div>
                  <h2 class="ab-title">Missions</h2>
                  <div class="ab-sub">
                    Parcourez les missions comme une liste de “séjours” : filtres en chips + cartes premium.
                  </div>
                </div>

                <div class="ab-actions">
                  <a href="/my/missions/new" class="ab-cta-btn">Publier une mission</a>
                  <a href="/my" class="ab-cta-btn">Mon portail</a>
                </div>
              </div>
            </div>

            <!-- FILTERS -->
            <form class="ab-filters" method="get" action="/my/missions">
              <t t-set="selected_specialty" t-value="request.params.get('specialty_id') or ''"/>
              <t t-set="selected_brand" t-value="request.params.get('brand_id') or ''"/>

              <div class="ab-filters-row">
                <div class="ab-chip">
                  <span>Spécialité</span>
                  <select name="specialty_id">
                    <option value="">Toutes</option>
                    <t t-foreach="specialties" t-as="s">
                      <option t-att-value="s.id"
                              t-att-selected="1 if str(s.id) == str(selected_specialty) else None">
                        <t t-esc="s.name"/>
                      </option>
                    </t>
                  </select>
                </div>

                <div class="ab-chip">
                  <span>Marque</span>
                  <select name="brand_id">
                    <option value="">Toutes</option>
                    <t t-foreach="brands" t-as="b">
                      <option t-att-value="b.id"
                              t-att-selected="1 if str(b.id) == str(selected_brand) else None">
                        <t t-esc="b.name"/>
                      </option>
                    </t>
                  </select>
                </div>

                <div class="ab-chip">
                  <span>Du</span>
                  <input type="date" name="date_from" t-att-value="request.params.get('date_from') or ''"/>
                </div>

                <div class="ab-chip">
                  <span>Au</span>
                  <input type="date" name="date_to" t-att-value="request.params.get('date_to') or ''"/>
                </div>

                <div class="ab-chip-actions">
                  <button class="ab-cta-btn" type="submit">Filtrer</button>
                  <a class="ab-cta-btn" href="/my/missions">Réinitialiser</a>
                </div>
              </div>
            </form>

            <!-- LISTINGS -->
            <t t-if="missions">
              <div class="ab-grid">

                <t t-foreach="missions" t-as="m">
                  <div class="ab-card">

                    <div class="ab-media">
                      <t t-if="m.hospital_id and m.hospital_id.image_1920">
                        <img t-att-src="'/web/image/radiology.hospital/%s/image_1920' % m.hospital_id.id" alt="Mission"/>
                      </t>
                      <t t-else="">
                        <img t-att-src="'/web/static/img/placeholder.png'" alt="Mission"/>
                      </t>

                      <div class="ab-heart" title="Ajouter aux favoris">♥</div>
                    </div>

                    <div class="ab-body">
                      <h5 class="ab-name"><t t-esc="m.name or 'Mission'"/></h5>

                      <div class="ab-meta">
                        <t t-if="m.hospital_id">
                          <t t-esc="m.hospital_id.name"/>
                        </t>
                        <t t-if="m.start_date or m.end_date">
                          •
                          <t t-if="m.start_date"><t t-esc="m.start_date"/></t>
                          <t t-if="m.end_date"> → <t t-esc="m.end_date"/></t>
                        </t>
                      </div>

                      <div class="ab-tags">
                        <t t-foreach="m.speciality_ids[:3]" t-as="sp">
                          <span class="ab-tag"><t t-esc="sp.name"/></span>
                        </t>
                        <t t-foreach="m.brand_ids[:2]" t-as="br">
                          <span class="ab-tag"><t t-esc="br.name"/></span>
                        </t>
                        <t t-if="len(m.speciality_ids) &gt; 3">
                          <span class="ab-tag">+<t t-esc="len(m.speciality_ids)-3"/></span>
                        </t>
                        <t t-if="len(m.brand_ids) &gt; 2">
                          <span class="ab-tag">+<t t-esc="len(m.brand_ids)-2"/></span>
                        </t>
                      </div>

                      <div class="ab-bottom">
                        <div class="ab-price">
                          <t t-esc="m.tarif or '—'"/> €
                          <span>/ mission</span>
                        </div>

                        <a class="ab-cta-btn" t-att-href="'/my/missions/%s' % m.id">
                          Voir l’offre ↗
                        </a>
                      </div>
                    </div>

                  </div>
                </t>

              </div>
            </t>

            <t t-else="">
              <div class="mt-4 alert alert-info border-0 shadow-sm"
                   style="border-radius:18px; background: rgba(255,255,255,.80);">
                Aucune mission ne correspond à vos filtres.
              </div>
            </t>

            <!-- POPUP RECOMMANDATIONS -->
            <t t-if="show_recommend_modal and recommended_radiologists">
              <div class="ab-backdrop" id="recommendModal">
                <div class="ab-modal" role="dialog" aria-modal="true">

                  <div class="ab-modal-head">
                    <div>
                      <h5 class="ab-modal-title">Radiologues recommandés</h5>
                      <div class="ab-modal-sub">
                        Recommandation basée sur spécialités, marques, expérience et évaluations.
                      </div>
                    </div>
                    <button class="ab-close" type="button" onclick="closeRecommendModal()" aria-label="Close">×</button>
                  </div>

                  <div class="ab-modal-body">
                    <div class="ab-rgrid">

                      <t t-foreach="recommended_radiologists" t-as="r">
                        <div class="ab-rcard">
                          <div class="ab-rcard-in">

                            <div class="ab-ravatar">
                              <t t-if="r.image_1920">
                                <img t-att-src="'/web/image/radiology.radiologist/%s/image_1920' % r.id" alt="Photo"/>
                              </t>
                              <t t-else="">
                                <img t-att-src="'/web/static/img/user_menu_avatar.png'" alt="Avatar"/>
                              </t>
                            </div>

                            <div class="min-w-0" style="flex:1;">
                              <p class="ab-rname"><t t-esc="r.display_name or 'Radiologue'"/></p>

                              <div class="ab-rmeta">
                                <span class="ab-pill"><t t-esc="r.experience_years or 0"/> ans</span>
                              </div>

                              <t t-if="r.specialty_ids">
                                <div class="ab-rmeta" style="margin-top:8px;">
                                  <t t-foreach="r.specialty_ids[:3]" t-as="sp">
                                    <span class="ab-tag"><t t-esc="sp.name"/></span>
                                  </t>
                                  <t t-if="len(r.specialty_ids) &gt; 3">
                                    <span class="ab-tag">+<t t-esc="len(r.specialty_ids) - 3"/></span>
                                  </t>
                                </div>
                              </t>

                              <t t-if="r.brand_ids">
                                <div class="ab-rmeta" style="margin-top:8px;">
                                  <t t-foreach="r.brand_ids[:2]" t-as="br">
                                    <span class="ab-tag"><t t-esc="br.name"/></span>
                                  </t>
                                  <t t-if="len(r.brand_ids) &gt; 2">
                                    <span class="ab-tag">+<t t-esc="len(r.brand_ids) - 2"/></span>
                                  </t>
                                </div>
                              </t>

                              <div class="ab-actions2">
                                <a t-att-href="'/my/radiologists/%s' % r.id" class="ab-cta-btn">Voir profil</a>
                                <a t-att-href="'/my/chat/start?radiologist_id=%s' % r.id"
                                   class="ab-cta-btn ab-cta-btn-primary">Contacter</a>
                              </div>
                            </div>

                          </div>
                        </div>
                      </t>

                    </div>
                  </div>

                </div>
              </div>

              <script type="text/javascript">
                function closeRecommendModal() {
                  const modal = document.getElementById('recommendModal');
                  if (modal) modal.remove();

                  const url = new URL(window.location);
                  url.searchParams.delete('recommend');
                  url.searchParams.delete('mission_id');
                  window.history.replaceState({}, document.title, url);
                }

                document.addEventListener('click', function(e){
                  const modal = document.getElementById('recommendModal');
                  if (!modal) return;
                  if (e.target === modal) closeRecommendModal();
                });

                document.addEventListener('keydown', function(e){
                  if (e.key === 'Escape') closeRecommendModal();
                });
              </script>
            </t>

          </div><!-- /ab-inner -->
        </div><!-- /ab-shell -->
      </section>

    </t>
  </template>
</odoo>
