<odoo>
    <record id="view_application_tree" model="ir.ui.view">
        <field name="name">radiology.application.tree</field>
        <field name="model">radiology.application</field>
        <field name="arch" type="xml">
            <tree>
                <field name="radiologist_id"/>
                <field name="mission_id"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="view_application_form" model="ir.ui.view">
        <field name="name">radiology.application.form</field>
        <field name="model">radiology.application</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="radiologist_id"/>
                        <field name="mission_id"/>
                        <field name="status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_application" model="ir.actions.act_window">
        <field name="name">Candidatures</field>
        <field name="res_model">radiology.application</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
