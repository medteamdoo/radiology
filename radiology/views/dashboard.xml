<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="portal_hospital_dashboard" name="Portal - Hospital Calendar (RadioVac SaaS)">
        <t t-set="rl_fullwidth" t-value="True"/>
        <t t-set="breadcrumbs" t-value="False"/>
        <t t-set="no_breadcrumbs" t-value="True"/>

        <t t-call="portal.portal_layout">
            <t t-set="rv_page_title" t-value="'Planning RadioVac'"/>
            <t t-set="rv_page_subtitle"
               t-value="'Gerez vos missions, disponibilites et echeances en un coup d oeil.'"/>

            <t t-call="radiology.rv_portal_shell">
                <t t-set="rv_portal_active" t-value="'calendar'"/>

                <div class="rv-portal-stack rv-calendar-page">
                    <section class="rv-calendar-stats">
                        <t t-foreach="stats_cards" t-as="card">
                            <article t-attf-class="rv-calendar-stat-card #{card['accent']}">
                                <span class="rv-calendar-stat-icon"><i t-att-class="card['icon']"/></span>
                                <div class="rv-calendar-stat-copy">
                                    <small><t t-esc="card['label']"/></small>
                                    <strong><t t-esc="card['value']"/></strong>
                                    <span><t t-esc="card['note']"/></span>
                                </div>
                            </article>
                        </t>
                    </section>

                    <div class="rv-calendar-layout">
                        <aside class="rv-calendar-left">
                            <section class="rv-portal-card rv-calendar-mini">
                                <div class="rv-calendar-panel-head">
                                    <a t-att-href="prev_month_url" class="rv-calendar-nav-btn" aria-label="Mois precedent">
                                        <i class="fa fa-chevron-left"/>
                                    </a>
                                    <h3><t t-esc="anchor_month_label"/></h3>
                                    <a t-att-href="next_month_url" class="rv-calendar-nav-btn" aria-label="Mois suivant">
                                        <i class="fa fa-chevron-right"/>
                                    </a>
                                </div>

                                <div class="rv-calendar-mini-weekdays">
                                    <t t-foreach="mini_calendar_letters" t-as="letter">
                                        <span><t t-esc="letter"/></span>
                                    </t>
                                </div>

                                <div class="rv-calendar-mini-grid">
                                    <t t-foreach="mini_calendar_weeks" t-as="week">
                                        <t t-foreach="week" t-as="day">
                                            <a t-att-href="day['url']"
                                               t-attf-class="rv-calendar-mini-day #{'is-current' if day['is_current_month'] else 'is-out'} #{'is-today' if day['is_today'] else ''} #{'is-selected' if day['is_selected'] else ''}">
                                                <t t-esc="day['number']"/>
                                            </a>
                                        </t>
                                    </t>
                                </div>
                            </section>

                            <form class="rv-portal-card rv-calendar-filters" method="get" action="/my/dashboard">
                                <input type="hidden" name="view" t-att-value="view_mode"/>
                                <input type="hidden" name="anchor" t-att-value="anchor_day.isoformat()"/>

                                <div class="rv-calendar-panel-head">
                                    <h3>Filtres</h3>
                                    <a href="/my/dashboard" class="rv-calendar-reset-link">Reinitialiser</a>
                                </div>

                                <div class="rv-calendar-filter-stack">
                                    <div class="rv-calendar-filter-field">
                                        <label for="rv_calendar_type">Type</label>
                                        <select id="rv_calendar_type" name="type">
                                            <t t-foreach="type_options" t-as="opt">
                                                <option t-att-value="opt[0]"
                                                        t-att-selected="1 if opt[0] == selected_type else None">
                                                    <t t-esc="opt[1]"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>

                                    <div class="rv-calendar-filter-field">
                                        <label for="rv_calendar_status">Statut</label>
                                        <select id="rv_calendar_status" name="status">
                                            <t t-foreach="status_options" t-as="opt">
                                                <option t-att-value="opt[0]"
                                                        t-att-selected="1 if opt[0] == selected_status else None">
                                                    <t t-esc="opt[1]"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>

                                    <div class="rv-calendar-filter-field">
                                        <label for="rv_calendar_specialty">Specialite</label>
                                        <select id="rv_calendar_specialty" name="specialty_id">
                                            <option value="">Toutes</option>
                                            <t t-foreach="specialties" t-as="sp">
                                                <option t-att-value="sp.id"
                                                        t-att-selected="1 if str(sp.id) == str(selected_specialty) else None">
                                                    <t t-esc="sp.name"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>

                                    <div class="rv-calendar-filter-field">
                                        <label for="rv_calendar_radiologist">Radiologue favori</label>
                                        <select id="rv_calendar_radiologist" name="radiologist_id">
                                            <option value="">Tous</option>
                                            <t t-foreach="favorite_options" t-as="fav">
                                                <option t-att-value="fav.id"
                                                        t-att-selected="1 if str(fav.id) == str(selected_radiologist) else None">
                                                    <t t-esc="fav.display_name or 'Radiologue'"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>

                                    <label class="rv-calendar-filter-check">
                                        <input type="checkbox" name="my_only" value="1"
                                               t-att-checked="1 if selected_my_only else None"/>
                                        <span>Mes missions uniquement</span>
                                    </label>

                                    <div class="rv-calendar-filter-actions">
                                        <button type="submit" class="rv-portal-btn rv-portal-btn-primary">Appliquer</button>
                                        <a href="/my/dashboard" class="rv-portal-btn rv-portal-btn-secondary">Effacer</a>
                                    </div>
                                </div>
                            </form>
                        </aside>

                        <section class="rv-portal-card rv-calendar-board">
                            <div class="rv-calendar-toolbar">
                                <div class="rv-calendar-toolbar-main">
                                    <span class="rv-portal-section-kicker">Planning compact</span>
                                    <h3>Vue <t t-esc="'jour' if view_mode == 'day' else 'semaine' if view_mode == 'week' else 'mois'"/></h3>
                                </div>

                                <div class="rv-calendar-toolbar-actions">
                                    <a t-att-href="today_url" class="rv-calendar-toolbar-btn">Aujourd'hui</a>
                                    <div class="rv-calendar-toolbar-nav">
                                        <a t-att-href="prev_url" class="rv-calendar-toolbar-btn" aria-label="Precedent">
                                            <i class="fa fa-chevron-left"/>
                                        </a>
                                        <a t-att-href="next_url" class="rv-calendar-toolbar-btn" aria-label="Suivant">
                                            <i class="fa fa-chevron-right"/>
                                        </a>
                                    </div>
                                    <div class="rv-calendar-view-tabs">
                                        <a t-att-href="day_url" t-attf-class="rv-calendar-view-tab #{'is-active' if view_mode == 'day' else ''}">Jour</a>
                                        <a t-att-href="week_url" t-attf-class="rv-calendar-view-tab #{'is-active' if view_mode == 'week' else ''}">Semaine</a>
                                        <a t-att-href="month_url" t-attf-class="rv-calendar-view-tab #{'is-active' if view_mode == 'month' else ''}">Mois</a>
                                    </div>
                                    <a href="/my/missions/new" class="rv-portal-btn rv-portal-btn-secondary">
                                        <i class="fa fa-plus"/>
                                        <span>Ajouter</span>
                                    </a>
                                </div>
                            </div>

                            <t t-if="view_mode != 'month'">
                                <div class="rv-calendar-week-shell">
                                    <div class="rv-calendar-week-head"
                                         t-att-style="'grid-template-columns: 5rem repeat(%s, minmax(0, 1fr));' % visible_column_count">
                                        <div class="rv-calendar-time-spacer"/>
                                        <t t-foreach="calendar_columns" t-as="col">
                                            <a t-att-href="col['anchor_url']"
                                               t-attf-class="rv-calendar-week-day #{'is-today' if col['is_today'] else ''} #{'is-selected' if col['is_selected'] else ''}">
                                                <span><t t-esc="col['day_label']"/></span>
                                                <strong><t t-esc="col['day_number']"/></strong>
                                            </a>
                                        </t>
                                    </div>

                                    <div class="rv-calendar-all-day-row"
                                         t-att-style="'grid-template-columns: 5rem repeat(%s, minmax(0, 1fr));' % visible_column_count">
                                        <div class="rv-calendar-all-day-label">Toute la journee</div>
                                        <t t-foreach="calendar_columns" t-as="col">
                                            <div class="rv-calendar-all-day-cell">
                                                <t t-if="col['all_day_visible']">
                                                    <t t-foreach="col['all_day_visible']" t-as="item">
                                                        <a t-att-href="item['url']"
                                                           t-attf-class="rv-calendar-event rv-calendar-event-chip #{item['css']}">
                                                            <strong><t t-esc="item['title']"/></strong>
                                                            <small><t t-esc="item['meta']"/></small>
                                                        </a>
                                                    </t>
                                                    <span t-if="col['all_day_more']" class="rv-calendar-more-chip">
                                                        +<t t-esc="col['all_day_more']"/> autres
                                                    </span>
                                                </t>
                                                <t t-else="">
                                                    <span class="rv-calendar-empty-chip">-</span>
                                                </t>
                                            </div>
                                        </t>
                                    </div>

                                    <div class="rv-calendar-grid"
                                         t-att-style="'grid-template-columns: 5rem repeat(%s, minmax(0, 1fr));' % visible_column_count">
                                        <div class="rv-calendar-time-axis">
                                            <t t-foreach="calendar_hours" t-as="hour">
                                                <div class="rv-calendar-time-cell"><t t-esc="hour"/></div>
                                            </t>
                                        </div>

                                        <div class="rv-calendar-columns"
                                             t-att-style="'grid-template-columns: repeat(%s, minmax(0, 1fr));' % visible_column_count">
                                            <div t-if="current_time_marker" class="rv-calendar-now-line" t-att-style="current_time_marker['style']">
                                                <span><t t-esc="current_time_marker['label']"/></span>
                                            </div>

                                            <t t-foreach="calendar_columns" t-as="col">
                                                <div class="rv-calendar-column">
                                                    <div class="rv-calendar-column-lines">
                                                        <t t-foreach="calendar_hours" t-as="hour">
                                                            <span class="rv-calendar-hour-line"/>
                                                        </t>
                                                    </div>
                                                    <t t-if="col['timed_items']">
                                                        <t t-foreach="col['timed_items']" t-as="event">
                                                            <a t-att-href="event['url']"
                                                               t-att-style="event['style']"
                                                               t-attf-class="rv-calendar-event rv-calendar-event-timed #{event['css']}">
                                                                <strong><t t-esc="event['title']"/></strong>
                                                                <span><t t-esc="event['meta']"/></span>
                                                                <small><t t-esc="event['subtitle']"/></small>
                                                            </a>
                                                        </t>
                                                    </t>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </t>

                            <t t-else="">
                                <div class="rv-calendar-month-board">
                                    <div class="rv-calendar-month-weekdays">
                                        <t t-foreach="mini_calendar_letters" t-as="letter">
                                            <span><t t-esc="letter"/></span>
                                        </t>
                                    </div>

                                    <div class="rv-calendar-month-grid">
                                        <t t-foreach="month_board_weeks" t-as="week">
                                            <t t-foreach="week" t-as="day">
                                                <a t-att-href="day['url']"
                                                   t-attf-class="rv-calendar-month-cell #{'is-current' if day['is_current_month'] else 'is-out'} #{'is-today' if day['is_today'] else ''} #{'is-selected' if day['is_selected'] else ''}">
                                                    <div class="rv-calendar-month-daynum"><t t-esc="day['number']"/></div>
                                                    <div class="rv-calendar-month-items">
                                                        <t t-foreach="day['items']" t-as="item">
                                                            <span t-attf-class="rv-calendar-month-pill #{item['css']}">
                                                                <t t-esc="item['title']"/>
                                                            </span>
                                                        </t>
                                                        <span t-if="day['more']" class="rv-calendar-month-more">
                                                            +<t t-esc="day['more']"/>
                                                        </span>
                                                    </div>
                                                </a>
                                            </t>
                                        </t>
                                    </div>
                                </div>
                            </t>

                            <div class="rv-calendar-mobile-board">
                                <t t-foreach="mobile_agenda_groups" t-as="group">
                                    <article class="rv-calendar-mobile-day">
                                        <h4><t t-esc="group['label']"/></h4>
                                        <t t-if="group['items']">
                                            <div class="rv-calendar-mobile-items">
                                                <t t-foreach="group['items']" t-as="item">
                                                    <a t-att-href="item['url']"
                                                       t-attf-class="rv-calendar-event rv-calendar-event-chip #{item['css']}">
                                                        <strong><t t-esc="item['title']"/></strong>
                                                        <small><t t-esc="item['meta']"/></small>
                                                    </a>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <p class="rv-calendar-mobile-empty">Aucune activite.</p>
                                        </t>
                                    </article>
                                </t>
                            </div>

                            <div class="rv-calendar-legend">
                                <t t-foreach="legend_items" t-as="item">
                                    <span class="rv-calendar-legend-item">
                                        <span t-attf-class="rv-calendar-legend-dot #{item['css']}"/>
                                        <t t-esc="item['label']"/>
                                    </span>
                                </t>
                            </div>
                        </section>

                        <aside class="rv-calendar-right">
                            <section class="rv-portal-card rv-calendar-side-panel">
                                <div class="rv-calendar-panel-head">
                                    <div>
                                        <h3>Jour selectionne</h3>
                                        <small><t t-esc="selected_day_label"/></small>
                                    </div>
                                </div>

                                <div class="rv-calendar-side-stack">
                                    <article class="rv-calendar-day-card">
                                        <div class="rv-calendar-day-card-head">
                                            <h4>Missions du jour</h4>
                                            <span><t t-esc="len(selected_day_missions)"/></span>
                                        </div>
                                        <t t-if="selected_day_missions">
                                            <div class="rv-calendar-side-list">
                                                <t t-foreach="selected_day_missions[:4]" t-as="item">
                                                    <a t-att-href="item['url']" class="rv-calendar-side-row">
                                                        <div>
                                                            <strong><t t-esc="item['title']"/></strong>
                                                            <small><t t-esc="item['subtitle']"/></small>
                                                        </div>
                                                        <span t-attf-class="rv-calendar-status-badge #{item['css']}">
                                                            <t t-esc="item['status']"/>
                                                        </span>
                                                    </a>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <p class="rv-calendar-side-empty">Aucune mission active sur ce jour.</p>
                                        </t>
                                    </article>

                                    <article class="rv-calendar-day-card">
                                        <div class="rv-calendar-day-card-head">
                                            <h4>Disponibilites favoris</h4>
                                            <span><t t-esc="len(selected_day_availabilities)"/></span>
                                        </div>
                                        <t t-if="selected_day_availabilities">
                                            <div class="rv-calendar-side-list">
                                                <t t-foreach="selected_day_availabilities[:4]" t-as="item">
                                                    <a t-att-href="item['url']" class="rv-calendar-side-row">
                                                        <div>
                                                            <strong><t t-esc="item['title']"/></strong>
                                                            <small><t t-esc="item['subtitle']"/></small>
                                                        </div>
                                                        <span class="rv-calendar-side-meta"><t t-esc="item['meta']"/></span>
                                                    </a>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <p class="rv-calendar-side-empty">Aucun favori disponible sur ce jour.</p>
                                        </t>
                                    </article>

                                    <article class="rv-calendar-day-card">
                                        <div class="rv-calendar-day-card-head">
                                            <h4>Candidatures a traiter</h4>
                                            <span><t t-esc="len(side_pending_applications)"/></span>
                                        </div>
                                        <t t-if="side_pending_applications">
                                            <div class="rv-calendar-side-list">
                                                <t t-foreach="side_pending_applications" t-as="item">
                                                    <a t-att-href="item['url']" class="rv-calendar-side-row">
                                                        <div>
                                                            <strong><t t-esc="item['title']"/></strong>
                                                            <small><t t-esc="item['subtitle']"/></small>
                                                        </div>
                                                        <span class="rv-calendar-side-meta"><t t-esc="item['meta']"/></span>
                                                    </a>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <p class="rv-calendar-side-empty">Aucune candidature en attente.</p>
                                        </t>
                                    </article>

                                    <article class="rv-calendar-day-card">
                                        <div class="rv-calendar-day-card-head">
                                            <h4>Echeances a venir</h4>
                                            <span><t t-esc="len(side_upcoming_deadlines)"/></span>
                                        </div>
                                        <t t-if="side_upcoming_deadlines">
                                            <div class="rv-calendar-side-list">
                                                <t t-foreach="side_upcoming_deadlines" t-as="item">
                                                    <a t-att-href="item['url']" class="rv-calendar-side-row">
                                                        <div>
                                                            <strong><t t-esc="item['title']"/></strong>
                                                            <small><t t-esc="item['subtitle']"/></small>
                                                        </div>
                                                        <span class="rv-calendar-side-meta"><t t-esc="item['meta']"/></span>
                                                    </a>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <p class="rv-calendar-side-empty">Aucune echeance proche.</p>
                                        </t>
                                    </article>
                                </div>
                            </section>
                        </aside>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
