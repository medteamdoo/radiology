<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <template id="portal_mission_details_modern" name="Portal - Mission Details (Modern)">
    <t t-set="rl_fullwidth" t-value="True"/>
    <t t-set="breadcrumbs" t-value="False"/>

    <t t-call="portal.portal_layout">
      <t t-set="breadcrumbs_searchbar" t-value="True"/>

      <style>
        :root{
          --rlx-text:#0B1220;
          --rlx-muted:#667085;
          --rlx-border: rgba(15,23,42,.10);
          --rlx-card: rgba(255,255,255,.80);
          --rlx-shadow: 0 18px 60px rgba(2,6,23,.10);
          --rlx-shadow2: 0 10px 26px rgba(2,6,23,.08);
          --rlx-primary:#2563EB;
          --rlx-primary-dark:#1D4ED8;
          --rlx-radius: 22px;
        }

        /* Full width portal only for this page (safe) */
        .o_portal_wrap > .container{
          max-width:100% !important;
          padding-left:0 !important;
          padding-right:0 !important;
        }
        .o_portal_wrap > .container.pt-3{ padding-top:0 !important; }

        .rlx-page{
          min-height:100vh;
          background:
            radial-gradient(1200px 520px at 10% 0%, rgba(37,99,235,.10), transparent 55%),
            linear-gradient(180deg, #EEF5FF 0%, #F8FAFC 42%, #FFFFFF 100%);
        }
        .rlx-shell{ padding: 22px 18px 46px; }
        @media(min-width:992px){ .rlx-shell{ padding: 34px 34px 64px; } }

        .rlx-hero{
          border-radius: var(--rlx-radius);
          border: 1px solid var(--rlx-border);
          background: var(--rlx-card);
          backdrop-filter: blur(12px);
          -webkit-backdrop-filter: blur(12px);
          box-shadow: var(--rlx-shadow);
          overflow:hidden;
          position:relative;
        }
        .rlx-hero:before{
          content:"";
          position:absolute; inset:-2px;
          background:
            radial-gradient(700px 260px at 18% 0%, rgba(37,99,235,.16), transparent 60%),
            radial-gradient(700px 260px at 85% 0%, rgba(99,102,241,.12), transparent 60%);
          pointer-events:none;
        }
        .rlx-hero > *{ position:relative; }

        .rlx-hero-in{ padding: 18px; }
        @media(min-width:992px){ .rlx-hero-in{ padding: 26px; } }

        .rlx-title{
          margin:0;
          font-weight: 900;
          letter-spacing:-.02em;
          color: var(--rlx-text);
          font-size: 32px;
          line-height: 1.12;
        }
        @media(max-width:576px){ .rlx-title{ font-size: 26px; } }

        .rlx-sub{
          margin-top: 10px;
          color: var(--rlx-muted);
          font-weight: 600;
          font-size: 14px;
          line-height: 1.55;
          max-width: 880px;
        }

        .rlx-pills{
          display:flex;
          flex-wrap:wrap;
          gap: 10px;
          margin-top: 14px;
        }
        .rlx-pill{
          display:inline-flex; align-items:center;
          padding: 8px 12px;
          border-radius: 999px;
          border: 1px solid rgba(2,6,23,.08);
          background: rgba(255,255,255,.78);
          font-weight: 800;
          font-size: 12.5px;
          color:#0F172A;
          white-space: nowrap;
        }
        .rlx-pill-price{
          border-color: rgba(37,99,235,.20);
          background: rgba(37,99,235,.08);
          color: var(--rlx-primary-dark);
        }

        .rlx-btn{
          border-radius: 14px !important;
          padding: 10px 14px !important;
          font-weight: 800 !important;
        }
        .rlx-primary{
          background: var(--rlx-primary) !important;
          border: none !important;
          color:#fff !important;
          box-shadow: 0 14px 30px rgba(37,99,235,.22);
        }
        .rlx-primary:hover{ background: var(--rlx-primary-dark) !important; }
        .rlx-ghost{
          background: rgba(37,99,235,.06) !important;
          border: 1px solid rgba(37,99,235,.20) !important;
          color: var(--rlx-primary-dark) !important;
        }

        .rlx-card{
          border-radius: var(--rlx-radius);
          border: 1px solid rgba(2,6,23,.10);
          background: rgba(255,255,255,.82);
          box-shadow: var(--rlx-shadow2);
          overflow:hidden;
        }
        .rlx-card-h{
          padding: 14px 16px;
          display:flex;
          align-items:center;
          justify-content:space-between;
          gap: 10px;
          border-bottom: 1px solid rgba(2,6,23,.08);
          background: rgba(255,255,255,.70);
        }
        .rlx-h3{
          margin:0;
          font-weight: 900;
          color: var(--rlx-text);
          letter-spacing:-.01em;
          font-size: 16px;
        }
        .rlx-card-b{ padding: 14px 16px; }

        .rlx-desc{
          color:#475569;
          font-size: 13.5px;
          font-weight: 600;
          line-height: 1.65;
          white-space: pre-wrap;
        }

        .rlx-chips{ display:flex; flex-wrap:wrap; gap: 8px; }
        .rlx-chip{
          display:inline-flex;
          align-items:center;
          padding: 7px 10px;
          border-radius: 999px;
          font-weight: 800;
          font-size: 12px;
          border: 1px solid;
          background: rgba(255,255,255,.78);
          white-space: nowrap;
        }
        .rlx-chip-sp{ border-color:#A5F3FC; color:#155E75; background: rgba(236,254,255,.78); }
        .rlx-chip-br{ border-color:#E2E8F0; color:#334155; background: rgba(248,250,252,.86); }

        .rlx-hosp{
          display:flex;
          gap: 12px;
          align-items:center;
        }
        .rlx-hosp-img{
          width: 56px; height: 56px;
          border-radius: 18px;
          overflow:hidden;
          background: linear-gradient(180deg,#EAF2FB 0%,#DDEBFA 100%);
          border: 1px solid rgba(2,6,23,.10);
          box-shadow: 0 12px 22px rgba(2,6,23,.10);
          flex: 0 0 auto;
        }
        .rlx-hosp-img img{ width:100%; height:100%; object-fit:cover; display:block; }
        .rlx-hosp-name{ font-weight: 900; color:#0F172A; margin:0; line-height:1.2; }
        .rlx-hosp-meta{ color: var(--rlx-muted); font-weight: 650; font-size: 12.5px; margin-top:3px; }

        .rlx-kv{ display:grid; grid-template-columns: 1fr; gap: 10px; }
        .rlx-kv-row{
          display:flex; align-items:center; justify-content:space-between; gap:10px;
          border: 1px solid rgba(2,6,23,.08);
          background: rgba(255,255,255,.78);
          border-radius: 16px;
          padding: 12px 12px;
        }
        .rlx-k{ color: var(--rlx-muted); font-weight: 800; font-size: 12.5px; }
        .rlx-v{ color: var(--rlx-text); font-weight: 900; font-size: 13px; text-align:right; }
      </style>

      <section class="rlx-page">
        <div class="container-fluid rlx-shell">

          <!-- HERO -->
          <div class="rlx-hero">
            <div class="rlx-hero-in">

              <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                <div>
                  <h2 class="rlx-title">
                    <t t-esc="mission.name or 'Mission'"/>
                  </h2>
                  <div class="rlx-sub">
                    Détails complets de la mission : période, spécialités, marques et informations de l’établissement.
                  </div>

                  <div class="rlx-pills">
                    <span class="rlx-pill rlx-pill-price">
                      <t t-esc="mission.tarif or '—'"/> €
                    </span>

                    <t t-if="mission.start_date">
                      <span class="rlx-pill">
                        Début : <t t-esc="mission.start_date"/>
                      </span>
                    </t>

                    <t t-if="mission.end_date">
                      <span class="rlx-pill">
                        Fin : <t t-esc="mission.end_date"/>
                      </span>
                    </t>
                  </div>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                  <a href="/my/missions" class="btn rlx-btn rlx-ghost">Retour</a>
                  <a href="/my/missions" class="btn rlx-btn rlx-primary">Trouver des radiologues compatibles</a>
                </div>
              </div>

            </div>
          </div>

          <!-- CONTENT -->
          <div class="row g-3 mt-3">

            <!-- Left: main -->
            <div class="col-lg-8">

              <!-- Description -->
              <div class="rlx-card">
                <div class="rlx-card-h">
                  <h3 class="rlx-h3">Description</h3>
                </div>
                <div class="rlx-card-b">
                  <t t-if="mission.description">
                    <div class="rlx-desc"><t t-esc="mission.description"/></div>
                  </t>
                  <t t-else="">
                    <div class="text-muted" style="font-weight:650;">Aucune description fournie.</div>
                  </t>
                </div>
              </div>

              <!-- Specialties + Brands -->
              <div class="rlx-card mt-3">
                <div class="rlx-card-h">
                  <h3 class="rlx-h3">Spécialités et marques</h3>
                </div>
                <div class="rlx-card-b">

                  <t t-if="mission.speciality_ids">
                    <div class="mb-2" style="font-weight:800;color:#0F172A;">Spécialités</div>
                    <div class="rlx-chips">
                      <t t-foreach="mission.speciality_ids" t-as="sp">
                        <span class="rlx-chip rlx-chip-sp"><t t-esc="sp.name"/></span>
                      </t>
                    </div>
                  </t>

                  <t t-if="mission.brand_ids">
                    <div class="mt-3 mb-2" style="font-weight:800;color:#0F172A;">Marques</div>
                    <div class="rlx-chips">
                      <t t-foreach="mission.brand_ids" t-as="br">
                        <span class="rlx-chip rlx-chip-br"><t t-esc="br.name"/></span>
                      </t>
                    </div>
                  </t>

                  <t t-if="not mission.speciality_ids and not mission.brand_ids">
                    <div class="text-muted" style="font-weight:650;">Aucune spécialité ou marque sélectionnée.</div>
                  </t>

                </div>
              </div>

            </div>

            <!-- Right: hospital + recap -->
            <div class="col-lg-4">

              <!-- Hospital card -->
              <div class="rlx-card">
                <div class="rlx-card-h">
                  <h3 class="rlx-h3">Établissement partenaire</h3>
                </div>
                <div class="rlx-card-b">

                  <div class="rlx-hosp">
                    <div class="rlx-hosp-img">
                      <t t-if="hospital and hospital.image_1920">
                        <img t-att-src="'/web/image/radiology.hospital/%s/image_1920' % hospital.id" alt="Hôpital"/>
                      </t>
                      <t t-else="">
                        <div class="w-100 h-100 d-flex align-items-center justify-content-center"
                             style="font-weight:900;color:#2563EB;">
                          RL
                        </div>
                      </t>
                    </div>

                    <div class="min-w-0">
                      <p class="rlx-hosp-name">
                        <t t-esc="(hospital and hospital.name) or 'Hôpital'"/>
                      </p>

                      <t t-if="hospital and hospital.city">
                        <div class="rlx-hosp-meta">
                          <t t-esc="hospital.city"/>
                        </div>
                      </t>
                    </div>
                  </div>

                </div>
              </div>

              <!-- Recap -->
              <div class="rlx-card mt-3">
                <div class="rlx-card-h">
                  <h3 class="rlx-h3">Récapitulatif</h3>
                </div>
                <div class="rlx-card-b">
                  <div class="rlx-kv">

                    <div class="rlx-kv-row">
                      <div class="rlx-k">Tarif</div>
                      <div class="rlx-v"><t t-esc="mission.tarif or '—'"/> €</div>
                    </div>

                    <div class="rlx-kv-row">
                      <div class="rlx-k">Date début</div>
                      <div class="rlx-v"><t t-esc="mission.start_date or '—'"/></div>
                    </div>

                    <div class="rlx-kv-row">
                      <div class="rlx-k">Date fin</div>
                      <div class="rlx-v"><t t-esc="mission.end_date or '—'"/></div>
                    </div>

                  </div>
                </div>
              </div>

            </div>

          </div>

        </div>
      </section>

    </t>
  </template>

</odoo>
