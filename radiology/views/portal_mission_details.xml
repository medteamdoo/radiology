<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <template id="portal_mission_details_modern" name="Portal - Mission Details (Airbnb Pro)">
    <t t-set="rl_fullwidth" t-value="True"/>
    <t t-set="breadcrumbs" t-value="False"/>

    <t t-call="portal.portal_layout">
      <t t-set="breadcrumbs_searchbar" t-value="True"/>

      <style>
        :root{
          --ab-text:#0f172a;
          --ab-muted:#64748b;
          --ab-border: rgba(15,23,42,.10);
          --ab-chip:#f8fafc;
          --ab-chip-border: rgba(15,23,42,.12);
          --ab-shadow: 0 10px 30px rgba(2,6,23,.08);
          --ab-shadow2: 0 14px 46px rgba(2,6,23,.10);
          --ab-radius2: 22px;
          --ab-primary:#2563eb;
        }

        /* Full width portal container but keep inner max-width */
        .o_portal_wrap > .container{ max-width:100% !important; padding-left:0 !important; padding-right:0 !important; }
        .o_portal_wrap > .container.pt-3{ padding-top:0 !important; }

        .ab-page{ min-height:100vh; background:#fff; }
        .ab-shell{ padding: 18px 0 56px; }
        @media(min-width:768px){ .ab-shell{ padding: 22px 0 64px; } }
        @media(min-width:1200px){ .ab-shell{ padding: 26px 0 70px; } }

        .ab-inner{
          max-width: 1320px;
          margin: 0 auto;
          padding-left: 18px;
          padding-right: 18px;
        }
        @media(min-width:768px){ .ab-inner{ padding-left: 28px; padding-right: 28px; } }
        @media(min-width:1200px){ .ab-inner{ padding-left: 40px; padding-right: 40px; } }

        /* Hero card */
        .ab-hero{
          border-radius: var(--ab-radius2);
          border: 1px solid var(--ab-border);
          background: rgba(255,255,255,.92);
          box-shadow: var(--ab-shadow);
          overflow:hidden;
        }
        .ab-hero-in{ padding: 14px 14px 16px; }
        @media(min-width:992px){ .ab-hero-in{ padding: 18px 18px 20px; } }

        .ab-title{
          margin:0;
          color: var(--ab-text);
          font-weight: 950;
          letter-spacing: -.02em;
          font-size: 28px;
          line-height: 1.1;
        }
        .ab-sub{
          margin-top: 8px;
          color: var(--ab-muted);
          font-weight: 650;
          font-size: 13.5px;
          line-height: 1.55;
          max-width: 900px;
        }

        /* Pills */
        .ab-pills{
          margin-top: 12px;
          display:flex;
          flex-wrap:wrap;
          gap: 10px;
        }
        .ab-pill{
          display:inline-flex;
          align-items:center;
          gap:8px;
          padding: 9px 12px;
          border-radius: 999px;
          border: 1px solid var(--ab-chip-border);
          background: var(--ab-chip);
          color: var(--ab-text);
          font-weight: 900;
          font-size: 12.5px;
          white-space: nowrap;
        }
        .ab-pill-price{
          border-color: rgba(37,99,235,.22);
          background: rgba(239,246,255,.95);
          color:#1d4ed8;
        }

        /* Buttons (same as Missions) */
        .ab-cta-btn{
          border-radius: 12px !important;
          padding: 10px 12px !important;
          font-weight: 950 !important;
          font-size: 13px !important;
          text-decoration:none !important;
          border: 1px solid rgba(37,99,235,.22) !important;
          background: rgba(239,246,255,.95) !important;
          color: #1d4ed8 !important;
          display:inline-flex !important;
          align-items:center !important;
          justify-content:center !important;
          gap: 8px !important;
          cursor:pointer;
          white-space: nowrap;
        }
        .ab-cta-btn:hover{
          background: rgba(219,234,254,.95) !important;
          color:#1d4ed8 !important;
          text-decoration:none !important;
        }
        .ab-cta-btn-primary{
          background: var(--ab-primary) !important;
          border-color: var(--ab-primary) !important;
          color: #fff !important;
          box-shadow: 0 12px 26px rgba(37,99,235,.18);
        }
        .ab-cta-btn-primary:hover{
          background: #1d4ed8 !important;
          border-color:#1d4ed8 !important;
          color:#fff !important;
        }

        /* Cards */
        .ab-card{
          border-radius: var(--ab-radius2);
          border: 1px solid var(--ab-border);
          background: rgba(255,255,255,.92);
          box-shadow: var(--ab-shadow);
          overflow:hidden;
        }
        .ab-card-hd{
          padding: 12px 14px;
          border-bottom: 1px solid rgba(15,23,42,.08);
          display:flex;
          align-items:center;
          justify-content:space-between;
          gap:12px;
          background: rgba(255,255,255,.80);
        }
        .ab-card-title{
          margin:0;
          font-weight: 950;
          color: var(--ab-text);
          font-size: 15px;
          letter-spacing: -.01em;
        }
        .ab-card-bd{ padding: 14px; }

        /* Description text */
        .ab-desc{
          color:#475569;
          font-size: 13.5px;
          font-weight: 650;
          line-height: 1.7;
          white-space: pre-wrap;
        }

        /* Chips */
        .ab-chips{ display:flex; flex-wrap:wrap; gap: 8px; }
        .ab-chip{
          display:inline-flex;
          align-items:center;
          padding: 7px 10px;
          border-radius: 999px;
          border: 1px solid rgba(15,23,42,.10);
          background: rgba(248,250,252,.90);
          color: var(--ab-text);
          font-weight: 850;
          font-size: 12px;
          white-space: nowrap;
        }

        /* Hospital */
        .ab-hosp{
          display:flex;
          gap: 12px;
          align-items:center;
        }
        .ab-hosp-img{
          width: 58px; height: 58px;
          border-radius: 18px;
          overflow:hidden;
          background: #eef2ff;
          border: 1px solid rgba(15,23,42,.10);
          box-shadow: 0 12px 22px rgba(2,6,23,.10);
          flex: 0 0 auto;
        }
        .ab-hosp-img img{ width:100%; height:100%; object-fit:cover; display:block; }
        .ab-hosp-name{ font-weight: 950; color: var(--ab-text); margin:0; line-height:1.2; }
        .ab-hosp-meta{ color: var(--ab-muted); font-weight: 700; font-size: 12.5px; margin-top:4px; }

        /* Key/Value */
        .ab-kv{ display:flex; flex-direction:column; gap: 10px; }
        .ab-kv-row{
          display:flex;
          align-items:center;
          justify-content:space-between;
          gap: 12px;
          padding: 12px;
          border-radius: 16px;
          border: 1px solid rgba(15,23,42,.10);
          background: rgba(248,250,252,.75);
        }
        .ab-k{ color: var(--ab-muted); font-weight: 800; font-size: 12.5px; }
        .ab-v{ color: var(--ab-text); font-weight: 950; font-size: 13px; text-align:right; white-space:nowrap; }
      </style>

      <section class="ab-page">
        <div class="container-fluid ab-shell">
          <div class="ab-inner">

            <!-- HERO -->
            <div class="ab-hero">
              <div class="ab-hero-in">

                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                  <div>
                    <h2 class="ab-title">
                      <t t-esc="mission.name or 'Mission'"/>
                    </h2>

                    <div class="ab-sub">
                      Détails complets de la mission : période, spécialités, marques et informations de l’établissement.
                    </div>

                    <div class="ab-pills">
                      <span class="ab-pill ab-pill-price">
                        <t t-esc="mission.tarif or '—'"/> €
                        <span style="color:var(--ab-muted);font-weight:850;">/ mission</span>
                      </span>

                      <t t-if="mission.start_date">
                        <span class="ab-pill">Début : <t t-esc="mission.start_date"/></span>
                      </t>
                      <t t-if="mission.end_date">
                        <span class="ab-pill">Fin : <t t-esc="mission.end_date"/></span>
                      </t>
                    </div>
                  </div>

                  <div class="d-flex gap-2 flex-wrap">
                    <a href="/my/missions" class="ab-cta-btn">Retour</a>

                    <!-- si tu as une route dédiée, remplace href -->
                    <a href="/my/missions" class="ab-cta-btn ab-cta-btn-primary">
                      Trouver des radiologues compatibles
                    </a>
                  </div>
                </div>

              </div>
            </div>

            <!-- CONTENT -->
            <div class="row g-4 mt-3">

              <!-- Left -->
              <div class="col-lg-8">

                <!-- Description -->
                <div class="ab-card">
                  <div class="ab-card-hd">
                    <h3 class="ab-card-title">Description</h3>
                  </div>
                  <div class="ab-card-bd">
                    <t t-if="mission.description">
                      <div class="ab-desc"><t t-esc="mission.description"/></div>
                    </t>
                    <t t-else="">
                      <div class="ab-sub" style="margin:0;">Aucune description fournie.</div>
                    </t>
                  </div>
                </div>

                <!-- Specialties + Brands -->
                <div class="ab-card mt-4">
                  <div class="ab-card-hd">
                    <h3 class="ab-card-title">Spécialités et marques</h3>
                  </div>
                  <div class="ab-card-bd">

                    <t t-if="mission.speciality_ids">
                      <div style="font-weight:950;color:var(--ab-text);margin-bottom:8px;">Spécialités</div>
                      <div class="ab-chips">
                        <t t-foreach="mission.speciality_ids" t-as="sp">
                          <span class="ab-chip"><t t-esc="sp.name"/></span>
                        </t>
                      </div>
                    </t>

                    <t t-if="mission.brand_ids">
                      <div style="font-weight:950;color:var(--ab-text);margin:14px 0 8px;">Marques</div>
                      <div class="ab-chips">
                        <t t-foreach="mission.brand_ids" t-as="br">
                          <span class="ab-chip"><t t-esc="br.name"/></span>
                        </t>
                      </div>
                    </t>

                    <t t-if="not mission.speciality_ids and not mission.brand_ids">
                      <div class="ab-sub" style="margin:0;">Aucune spécialité ou marque sélectionnée.</div>
                    </t>

                  </div>
                </div>

              </div>

              <!-- Right -->
              <div class="col-lg-4">

                <!-- Hospital -->
                <div class="ab-card">
                  <div class="ab-card-hd">
                    <h3 class="ab-card-title">Établissement partenaire</h3>
                  </div>
                  <div class="ab-card-bd">

                    <div class="ab-hosp">
                      <div class="ab-hosp-img">
                        <t t-if="hospital and hospital.image_1920">
                          <img t-att-src="'/web/image/radiology.hospital/%s/image_1920' % hospital.id" alt="Hôpital"/>
                        </t>
                        <t t-else="">
                          <img t-att-src="'/web/static/img/placeholder.png'" alt="Hôpital"/>
                        </t>
                      </div>

                      <div class="min-w-0">
                        <p class="ab-hosp-name">
                          <t t-esc="(hospital and hospital.name) or 'Hôpital'"/>
                        </p>
                        <t t-if="hospital and hospital.city">
                          <div class="ab-hosp-meta"><t t-esc="hospital.city"/></div>
                        </t>
                      </div>
                    </div>

                  </div>
                </div>

                <!-- Recap -->
                <div class="ab-card mt-4">
                  <div class="ab-card-hd">
                    <h3 class="ab-card-title">Récapitulatif</h3>
                  </div>
                  <div class="ab-card-bd">
                    <div class="ab-kv">

                      <div class="ab-kv-row">
                        <div class="ab-k">Tarif</div>
                        <div class="ab-v"><t t-esc="mission.tarif or '—'"/> €</div>
                      </div>

                      <div class="ab-kv-row">
                        <div class="ab-k">Date début</div>
                        <div class="ab-v"><t t-esc="mission.start_date or '—'"/></div>
                      </div>

                      <div class="ab-kv-row">
                        <div class="ab-k">Date fin</div>
                        <div class="ab-v"><t t-esc="mission.end_date or '—'"/></div>
                      </div>

                      <div class="ab-kv-row">
                        <div class="ab-k">Spécialités</div>
                        <div class="ab-v"><t t-esc="len(mission.speciality_ids) if mission.speciality_ids else 0"/></div>
                      </div>

                      <div class="ab-kv-row">
                        <div class="ab-k">Marques</div>
                        <div class="ab-v"><t t-esc="len(mission.brand_ids) if mission.brand_ids else 0"/></div>
                      </div>

                    </div>
                  </div>
                </div>

              </div>
            </div>

          </div>
        </div>
      </section>

    </t>
  </template>

</odoo>
