<odoo>
    <!-- Vue arbre -->
    <record id="view_hospital_tree" model="ir.ui.view">
        <field name="name">hospital.tree</field>
        <field name="model">radiology.hospital</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="city"/>
            </tree>
        </field>
    </record>

    <!-- Vue formulaire -->
    <record id="view_hospital_form" model="ir.ui.view">
        <field name="name">hospital.form</field>
        <field name="model">radiology.hospital</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="email"/>
                        <field name="phone"/>
                        <field name="city"/>
                        <field name="image_1920" widget="image" class="oe_avatar"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_hospital_kanban" model="ir.ui.view">
        <field name="name">hospital.kanban</field>
        <field name="model">radiology.hospital</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column">
                <field name="image_1920"/>
                <field name="name"/>
                <field name="city"/>
                <field name="phone"/>
                <field name="email"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <t t-if="record.image_1920.raw_value">
                                    <img t-att-src="'data:image/png;base64,%s' % record.image_1920.raw_value"/>
                                </t>
                                <t t-else="">
                                    <img src="/web/static/src/img/placeholder.png"/>
                                </t>
                            </div>
                            <div class="o_kanban_details">
                                <strong>
                                    <field name="name"/>
                                </strong>
                                <div>
                                    <field name="city"/>
                                </div>
                                <div>
                                    <field name="phone"/>
                                </div>
                                <div>
                                    <field name="email"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <!-- Action -->
    <record id="action_hospital" model="ir.actions.act_window">
        <field name="name">Hôpitaux</field>
        <field name="res_model">radiology.hospital</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>
</odoo>
