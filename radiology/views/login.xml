<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <template id="portal_login_layout_wide" inherit_id="web.login_layout" priority="30" name="Login Layout - RadioVac Sign In">
    <xpath expr="t" position="replace">

      <t t-call="web.frontend_layout">
        <t t-set="html_data" t-value="{'style': 'height: 100%;'}"/>
        <t t-set="body_classname" t-value="'rlx-signin-body'"/>
        <t t-set="no_header" t-value="True"/>
        <t t-set="no_footer" t-value="True"/>

      <style>
        :root{
          --rlx-text:#10245f;
          --rlx-muted:#5e7094;
          --rlx-border:rgba(255,255,255,.72);
          --rlx-card:rgba(255,255,255,.74);
          --rlx-shadow:0 26px 68px rgba(16,36,95,.14);
          --rlx-primary:#2f6ff2;
          --rlx-primary-dark:#1f58d1;
          --rlx-radius:30px;
        }

        html,
        body,
        body.o_web_client,
        body.rlx-signin-body{
          min-height:100% !important;
          height:100% !important;
          margin:0 !important;
          background:#dfeeff !important;
        }

        header,
        footer,
        #wrapwrap > header,
        #wrapwrap > footer,
        .o_frontend_to_backend_nav,
        .o_main_navbar,
        #oe_main_menu_navbar,
        #oe_snippets,
        #oe_manipulators,
        .o_we_website_top_actions,
        .o_we_toolbar{
          display:none !important;
        }

        body,
        body.rlx-signin-body,
        #wrapwrap{
          background-color:#f8fbff !important;
          background-image:url("/radiology/static/src/img/sign_in.png") !important;
          background-position:center center !important;
          background-repeat:no-repeat !important;
          background-size:100% 100% !important;
        }

        .oe_website_login_container,
        .oe_login_form,
        .oe_login{
          background:transparent !important;
        }

        .rlx-signin-stage{
          position:relative;
          min-height:100vh;
          display:grid;
          grid-template-columns:minmax(0, 1fr) minmax(22rem, 27rem) minmax(0, 1fr);
          align-items:center;
          padding:clamp(1.5rem, 4vw, 3rem) clamp(1.5rem, 4vw, 3.5rem);
          overflow:hidden;
        }

        .rlx-signin-stage::before{
          content:"";
          position:absolute;
          top:50%;
          right:clamp(6rem, 16vw, 16rem);
          width:min(34rem, 48vw);
          height:min(34rem, 48vw);
          border-radius:999px;
          transform:translateY(-44%);
          background:
            radial-gradient(circle, rgba(255,255,255,.28) 0%, rgba(83,224,210,.12) 34%, rgba(47,111,242,.08) 52%, transparent 74%);
          filter:blur(12px);
          pointer-events:none;
        }

        .rlx-signin-panel{
          position:relative;
          z-index:1;
          grid-column:2;
          justify-self:center;
          width:100%;
          padding:1.8rem 1.8rem 1.55rem;
          border-radius:var(--rlx-radius);
          border:1px solid var(--rlx-border);
          background:
            linear-gradient(180deg, rgba(255,255,255,.66) 0%, rgba(255,255,255,.52) 100%);
          box-shadow:var(--rlx-shadow);
          backdrop-filter:blur(16px);
          -webkit-backdrop-filter:blur(16px);
        }

        .rlx-signin-panel::before{
          content:"";
          position:absolute;
          inset:0;
          border-radius:inherit;
          background:
            radial-gradient(15rem 10rem at 0% 0%, rgba(255,255,255,.30), transparent 72%),
            radial-gradient(14rem 10rem at 100% 0%, rgba(57,201,244,.08), transparent 72%);
          pointer-events:none;
        }

        .rlx-signin-head,
        .rlx-signin-form-shell{
          position:relative;
          z-index:1;
        }

        .rlx-signin-head{
          margin-bottom:1.25rem;
        }

        .rlx-signin-title{
          margin:0;
          color:var(--rlx-text);
          font-size:clamp(2rem, 2vw, 2.45rem);
          line-height:1.04;
          letter-spacing:-.06em;
          font-weight:950;
        }

        .rlx-signin-sub{
          margin:.75rem 0 0;
          max-width:31ch;
          color:var(--rlx-muted);
          font-size:.96rem;
          line-height:1.68;
          font-weight:650;
        }

        .rlx-signin-form-shell{
          padding:0;
          border-radius:0;
          background:transparent;
          border:none;
          box-shadow:none;
        }

        .rlx-signin-form-shell label{
          color:var(--rlx-text) !important;
          font-size:.82rem !important;
          font-weight:800 !important;
          letter-spacing:.01em !important;
          text-transform:none !important;
        }

        .rlx-signin-form-shell .mb-3{
          margin-bottom:1rem !important;
        }

        .rlx-signin-form-shell .text-muted,
        .rlx-signin-form-shell small,
        .rlx-signin-form-shell a:not(.btn){
          color:var(--rlx-muted) !important;
        }

        .rlx-input,
        .rlx-signin-form-shell input.form-control,
        .rlx-signin-form-shell .input-group > .form-control{
          min-height:3.35rem !important;
          border-radius:16px !important;
          border:1px solid rgba(167,191,231,.42) !important;
          background:rgba(255,255,255,.92) !important;
          color:var(--rlx-text) !important;
          font-weight:700 !important;
          padding:.82rem .95rem !important;
          box-shadow:
            inset 0 1px 0 rgba(255,255,255,.72),
            0 12px 24px rgba(16,36,95,.07);
        }

        .rlx-input::placeholder,
        .rlx-signin-form-shell input.form-control::placeholder{
          color:#7b8fb4 !important;
          font-weight:600 !important;
        }

        .rlx-input:focus,
        .rlx-signin-form-shell input.form-control:focus,
        .rlx-signin-form-shell .input-group > .form-control:focus{
          border-color:rgba(57,201,244,.44) !important;
          box-shadow:
            0 0 0 4px rgba(57,201,244,.14) !important,
            0 14px 30px rgba(45,108,246,.12) !important;
        }

        .rlx-signin-form-shell .alert{
          margin-top:.2rem;
          border:none !important;
          border-radius:16px !important;
          font-weight:700 !important;
          box-shadow:0 12px 26px rgba(16,36,95,.08);
        }

        .rlx-signin-form-shell .oe_login_buttons{
          padding-top:.35rem !important;
        }

        .rlx-signin-form-shell .oe_login_buttons .small{
          margin-top:.9rem !important;
        }

        .rlx-signin-form-shell .oe_login_buttons .d-flex{
          justify-content:flex-end !important;
        }

        .rlx-signin-form-shell a:not(.btn){
          color:#2f6ff2 !important;
          font-weight:750 !important;
          text-decoration:none !important;
        }

        .rlx-signin-form-shell a:not(.btn):hover,
        .rlx-signin-form-shell a:not(.btn):focus{
          color:#1f58d1 !important;
          text-decoration:underline !important;
        }

        .rlx-btn-primary{
          min-height:3.45rem !important;
          border-radius:16px !important;
          padding:.9rem 1rem !important;
          font-weight:950 !important;
          letter-spacing:-.02em !important;
          color:#fff !important;
          background:linear-gradient(135deg, var(--rlx-primary) 0%, #39bdf4 55%, #52e1d2 100%) !important;
          border:none !important;
          box-shadow:0 18px 34px rgba(45,108,246,.18) !important;
        }

        .rlx-btn-primary:hover,
        .rlx-btn-primary:focus{
          background:linear-gradient(135deg, var(--rlx-primary-dark) 0%, #269ae6 56%, #3fd5c4 100%) !important;
        }

        @media (max-width: 1199.98px){
          .rlx-signin-stage{
            grid-template-columns:minmax(0, 1fr) minmax(21rem, 24rem) minmax(0, 1fr);
          }

          .rlx-signin-stage::before{
            right:clamp(1.5rem, 8vw, 5rem);
          }
        }

        @media (max-width: 991.98px){
          body,
          body.rlx-signin-body,
          #wrapwrap{
            background-position:center center !important;
            background-size:100% 100% !important;
          }

          .rlx-signin-stage{
            grid-template-columns:minmax(0, 1fr);
            align-items:end;
            justify-items:center;
            padding:clamp(16rem, 40vh, 24rem) 1.25rem 1.25rem;
          }

          .rlx-signin-stage::before{
            right:50%;
            top:auto;
            bottom:1.5rem;
            width:24rem;
            height:24rem;
            transform:translateX(50%);
          }

          .rlx-signin-panel{
            grid-column:1;
            width:min(28rem, 100%);
          }
        }

        @media (max-width: 767.98px){
          .rlx-signin-stage{
            min-height:100dvh;
            padding:max(13rem, 36vh) 1rem 1rem;
          }

          .rlx-signin-panel{
            padding:1.35rem 1.15rem 1.1rem;
            border-radius:24px;
            background:linear-gradient(180deg, rgba(255,255,255,.74) 0%, rgba(255,255,255,.62) 100%);
          }

          .rlx-signin-title{
            font-size:clamp(1.8rem, 8vw, 2.15rem);
          }

          .rlx-signin-sub{
            font-size:.9rem;
          }

          .rlx-input,
          .rlx-signin-form-shell input.form-control,
          .rlx-signin-form-shell .input-group > .form-control,
          .rlx-btn-primary{
            min-height:3.15rem !important;
          }
        }
      </style>

      <div class="rlx-signin-stage">
        <div class="rlx-signin-panel">
          <div class="rlx-signin-head">
            <h1 class="rlx-signin-title">Connexion</h1>
            <p class="rlx-signin-sub">Connectez-vous a votre espace pour retrouver vos missions, vos echanges et votre suivi.</p>
          </div>

          <div class="rlx-signin-form-shell">
            <t t-out="0"/>
          </div>
        </div>
      </div>

      </t>

    </xpath>
  </template>

  <template id="portal_login_form_style" inherit_id="web.login" name="Login Form - Style (RadioVac)">
    <xpath expr="//label[@for='login']" position="replace">
      <label for="login" class="form-label">E-mail</label>
    </xpath>

    <xpath expr="//input[@id='login']" position="attributes">
      <attribute name="t-attf-class">form-control rlx-input #{'form-control-sm' if form_small else ''}</attribute>
      <attribute name="placeholder">votre@email.com</attribute>
    </xpath>

    <xpath expr="//label[@for='password']" position="replace">
      <label for="password" class="form-label">Mot de passe</label>
    </xpath>

    <xpath expr="//input[@id='password']" position="attributes">
      <attribute name="t-attf-class">form-control rlx-input #{'form-control-sm' if form_small else ''}</attribute>
      <attribute name="placeholder">Mot de passe</attribute>
    </xpath>

    <xpath expr="//input[@id='db']" position="attributes">
      <attribute name="t-attf-class">form-control rlx-input #{'form-control-sm' if form_small else ''}</attribute>
    </xpath>

    <xpath expr="//button[@type='submit' and contains(@class,'btn-primary')]" position="replace">
      <button type="submit" class="btn rlx-btn-primary">Se connecter</button>
    </xpath>

  </template>

  <template id="portal_login_auth_signup_style" inherit_id="auth_signup.login" name="Login Auth Signup Style (RadioVac)">
    <xpath expr="//div[hasclass('justify-content-between')]/a[last()]" position="replace">
      <a t-if="reset_password_enabled" t-attf-href="/web/reset_password?{{ keep_query() }}">Mot de passe oublie ?</a>
    </xpath>
  </template>

</odoo>
